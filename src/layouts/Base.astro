---
import "@fontsource-variable/roboto-slab/wght.css";
import slabUrl from "@fontsource-variable/roboto-slab/files/roboto-slab-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import TagSwitch from "../components/TagSwitch.astro";
import { facts, isPublicBuild } from "../data/facts";

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const fullTitle = title === "home" ? `${facts.name.value} | Master plumber in Hampton Roads` : `${title} | ${facts.shortName.value}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!isPublicBuild && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0c1b30" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={slabUrl} as="font" type="font/woff2" crossorigin />
    {!isPublicBuild && (
      <script is:inline>
        (() => {
          try {
            const p = new URLSearchParams(location.search).get("tags");
            const on = p === "on" ? true : p === "off" ? false : localStorage.getItem("fm-tags") === "on";
            if (p) localStorage.setItem("fm-tags", on ? "on" : "off");
            if (on) document.documentElement.classList.add("tags-on");
          } catch (e) {}
        })();
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!isPublicBuild && <TagSwitch />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
  </body>
</html>
