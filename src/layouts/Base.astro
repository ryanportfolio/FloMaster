---
import "@fontsource-variable/roboto-slab/wght.css";
import slabUrl from "@fontsource-variable/roboto-slab/files/roboto-slab-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import { facts, isPublicBuild } from "../data/facts";

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const fullTitle = title === "home" ? `${facts.name.value} | Master plumber in Hampton Roads` : `${title} | ${facts.shortName.value}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!isPublicBuild && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0c1b30" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={slabUrl} as="font" type="font/woff2" crossorigin />
    {!isPublicBuild && (
      <script is:inline>
        (() => {
          // A ?tags= link sets the switch once; later reads only follow the stored value, so two tabs
          // opened with different links never write back and forth.
          const apply = (fromUrl) => {
            try {
              const p = fromUrl ? new URLSearchParams(location.search).get("tags") : null;
              const on = p === "on" ? true : p === "off" ? false : localStorage.getItem("fm-tags") === "on";
              if (p) localStorage.setItem("fm-tags", on ? "on" : "off");
              document.documentElement.classList.toggle("tags-on", on);
            } catch (e) {}
          };
          apply(true);
          // A prerendered page ran this before the reviewer may have flipped the switch; read it again
          // when the page is shown, and when another tab changes it.
          document.addEventListener("prerenderingchange", () => apply(false));
          addEventListener("storage", (e) => { if (e.key === "fm-tags") apply(false); });
        })();
      </script>
    )}
    <script is:inline>
      // Page transition (global.css, docs/page-transition/BRIEF.md). Picks the pass for each
      // cross-document view transition: the band once per tab, a dissolve after that, a plain
      // dissolve for back/forward and for reduced motion. Must run before first render, so inline.
      (() => {
        const d = document.documentElement, TIDE = "fm-tide", BAR = "fm-vt-bar", LIC = "fm-vt-lic", NAV = "fm-vt-nav";
        let oldBar = null;
        const get = (k) => { try { return sessionStorage.getItem(k); } catch (e) { return null; } };
        const set = (k, v) => { try { sessionStorage.setItem(k, v); return true; } catch (e) { return false; } };
        const bar = () => document.querySelector("[data-sticky]");
        const shown = (b) => !!b && !b.classList.contains("is-waiting") && getComputedStyle(b).display !== "none";
        // The licence line under the sticky header scrolls away; it is held above the water only
        // while it is wholly on screen, and its top is kept for the clip that brings it in or out.
        const lic = () => document.querySelector(".license-band");
        const licTop = (l) => {
          const h = document.querySelector(".site-header"), r = l && l.getBoundingClientRect();
          return r && h && r.top >= h.getBoundingClientRect().bottom - 1 && r.bottom <= innerHeight ? Math.round(r.top) : null;
        };
        // Old page: a bar or licence line that is hidden or scrolled away is left out of the
        // transition, so it cannot pop in at time 0. Also notes how this navigation was started
        // (pageswap has the activation on browsers whose pagereveal lacks navigation.activation).
        addEventListener("pageswap", (e) => {
          if (!e.viewTransition) return;
          const b = bar(), on = shown(b), l = lic(), lt = licTop(l);
          if (b) b.style.viewTransitionName = on ? "" : "none";
          if (l) l.style.viewTransitionName = lt === null ? "none" : "";
          set(BAR, on ? JSON.stringify(b.getBoundingClientRect()) : "0");
          set(LIC, lt === null ? "" : String(lt));
          set(NAV, (e.activation && e.activation.navigationType) || "");
        });
        let running = null, tapped = false, full = false, barGone = false;
        addEventListener("pagereveal", (e) => {
          const vt = e.viewTransition;
          if (!vt) return;
          const act = window.navigation && navigation.activation;
          const navType = act ? act.navigationType : get(NAV);
          set(NAV, "");
          let mode = matchMedia("(prefers-reduced-motion: reduce)").matches ? "calm" : navType === "traverse" ? "back" : get(TIDE) ? "short" : "full";
          if (mode === "full" && !set(TIDE, "1")) mode = "short";
          vt.types.add("fm-" + mode);
          full = mode === "full";
          // The bar and the licence line keep their own groups only when they show on both pages;
          // otherwise each goes with its page.
          const b = bar(), on = shown(b);
          if (b) b.style.viewTransitionName = on ? "" : "none";
          const wasBar = get(BAR);
          if (!on && wasBar !== "0") vt.types.add("fm-bar-out");
          if (on && wasBar === "0") vt.types.add("fm-bar-new");
          try { oldBar = wasBar && wasBar !== "0" && wasBar !== "1" ? JSON.parse(wasBar) : null; } catch (err) { oldBar = null; }
          const l = lic(), lt = licTop(l), was = get(LIC);
          if (l) l.style.viewTransitionName = lt === null ? "none" : "";
          if (lt !== null) d.style.setProperty("--fm-lic-new", lt + "px");
          if (was) d.style.setProperty("--fm-lic-old", was + "px");
          if (was && lt === null) vt.types.add("fm-lic-out");
          if (mode === "full" || mode === "short") {
            d.dataset.ring = mode;
            const end = () => { if (d.dataset.ring === mode) delete d.dataset.ring; };
            d.addEventListener("animationend", (a) => { if (a.animationName.indexOf("fm-lw-level") === 0) end(); });
            setTimeout(end, 2500);
          }
          running = vt;
          vt.finished.then(() => { if (running === vt) running = null; }, () => { if (running === vt) running = null; });
        });
        // While a transition runs the browser sends every press to the page root, so a tap on Call
        // or a link would be lost. A press ends the transition at once; the click that follows is
        // passed to the link or control now under the finger, unless the browser already sent it there.
        addEventListener("pointerdown", (e) => {
          if (!running) return;
          // In the full pass the old bottom bar is cut away above the band's center line as the band
          // passes, so a press above that line, on the bar's former place, belongs to the new page.
          barGone = false;
          if (full && oldBar) try { const g = getComputedStyle(d, "::view-transition-group(fm-tide)"); barGone = e.clientY < new DOMMatrix(g.transform).m42 + parseFloat(g.height) / 2; } catch (err) {}
          running.skipTransition();
          running = null;
          tapped = true;
          // A middle press would start the browser's autoscroll on the page root instead.
          if (e.button === 1) e.preventDefault();
          setTimeout(() => { tapped = false; }, 1500);
        }, true);
        // Ctrl, Cmd, Shift or middle click on a link still opens it in a new tab or window. The
        // middle press began on the page root, so no auxclick follows; its release stands in.
        const pass = (e) => {
          if (!tapped || (e.type === "pointerup" && e.button !== 1)) return;
          tapped = false;
          const x = e.clientX, y = e.clientY;
          let el = document.elementFromPoint(x, y);
          // A press on the old page's bottom bar, which this page hides, still means its Call or Book.
          const nb = bar();
          if (oldBar && !barGone && !shown(nb) && y >= oldBar.top && y <= oldBar.bottom) el = nb && [...nb.querySelectorAll("a")].find((a) => { const r = a.getBoundingClientRect(); return x >= r.left && x <= r.right; });
          const t = el && el.closest("a[href], button, summary, label, input, select, textarea");
          if (!t || (e.type === "click" && t.contains(e.target))) return;
          e.preventDefault();
          if (t.matches("a[href]") && (e.button === 1 || e.ctrlKey || e.metaKey || e.shiftKey)) open(t.href, "_blank", "noopener");
          else if (e.type === "pointerup") return;
          else if (t.matches("input, select, textarea")) t.focus(); else t.click();
        };
        addEventListener("click", pass, true);
        addEventListener("pointerup", pass, true);
        addEventListener("pagehide", () => { delete d.dataset.ring; });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <div class="fm-tide" aria-hidden="true"><div class="fm-tide-sheet"><div class="fm-tide-body"></div><div class="fm-tide-edge"></div></div></div>
    <script>document.querySelectorAll("[data-needs-js]").forEach((b) => b.removeAttribute("disabled"));</script>
    {/* Prerender likely next pages so the transition starts at once. Not the home page (its
        repair story starts work at load), /book* and /emergency (they read sessionStorage at load). */}
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prerender: [{
        source: "document",
        where: { and: [
          { href_matches: "/*" },
          { not: { href_matches: ["/", "/\\?*", "/#*", "/book*", "/book*\\?*", "/book*#*", "/emergency*", "/emergency*\\?*", "/emergency*#*"] } },
          { not: { selector_matches: "[download]" } },
        ] },
        eagerness: "moderate",
      }],
    })}></script>
  </body>
</html>
