---
// The four written answers to a ZIP check, worded as in ZipCheck.astro. TidewaterChart copies one
// into its result area after a check; {city} and {zip} are filled in.
import { facts } from "../data/facts";
const tel = `tel:${facts.phoneHref.value}`;
---
<template data-ans-yes><strong>Yes, I cover {"{city}"}.</strong> <a href="/book">Book a time</a> or call <a href={tel} class="nowrap">{facts.phone.value}</a>.</template>
<template data-ans-maybe><strong>Call me to check.</strong> Parts of {"{city}"} are a longer drive, so it depends on the job: <a href={tel} class="nowrap">{facts.phone.value}</a>.</template>
<template data-ans-no><strong>That's outside my area.</strong> I work in the 7 cities of Hampton Roads. If you're close to the edge, call and ask: <a href={tel} class="nowrap">{facts.phone.value}</a>.</template>
<template data-ans-bad>Enter a 5-digit ZIP code, for example 23510.</template>
