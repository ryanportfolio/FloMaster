---
// The Tidewater chart (service-area page). The seven cities as tiles set where they sit around the
// water (not to scale, not a map: the ZIP lists are unchecked), with the named waters, the
// harbor crossings and a lettered grid. Checking a ZIP marks its city on the chart and its ZIP in
// the index below. Tapping a city moves to its row in the ZIP index. Geography: Hampton Roads
// (the water) carries the James, Nansemond and Elizabeth rivers into the Chesapeake Bay; I-664
// (Monitor-Merrimac Memorial Bridge-Tunnel) joins Newport News and Suffolk, I-64 (Hampton Roads
// Bridge-Tunnel) joins Hampton and Norfolk, and the Downtown and Midtown tunnels cross the
// Elizabeth between Portsmouth and Norfolk. Relative placement follows the city coordinates:
// Virginia Beach is due east of Norfolk, Chesapeake due south of it.
import Fact from "./Fact.astro";
import Answers from "./ZipAnswers.astro";
import { byCity } from "../data/zipLookup";

// Grid squares: columns A to D west to east, rows 1 to 4 north to south (row 2 is the harbor).
// Phones keep the same squares; the chart only gets narrower.
const place: Record<string, { area: string; ref: string }> = {
  "Newport News": { area: "nn", ref: "A1" },
  Hampton: { area: "ha", ref: "C1" },
  Suffolk: { area: "su", ref: "A3" },
  Portsmouth: { area: "po", ref: "B3" },
  Norfolk: { area: "no", ref: "C3" },
  "Virginia Beach": { area: "vb", ref: "D3" },
  Chesapeake: { area: "ch", ref: "B4" },
};
const tiles = byCity.map((c) => ({ ...c, ...place[c.city] }));
---
<section class="band band--paper ca" data-chart>
  <div class="wrap ca-top">
    <form class="ca-check" data-zipform novalidate method="post" action="/service-area">
      <h2 class="ca-h">Check your ZIP code</h2>
      <label for="ca-zip">Your ZIP code <span class="tagwrap"><Fact k="zipList" text="" /></span></label>
      <div class="ca-row">
        <input id="ca-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" aria-describedby="ca-result" />
        <button class="btn btn--navy" type="submit">Check</button>
      </div>
      <p class="ca-result" id="ca-result" role="status" data-result></p>
      <Answers />
    </form>
    <dl class="key">
        <div><dt><span class="k-tile" aria-hidden="true"></span></dt><dd>A city I cover. Tap it for its ZIP codes.</dd></div>
        <div><dt><span class="k-tile k-tile--hit" aria-hidden="true"></span></dt><dd>Your city, once you check a ZIP</dd></div>
        <div><dt><span class="k-x" aria-hidden="true"></span></dt><dd>Where the roads cross the water: I-664 on the Monitor-Merrimac Memorial Bridge-Tunnel, I-64 on the Hampton Roads Bridge-Tunnel, and the Downtown and Midtown tunnels under the Elizabeth River</dd></div>
    </dl>

    <figure class="chart">
      <div class="frame">
        <ol class="cols" aria-hidden="true"><li>A</li><li>B</li><li></li><li>C</li><li>D</li><li></li></ol>
        <ol class="rows" aria-hidden="true"><li>1</li><li>2</li><li>3</li><li>4</li></ol>
        <div class="sea">
          <span class="w w-jr">James River</span>
          <span class="w w-hr">Hampton Roads</span>
          <span class="w w-bay">Chesapeake Bay</span>
          <span class="w w-el">Elizabeth River</span>
          <span class="w w-at">Atlantic Ocean</span>
          <span class="x x-mmm" aria-hidden="true"><span class="x-l">I-664</span></span>
          <span class="x x-hrbt" aria-hidden="true"><span class="x-l">I-64</span></span>
          <span class="x x-tun" aria-hidden="true"></span>
          {tiles.map((t) => (
            <a class="tile" style={`grid-area:${t.area}`} href={`#ca-${t.slug}`} data-city={t.city}>
              <span class="t-ref" aria-hidden="true">{t.ref}</span>
              <span class="t-name">{t.city}</span>
              <span class="t-snd"><span class="num">{t.zips.length}</span> ZIPs</span>
              <span class="t-mark" data-mark></span>
            </a>
          ))}
        </div>
      </div>
      <figcaption>Not to scale. The seven cities set out where they sit around the water; the letters and numbers give each city's square.</figcaption>
    </figure>
  </div>

  <div class="wrap ca-index">
    <h2>ZIP codes by city</h2>
    <p class="muted">Dashed ZIP codes sit at the edge of my area: call me to check before you book. Near the edge of any of these? <Fact k="zipList" text="Call and ask, and I'll tell you whether I can get to you." /></p>
    <ul class="idx">
      {tiles.map((t) => (
        <li id={`ca-${t.slug}`} data-row={t.city} tabindex="-1">
          <span class="i-ref"><span class="visually-hidden">Chart square </span>{t.ref}</span>
          <h3>{t.city}</h3>
          <p class="i-zips num">
            {t.zips.map((z) => (
              <span class:list={["z", { "z--maybe": z.maybe }]} data-zip={z.zip}>{z.zip}{z.maybe && <span class="z-note"> call to check</span>}</span>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { lookup, type Answer } from "../data/zipLookup";
  document.querySelectorAll<HTMLElement>("[data-chart]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-zipform]")!;
    const input = form.querySelector<HTMLInputElement>("input[name=zip]")!;
    const out = form.querySelector<HTMLElement>("[data-result]")!;
    const fill = (a: Answer) =>
      form.querySelector<HTMLTemplateElement>(`[data-ans-${a.kind}]`)!.innerHTML
        .replaceAll("{city}", "city" in a ? a.city : "")
        .replaceAll("{zip}", "zip" in a ? a.zip : "");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const a = lookup(input.value);
      if (a.kind === "bad") input.setAttribute("aria-invalid", "true");
      else input.removeAttribute("aria-invalid");
      out.innerHTML = fill(a);
      out.dataset.kind = a.kind;
      root.querySelectorAll<HTMLElement>("[data-city]").forEach((t) => {
        const hit = "city" in a && t.dataset.city === a.city;
        if (hit) t.dataset.state = a.kind; else delete t.dataset.state;
        t.querySelector<HTMLElement>("[data-mark]")!.textContent = hit ? (a.kind === "yes" ? "Your ZIP" : "Call to check") : "";
      });
      root.querySelectorAll<HTMLElement>("[data-zip]").forEach((z) => z.toggleAttribute("data-on", "zip" in a && z.dataset.zip === a.zip));
    });
    // Digits only, five at most, so a pasted "23510-1234" or "VA 23510" still checks.
    input.addEventListener("input", () => {
      input.value = input.value.replace(/\D/g, "").slice(0, 5);
    });
    // A city on the chart jumps to its ZIP row; focus goes with it, so the next Tab starts there
    // and a screen reader reads the row.
    root.querySelectorAll<HTMLAnchorElement>("a[data-city]").forEach((t) =>
      t.addEventListener("click", () => {
        const row = document.getElementById(t.hash.slice(1));
        if (row) requestAnimationFrame(() => row.focus({ preventScroll: true }));
      }),
    );
  });
</script>

<style>
  .ca-top { display: grid; gap: var(--space-4); align-items: start; }
  .ca-top { grid-template-areas: "form" "chart" "key"; }
  .ca-check { grid-area: form; } .chart { grid-area: chart; } .key { grid-area: key; }
  @media (min-width: 960px) { .ca-top { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-areas: "form chart" "key chart"; grid-template-rows: auto 1fr; row-gap: 0; } }
  .ca-h { font-size: var(--step-2); }
  label { display: block; font-weight: 700; margin-bottom: 0.4rem; }
  .tagwrap { font-weight: 400; }
  .ca-row { display: flex; gap: 0.5rem; }
  .ca-row input { flex: 1; max-width: 12rem; font-size: 1.25rem; letter-spacing: 0.08em; }
  .ca-result { min-height: 5.2em; margin: 0.6rem 0 0; font-size: var(--step--1); max-width: 34rem; }
  .ca-result[data-kind="yes"] strong { color: var(--ok); }
  .ca-result[data-kind="bad"] { color: #b42318; font-weight: 600; }

  .key { margin: 0; display: grid; gap: 0.6rem; font-size: var(--step--1); color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 1rem; }
  .key div { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.75rem; align-items: start; }
  .key dt { padding-top: 0.15rem; }
  .key dd { margin: 0; }
  .k-tile { display: block; width: 2.25rem; height: 1.5rem; background: var(--white); border: 2px solid var(--navy); border-radius: 4px; }
  .k-tile--hit { background: var(--navy); }
  .k-x { display: block; width: 2.25rem; height: 1.5rem; background: linear-gradient(var(--navy), var(--navy)) center / 4px 100% no-repeat, var(--sky-100); border-radius: 4px; }

  /* ---------- The chart ---------- */
  .chart { margin: 0; }
  .frame {
    --c: minmax(0, 1fr) minmax(0, 1.15fr) 1.6rem minmax(0, 1fr) minmax(0, 1fr) 1.9rem;
    display: grid; grid-template-columns: 1.5rem 1fr; grid-template-rows: 1.5rem 1fr; gap: 0.35rem;
  }
  .cols, .rows { list-style: none; margin: 0; padding: 0; display: grid; font: 700 0.875rem/1 var(--font-slab); color: var(--slate-ink); }
  .cols { grid-column: 2; grid-template-columns: var(--c); gap: 0.4rem; text-align: center; align-items: end; padding-inline: 0.5rem; }
  .rows { grid-row: 2; grid-template-rows: var(--r); gap: 0.4rem; align-items: center; justify-items: center; padding-block: 0.5rem; }
  .frame { --r: minmax(6.5rem, auto) 3.5rem minmax(7.5rem, auto) minmax(4.5rem, auto); }
  .sea {
    grid-column: 2; grid-row: 2; position: relative;
    display: grid; grid-template-columns: var(--c); grid-template-rows: var(--r); gap: 0.4rem; padding: 0.5rem;
    grid-template-areas:
      "nn nn nn ha bay bay"
      "jr hr hr hr . at"
      "su po el no vb at"
      "su ch ch ch vb at";
    background: var(--sky-100); border: 2px solid var(--navy); border-radius: 6px;
  }
  /* Named waters, in italic as a chart sets them. */
  .w { font: italic 600 0.9375rem/1.2 var(--font-body); color: var(--slate-ink); align-self: center; }
  .w-jr { grid-area: jr; padding-left: 0.2rem; max-width: 5rem; }
  .w-hr { grid-area: hr; justify-self: center; font-size: 1.0625rem; letter-spacing: 0.04em; }
  .w-bay { grid-area: bay; justify-self: center; text-align: center; }
  .w-el, .w-at { writing-mode: vertical-rl; justify-self: center; white-space: nowrap; }
  .w-el { grid-area: el; }
  .w-at { grid-area: at; }
  /* Crossings: a navy line across the water between the two cities they join. */
  .x { position: relative; z-index: 1; pointer-events: none; }
  .x-mmm, .x-hrbt { width: 4px; margin-block: -0.6rem; background: var(--navy); justify-self: end; margin-right: 22%; }
  .x-mmm { grid-area: jr; }
  .x-hrbt { grid-area: hr; justify-self: end; margin-right: 18%; }
  .x-l { position: absolute; left: 0.45rem; top: 50%; translate: 0 -50%; font: 700 0.875rem/1 var(--font-body); color: var(--navy-900); white-space: nowrap; }
  /* Downtown and Midtown tunnels: two bars across the Elizabeth, clear of its name. */
  .x-tun { grid-area: el; margin-inline: -0.55rem; background: linear-gradient(var(--navy), var(--navy)) 0 6% / 100% 4px no-repeat, linear-gradient(var(--navy), var(--navy)) 0 94% / 100% 4px no-repeat; }

  .tile {
    position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; gap: 0.2rem;
    min-width: 0; padding: 0.45rem 0.55rem 0.5rem; border: 2px solid var(--navy); border-radius: 6px;
    background: var(--white); color: var(--navy-900); text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .tile:hover { background: #f1f6fb; }
  .t-ref { font: 700 0.875rem/1 var(--font-slab); color: var(--slate-ink); }
  .t-name { font: 700 clamp(0.9375rem, 0.8rem + 0.6vw, 1.25rem)/1.15 var(--font-slab); hyphens: manual; overflow-wrap: normal; }
  .t-snd { font-size: 0.875rem; font-weight: 600; color: var(--ink-soft); }
  .t-mark { font: 700 0.875rem/1.2 var(--font-body); }
  .t-mark:empty { display: none; }
  .tile[data-state="yes"] { background: var(--navy); color: var(--white); }
  .tile[data-state="yes"] :is(.t-ref, .t-snd) { color: var(--sky-300); }
  .tile[data-state="maybe"] { border-style: dashed; border-width: 3px; background: var(--white); }
  .tile[data-state="maybe"] .t-mark { color: var(--navy-900); }
  figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: var(--ink-soft); max-width: 60ch; }

  /* Phone: the same squares as on a desktop, so Virginia Beach stays due east of Norfolk and
     Chesapeake due south. The rulers give way to the chart (each tile still prints its square),
     the chart runs closer to the screen edges, and each city column is at least as wide as its
     longest name, so no name breaks inside a word. Below about 375 px the chart scrolls sideways
     inside its frame instead of squeezing the names. */
  @media (max-width: 639px) {
    .chart { margin-inline: -0.9rem; }
    .frame { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; gap: 0; overflow-x: auto; }
    .cols, .rows { display: none; }
    .sea {
      grid-column: 1; grid-row: 1; gap: 0.2rem; padding: 0.2rem;
      --c: minmax(min-content, 1fr) minmax(min-content, 1fr) 1.1rem minmax(min-content, 1fr) minmax(min-content, 1fr) 1.05rem;
      /* Row 3 is tall enough for "Elizabeth River" to run between the two tunnel bars. */
      --r: minmax(4.25rem, auto) 2.75rem minmax(8rem, auto) minmax(3.5rem, auto);
    }
    .tile { padding: 0.3rem 0.3rem; gap: 0.1rem; }
    .t-ref { font-size: 0.875rem; }
    .t-name { font-size: 0.875rem; line-height: 1.2; hyphens: none; overflow-wrap: normal; word-break: normal; letter-spacing: -0.01em; }
    .t-snd, .x-l { display: none; }
    .w { font-size: 0.875rem; line-height: 1.15; }
    .w-hr { font-size: 0.875rem; letter-spacing: 0.02em; }
    .w-jr { max-width: none; padding-left: 0; }
    .w-bay { padding-inline: 0.15rem; }
    .x-mmm { margin-right: 10%; }
    .x-tun { margin-inline: -0.3rem; }
    figcaption { margin-inline: 0.9rem; }
  }
  @media (max-width: 369px) {
    .sea { gap: 0.15rem; padding: 0.15rem; }
    .tile { padding-inline: 0.25rem; }
  }

  /* ---------- Index ---------- */
  .ca-index { margin-top: var(--band-space); }
  .idx { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0; border-top: 2px solid var(--navy); }
  .idx li { display: grid; grid-template-columns: 3rem 11rem 1fr; gap: 0.25rem 1rem; align-items: baseline; padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
  .idx li:target { background: linear-gradient(90deg, var(--sky-100), transparent 70%); }
  .i-ref { display: inline-grid; place-content: center; width: 2.5rem; height: 2rem; border: 2px solid var(--navy); border-radius: 4px; font: 700 0.9375rem/1 var(--font-slab); color: var(--navy-900); }
  .idx h3 { margin: 0; font-size: var(--step-1); }
  .i-zips { margin: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 0.5rem; font-size: var(--step--1); color: var(--ink); max-width: none; }
  .z { padding: 0.1rem 0.4rem; border: 2px solid transparent; border-radius: 4px; }
  .z--maybe { border: 2px dashed #74869e; }
  .z-note { font-size: 0.875rem; color: var(--ink-soft); }
  .z[data-on] { background: var(--navy); color: var(--white); border-color: var(--navy); }
  .z[data-on] .z-note { color: var(--sky-100); }
  @media (max-width: 639px) {
    .idx li { grid-template-columns: 3rem 1fr; }
    .i-zips { grid-column: 1 / -1; }
  }
</style>
