---
// One work order slip, hung over the page header's wave edge (WorkOrderHero). The printed head
// carries the slip's title and, where a work order prints its number, Antonio's Virginia Master
// Plumber license with its caption (shown at every width, so the number never reads as a quote
// number). Filled-in values are set in the slab face in navy; printed labels in the body face.
// The sheet behind is the second copy. With `form`, the head is printed like a carbon-copy work
// order: the logo and "Work order" across the top, then either the title (the plumber) and his
// Class A contractor license as two printed fields (`form="plumber"`), or the title large with
// both licenses on one line under it (`form="title"`).
// Shared field styles for slots: .wo-f (a <dl> of label and value rows), .wo-f--two (two columns
// from 480 px), .wo-row-link (a whole row that is a link).
import Logo from "./Logo.astro";
import Fact from "./Fact.astro";
import { facts } from "../data/facts";
interface Props { title: string; id: string; sub?: string; form?: "plumber" | "title"; class?: string }
const { title, id, sub, form, class: cls } = Astro.props;
---
<div class:list={["stack", cls]}>
  <section class="slip" aria-labelledby={`${id}-t`}>
    {form ? (
      <>
        <div class="fhead">
          <Logo dark class="fhead-logo" />
          <p class="fhead-doc">Work order<span>Plumbing and Drains</span></p>
        </div>
        {form === "plumber" ? (
          <div class="fwho">
            <div><p class="fk">Plumber</p><h2 class="title fv" id={`${id}-t`}>{title}</h2></div>
            <div><p class="fk">License</p><p class="fv fv--lic"><Fact k="contractorClass" /></p></div>
          </div>
        ) : (
          <div class="ftitle">
            <h2 class="title" id={`${id}-t`}>{title}</h2>
            <p class="ftitle-lic"><span><Fact k="contractorClass" /></span> <span class="nowrap">Master Plumber</span></p>
          </div>
        )}
      </>
    ) : (
      <div class="top">
        <h2 class="title" id={`${id}-t`}>{title}{sub && <span class="sub">{sub}</span>}</h2>
        <p class="no"><span class="no-v">Va. Master Plumber</span></p>
      </div>
    )}
    <slot />
  </section>
</div>

<style>
  .stack { position: relative; padding: 0 8px 8px 0; }
  /* The second copy, under the first and offset down and right. */
  .stack::before { content: ""; position: absolute; inset: 8px 0 0 8px; border-radius: var(--radius-lg); background: var(--sky-100); box-shadow: var(--shadow-1); }
  @media (min-width: 700px) { .stack { padding: 0 10px 10px 0; } .stack::before { inset: 10px 0 0 10px; } }
  .slip { position: relative; background: var(--white); color: var(--ink); border-radius: var(--radius-lg); box-shadow: var(--shadow-3); padding: 0.8rem 1rem 0.6rem; }
  @media (min-width: 700px) { .slip { padding: 1.2rem 1.5rem 0.9rem; } }
  .slip :global(p) { max-width: none; }
  /* The slip is white inside a navy band: links and focus rings go back to navy. */
  .slip :global(a:not(.btn)) { color: var(--navy); }
  .slip :global(:focus-visible) { outline-color: var(--navy); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.15rem 1rem; padding-bottom: 0.45rem; border-bottom: 2px solid var(--navy); }
  .title { margin: 0; font: 700 var(--step-1)/1.2 var(--font-slab); color: var(--navy-900); }
  .sub { display: block; font: 600 var(--step--1)/1.3 var(--font-body); color: var(--ink-soft); }
  .no { margin: 0; text-align: right; line-height: 1.25; }
  .no-k { display: block; font: 600 var(--step--2)/1.3 var(--font-body); color: var(--ink-soft); }
  .no-v { font: 700 var(--step--1)/1.3 var(--font-slab); color: var(--navy-900); white-space: nowrap; }
  /* Phones: the license caption sits on one line beside its number, under the title. */
  @media (max-width: 479px) {
    .no { text-align: left; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.5rem; }
    .no-k { display: inline; }
  }

  /* Form head: printed across the top, then two fields over a ruled line each. */
  .fhead { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: 0.6rem; border-bottom: 2px solid var(--navy); }
  .slip :global(.fhead-logo) { height: 1.35rem; }
  .fhead-doc { margin: 0; text-align: right; font: 800 var(--step-0)/1.1 var(--font-slab); letter-spacing: 0.04em; text-transform: uppercase; color: var(--navy-900); }
  .fhead-doc span { display: block; font: 700 0.6875rem/1.4 var(--font-body); letter-spacing: 0.14em; color: var(--ink-soft); }
  .fhead-doc, .fhead-doc span { white-space: nowrap; }
  @media (max-width: 479px) { .slip :global(.fhead-logo) { height: 1.05rem; } .fhead-doc { font-size: 0.9375rem; } .fhead-doc span { font-size: 0.5625rem; letter-spacing: 0.1em; } }
  .fwho { display: grid; gap: 0.6rem 1.25rem; padding: 0.7rem 0 0.2rem; }
  @media (min-width: 480px) { .fwho { grid-template-columns: auto minmax(0, 1fr); } .fwho > div + div { border-left: 1px solid var(--line); padding-left: 1.25rem; } }
  .fwho > div { min-width: 0; }
  .ftitle { padding: 0.65rem 0 0.6rem; border-bottom: 2px solid var(--navy); }
  .ftitle .title { font-size: var(--step-2); line-height: 1.1; }
  .ftitle-lic { display: flex; flex-wrap: wrap; column-gap: 1rem; margin: 0.3rem 0 0; font-size: var(--step--1); line-height: 1.4; color: var(--ink-soft); }
  .ftitle-lic .num { font-weight: 700; color: var(--navy-900); }
  /* Printed labels any form slip can use, and the filled-in value on its ruled line. */
  .slip :global(.fk) { margin: 0 0 0.15rem; font: 700 0.6875rem/1.3 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
  .fv { margin: 0; }
  .fwho .title { font-size: var(--step-1); white-space: nowrap; }
  .fv--lic { font: 700 var(--step-0)/1.35 var(--font-slab); color: var(--navy-900); padding-top: 0.15rem; }

  /* Field rows any slip can use: printed label, filled-in value. */
  .slip :global(.wo-f) { margin: 0; }
  .slip :global(.wo-f > div) { display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: 0.1rem 1rem; align-items: baseline; padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .slip :global(.wo-f > div:last-child) { border-bottom: 0; }
  .slip :global(.wo-f dt) { font-size: var(--step--1); line-height: 1.35; color: var(--ink-soft); font-weight: 600; }
  .slip :global(.wo-f dd) { margin: 0; font: 700 1.0625rem/1.35 var(--font-slab); color: var(--navy-900); overflow-wrap: anywhere; }
  @media (max-width: 479px) { .slip :global(.wo-f > div) { grid-template-columns: 1fr; padding: 0.35rem 0; } }
  /* A whole row that is a link (contents, figures): at least 44 px tall. */
  .slip :global(.wo-rows) { list-style: none; margin: 0; padding: 0; }
  .slip :global(.wo-rows li + li) { border-top: 1px solid var(--line); }
  .slip :global(.wo-row-link) { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.7rem; min-height: 2.75rem; padding: 0.25rem 0; color: var(--navy-900); text-decoration: none; }
  .slip :global(.wo-row-link:hover .wo-row-l) { text-decoration: underline; }
  .slip :global(.wo-row-l) { font-weight: 600; line-height: 1.3; }
  .slip :global(.wo-row-d) { display: block; font-weight: 400; font-size: var(--step--1); color: var(--ink-soft); }
  .slip :global(.wo-fno) { display: inline-grid; place-content: center; width: 1.5rem; height: 1.5rem; border-radius: 4px; background: var(--navy); color: var(--white); font: 700 0.9375rem/1 var(--font-slab); flex: none; }
</style>
