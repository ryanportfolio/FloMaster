---
// The repair story: one job in four frames on one slider, with its job ticket.
// The divider follows the pointer. Right of it is always the leak as it was
// found; left of it is the job as far as you have dragged it: the X-ray view,
// then the repair, then the tested result. Dragging right moves the job forward.
// A native range input sits under the image for keyboard and screen readers.
import { Image } from "astro:assets";
import Fact from "./Fact.astro";
import FactBlock from "./FactBlock.astro";
import problem from "../assets/photos/story-1-problem.jpg";
import xray from "../assets/photos/story-2-xray.jpg";
import repair from "../assets/photos/story-3-repair.jpg";
import tested from "../assets/photos/story-4-tested.jpg";
import { isPublicBuild, photoFacts } from "../data/facts";
import { services } from "../data/services";

// The price shown is the posted range for this kind of job (P17), not a quote.
const leak = services.find((s) => s.slug === "leaks-and-pipes")!;
const job = leak.prices[0];

// Divider position (0-100) where each step begins, and where each step button
// puts the divider. Keep in step with the opacity ramps in the CSS below.
const START = 48;
const steps = [
  { short: "Leak", title: "What failed", label: "Before", go: 0, text: "The steel trap rusted out at the bend." },
  { short: "Found", title: "How I found it", label: "Found it: X-ray illustration", go: 48, text: "I dried each joint. Only the bend dripped." },
  { short: "Fixed", title: "What I changed", label: "Fixed: new PVC trap", go: 72, text: "I fitted a new PVC trap and drain arm." },
  { short: "Tested", title: "How I tested it", label: "Tested: the towel stays dry", go: 100, text: "I drained both full sinks at once, twice, over a paper towel. It stayed dry." },
];
const img = { widths: [480, 760, 1080, 1440], sizes: "(min-width: 1180px) 700px, (min-width: 900px) 58vw, calc(100vw - 2.5rem)", format: "webp" as const, quality: 70, loading: "lazy" as const, decoding: "async" as const, draggable: false };
---
<div class="rs" data-story data-stage="1" style={`--v: ${START}; --fill: 50`}>
  <div class="rs-media">
    <div class="rs-stage" data-story-stage>
      <div class="rs-frames">
        <Image src={problem} alt="Step 1, the leak: a rusted steel drain trap dripping into a water-stained kitchen sink cabinet" class="rs-img" {...img} />
        <div class="rs-done" data-story-done>
          <Image src={xray} alt="Step 2, illustration: an X-ray view of the same pipes, with the rusted bottom bend glowing amber where it leaks" class="rs-img" {...img} />
          <Image src={repair} alt="Step 3: gloved hands fitting a new white PVC trap, the old rusted pipe on a towel beside them" class="rs-img rs-img--repair" {...img} />
          <Image src={tested} alt="Step 4: the finished white trap over a dry cabinet floor, with a dry paper towel under it" class="rs-img rs-img--tested" {...img} />
        </div>
      </div>
      <span class="rs-label rs-label--done" data-story-label="done" aria-hidden="true">{steps[1].label}</span>
      <span class="rs-label rs-label--before" data-story-label="before" aria-hidden="true">{steps[0].label}</span>
      <label class="visually-hidden" for="story-range">Follow the job, from the leak to the tested repair</label>
      <input id="story-range" class="rs-range" type="range" min="0" max="100" step="1" value={START} aria-valuetext="Step 2 of 4, how I found it" data-story-range />
      <span class="rs-divider" aria-hidden="true"></span>
      <span class="rs-handle" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="64" height="64" focusable="false">
            <circle cx="32" cy="32" r="23.5" fill="#1b3556" />
            <path d="M28 5.3A27 27 0 0 0 28 58.7" fill="none" stroke="#6aaed6" stroke-width="6" />
            <path d="M36 5.3A27 27 0 0 1 36 58.7" fill="none" stroke="#5b7fae" stroke-width="6" />
            <rect x="26" y="1.5" width="12" height="7" rx="1.6" fill="#6aaed6" />
            <rect x="26" y="55.5" width="12" height="7" rx="1.6" fill="#6aaed6" />
            <path d="M26.5 25l-7 7 7 7M37.5 25l7 7-7 7" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
      </span>
      {!isPublicBuild && <span class="photo-tag">Replace with real photos · {photoFacts.beforeAfter.code}: AI stand-ins now; one real job, four shots, customer's permission</span>}
    </div>
    <ol class="rs-steps" role="list">
      {steps.map((s, i) => (
        <li class:list={["rs-step", { "is-done": i < 1, "is-on": i === 1 }]} data-story-step={i}>
          <button type="button" class="rs-step-btn" data-go={s.go} aria-controls="story-range" aria-current={i === 1 ? "step" : undefined}>
            <span class="rs-step-n" aria-hidden="true">{i + 1}</span>
            <span class="rs-step-t"><span class="visually-hidden">Step {i + 1}: </span>{s.short}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>

  <FactBlock k="sampleJob" class="rs-ticket">
    <div class="rs-ticket-head">
      <h3 class="rs-ticket-title">Job ticket</h3>
      <span class="sample-label">Sample job</span>
      <p class="rs-ticket-where">Norfolk kitchen, leaking sink trap</p>
    </div>
    <ol class="rs-lines" role="list">
      {steps.map((s, i) => (
        <li class:list={["rs-line", { "is-on": i === 1 }]} data-story-line={i}>
          <span class="rs-line-n" aria-hidden="true">{i + 1}</span>
          <h4 class="rs-line-t">{s.title}</h4>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="rs-stub">
      <p class="rs-stub-k">Price range, this kind of job</p>
      <p class="rs-stub-price num"><Fact k="priceRanges" text={job.range} /></p>
      <p class="rs-stub-note">Exact price in writing before any work starts. Call-out <Fact k="calloutFee" />, <Fact k="calloutCredited" />.</p>
    </div>
  </FactBlock>

  <div class="rs-cta">
    <a class="btn btn--navy" href="/book">Book a time</a>
    <a class="rs-cta-link" href={`/residential/${leak.slug}`}>{leak.title} prices</a>
  </div>
</div>

<script>
  // Steps begin at these divider positions (0-100); keep in step with the CSS ramps.
  const STARTS = [0, 22, 57, 82];
  // Where the progress pipe under the photo is filled to, per step boundary.
  const FILL_AT = [12.5, 37.5, 62.5, 87.5, 87.5];
  const SLOP = 6; // px of horizontal travel before a touch drag takes over
  const motionQuery = matchMedia("(prefers-reduced-motion: reduce)");
  const reduced = () => motionQuery.matches;

  document.querySelectorAll<HTMLElement>("[data-story]").forEach((root) => {
    const stage = root.querySelector<HTMLElement>("[data-story-stage]")!;
    const range = root.querySelector<HTMLInputElement>("[data-story-range]")!;
    const doneLabel = root.querySelector<HTMLElement>('[data-story-label="done"]')!;
    const beforeLabel = root.querySelector<HTMLElement>('[data-story-label="before"]')!;
    const stepEls = [...root.querySelectorAll<HTMLElement>("[data-story-step]")];
    const lineEls = [...root.querySelectorAll<HTMLElement>("[data-story-line]")];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const labels = ["Before", "Found it: X-ray illustration", "Fixed: new PVC trap", "Tested: the towel stays dry"];
    const titles = ["what failed", "how I found it", "what I changed", "how I tested it"];

    let v = range.valueAsNumber;
    let stageIndex = -1;
    let width = 0;
    let doneBox = { l: 0, r: 0 };
    let beforeBox = { l: 0, r: 0 };
    let anim = 0;
    let touched = false;

    const measure = () => {
      width = stage.clientWidth;
      doneBox = { l: doneLabel.offsetLeft, r: doneLabel.offsetLeft + doneLabel.offsetWidth };
      beforeBox = { l: beforeLabel.offsetLeft, r: beforeLabel.offsetLeft + beforeLabel.offsetWidth };
    };

    const fillFor = (x: number) => {
      const b = [...STARTS, 100];
      for (let i = 0; i < 4; i++) if (x <= b[i + 1]) return FILL_AT[i] + ((x - b[i]) / (b[i + 1] - b[i])) * (FILL_AT[i + 1] - FILL_AT[i]);
      return 100;
    };

    const setStage = (s: number) => {
      if (s === stageIndex) return;
      stageIndex = s;
      root.dataset.stage = String(s);
      stepEls.forEach((el, i) => { el.classList.toggle("is-on", i === s); el.classList.toggle("is-done", i < s); });
      buttons.forEach((b, i) => (i === s ? b.setAttribute("aria-current", "step") : b.removeAttribute("aria-current")));
      lineEls.forEach((el, i) => el.classList.toggle("is-on", i === s));
      doneLabel.textContent = labels[Math.max(1, s)];
      range.setAttribute("aria-valuetext", `Step ${s + 1} of 4, ${titles[s]}`);
      measure();
    };

    const set = (next: number, syncRange = true) => {
      v = Math.min(100, Math.max(0, next));
      root.style.setProperty("--v", v.toFixed(2));
      root.style.setProperty("--fill", fillFor(v).toFixed(2));
      if (syncRange) range.value = String(Math.round(v));
      let s = 0;
      while (s < 3 && v >= STARTS[s + 1]) s++;
      setStage(s);
      // Each label belongs to its side and fades once the divider reaches it.
      const x = (v / 100) * width;
      doneLabel.classList.toggle("is-off", x < doneBox.r + 14);
      beforeLabel.classList.toggle("is-off", x > beforeBox.l - 14);
    };

    const stop = () => { cancelAnimationFrame(anim); anim = 0; };

    // Where the running tween ends; reduced motion switching on mid-tween jumps straight there.
    let rest = v;
    const settle = () => { if (anim) { stop(); set(rest); } };
    motionQuery.addEventListener("change", () => { if (reduced()) settle(); });

    // Tween through a list of positions; used by the step buttons and the first-view peek.
    const glide = (points: number[], durations: number[]) => {
      stop();
      rest = points[points.length - 1];
      let i = 0;
      let from = v;
      let t0 = performance.now();
      const ease = (t: number) => 0.5 - Math.cos(Math.PI * t) / 2;
      const tick = (now: number) => {
        if (reduced()) { settle(); return; }
        const t = Math.min(1, (now - t0) / durations[i]);
        set(from + (points[i] - from) * ease(t));
        if (t < 1) { anim = requestAnimationFrame(tick); return; }
        from = points[i]; t0 = now; i++;
        anim = i < points.length ? requestAnimationFrame(tick) : 0;
      };
      anim = requestAnimationFrame(tick);
    };

    const xToV = (clientX: number) => {
      const r = stage.getBoundingClientRect();
      return ((clientX - r.left) / r.width) * 100;
    };

    // Pointer: mouse and pen move the split on press; touch waits for a
    // horizontal drag (so vertical swipes scroll the page) or a tap.
    let id: number | null = null;
    let dragging = false;
    let sx = 0;
    let sy = 0;
    stage.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || id !== null) return;
      touched = true;
      stop();
      id = e.pointerId;
      sx = e.clientX;
      sy = e.clientY;
      dragging = e.pointerType !== "touch";
      if (dragging) {
        e.preventDefault();
        stage.setPointerCapture(id);
        stage.classList.add("is-dragging");
        set(xToV(e.clientX));
        range.focus({ preventScroll: true });
      }
    });
    stage.addEventListener("pointermove", (e) => {
      if (e.pointerId !== id) return;
      if (!dragging) {
        const dx = Math.abs(e.clientX - sx);
        if (dx < SLOP || dx < Math.abs(e.clientY - sy)) return;
        dragging = true;
        stage.setPointerCapture(e.pointerId);
        stage.classList.add("is-dragging");
      }
      set(xToV(e.clientX));
    });
    const end = (e: PointerEvent) => {
      if (e.pointerId !== id) return;
      // A touch that never became a drag or a scroll is a tap: move the split there.
      if (!dragging && e.type === "pointerup" && Math.hypot(e.clientX - sx, e.clientY - sy) < 10) set(xToV(e.clientX));
      id = null;
      dragging = false;
      stage.classList.remove("is-dragging");
    };
    stage.addEventListener("pointerup", end);
    stage.addEventListener("pointercancel", end);
    stage.addEventListener("dragstart", (e) => e.preventDefault());

    range.addEventListener("input", () => { touched = true; stop(); set(range.valueAsNumber, false); });

    buttons.forEach((b) => b.addEventListener("click", () => {
      touched = true;
      const to = Number(b.dataset.go);
      if (reduced()) { stop(); set(to); return; }
      glide([to], [Math.max(220, Math.min(520, Math.abs(to - v) * 7))]);
    }));

    new ResizeObserver(() => { measure(); set(v, false); }).observe(stage);
    measure();
    set(v);

    // First view: one short peek each way, once the first two frames are ready.
    if (reduced()) return;
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((en) => en.isIntersecting)) return;
      io.disconnect();
      const frames = [...stage.querySelectorAll("img")].slice(0, 2);
      await Promise.all(frames.map((im) => im.decode().catch(() => {})));
      await new Promise((r) => setTimeout(r, 250));
      if (touched || reduced()) return;
      root.dataset.peeked = "";
      const home = v;
      glide([home + 6, home - 6, home], [340, 520, 380]);
    }, { threshold: 0.6 });
    io.observe(stage);
  });
</script>

<style is:global>
  .rs { display: grid; gap: var(--space-4); align-items: start; grid-template-areas: "media" "ticket" "cta"; }
  .rs-media { grid-area: media; }
  .rs-ticket { grid-area: ticket; }
  .rs-cta { grid-area: cta; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .rs-cta-link { font-weight: 600; padding-block: 0.6rem; }
  @media (min-width: 900px) {
    .rs { grid-template-columns: minmax(0, 1.7fr) minmax(19rem, 1fr); grid-template-rows: auto 1fr; grid-template-areas: "media ticket" "cta ticket"; column-gap: var(--space-4); row-gap: var(--space-3); }
    .rs-cta { align-self: start; padding-left: 0.25rem; }
  }

  /* The stage: four frames, one divider. --v (0-100) is the divider position. */
  .rs-stage {
    --pos: calc(var(--v) * 1%);
    position: relative; aspect-ratio: 3 / 2; cursor: ew-resize;
    touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
  }
  @media (min-width: 600px) { .rs-stage { aspect-ratio: 1672 / 941; } }
  .rs-stage.is-dragging { cursor: grabbing; }
  .rs-frames { position: absolute; inset: 0; overflow: hidden; border-radius: var(--radius-lg); background: var(--navy-900); box-shadow: var(--ring), var(--shadow-2); }
  .rs-stage .rs-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; -webkit-user-drag: none; }
  .rs-done { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  /* Frames hand over while you drag: X-ray to repair around 54-60, repair to tested around 79-85. */
  .rs-done .rs-img--repair { opacity: clamp(0, (var(--v) - 54) / 6, 1); }
  .rs-done .rs-img--tested { opacity: clamp(0, (var(--v) - 79) / 6, 1); }

  .rs-label {
    position: absolute; bottom: 0.75rem; z-index: 2; max-width: calc(50% - 2.5rem);
    padding: 0.35rem 0.65rem; border-radius: 6px; background: rgb(12 27 48 / 0.86); color: var(--white);
    font: 700 0.8125rem/1.25 var(--font-body); pointer-events: none; transition: opacity 0.2s ease;
  }
  .rs-label--done { left: 0.75rem; }
  .rs-label--before { right: 0.75rem; }
  .rs-label.is-off { opacity: 0; }
  @media (min-width: 600px) { .rs-label { bottom: 1rem; font-size: 0.875rem; } .rs-label--done { left: 1rem; } .rs-label--before { right: 1rem; } }

  /* Kept under the image for keyboard and screen readers; presses go to the stage. */
  .rs-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }

  .rs-divider { position: absolute; top: 0; bottom: 0; left: var(--pos); z-index: 3; width: 0; pointer-events: none; }
  .rs-divider::before { content: ""; position: absolute; top: 0; bottom: 0; left: -2px; width: 4px; background: var(--white); box-shadow: 0 0 0 1px rgb(12 27 48 / 0.35), 0 0 12px rgb(12 27 48 / 0.35); }
  /* While the X-ray view is showing, the divider reads as the scan line. */
  .rs[data-stage="1"] .rs-divider::before { background: var(--sky-300); box-shadow: 0 0 0 1px rgb(12 27 48 / 0.3), 0 0 14px rgb(106 174 214 / 0.85); }
  /* The pipe-ring handle, from the logo. Near the edges it stops at the photo's edge; the line still follows the pointer. */
  .rs-handle {
    --hs: 3.5rem;
    position: absolute; top: 50%; z-index: 4; width: var(--hs); height: var(--hs); border-radius: 50%; pointer-events: none;
    left: clamp(var(--hs) / 2, var(--pos), 100% - var(--hs) / 2); translate: -50% -50%;
    filter: drop-shadow(0 0 1px rgb(255 255 255 / 0.9)) drop-shadow(0 6px 12px rgb(6 14 26 / 0.4));
    transition: scale 0.15s ease;
  }
  @media (min-width: 600px) { .rs-handle { --hs: 4rem; } }
  .rs-handle svg { width: 100%; height: 100%; display: block; }
  .rs-stage:hover .rs-handle, .rs-stage.is-dragging .rs-handle { scale: 1.06; }
  .rs-range:focus-visible ~ .rs-handle { outline: 3px solid var(--white); outline-offset: 2px; box-shadow: 0 0 0 7px var(--navy); }

  /* Steps under the photo: a pipe that fills as the job moves forward. */
  .rs-steps { position: relative; list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .rs-steps::before, .rs-steps::after { content: ""; position: absolute; top: calc(0.25rem + 1.125rem - 3px); left: 12.5%; height: 6px; border-radius: 3px; }
  .rs-steps::before { right: 12.5%; background: var(--line); }
  .rs-steps::after { width: calc((var(--fill) - 12.5) * 1%); background: var(--sky); }
  .rs-step { position: relative; z-index: 1; display: flex; justify-content: center; }
  .rs-step-btn {
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem; min-width: 4.5rem; min-height: 3.5rem; padding: 0.25rem 0.4rem;
    background: none; border: 0; border-radius: var(--radius); cursor: pointer; font: inherit; color: var(--ink-soft);
  }
  .rs-step-n {
    display: grid; place-content: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
    background: var(--white); border: 2px solid #7a8ca3; color: var(--slate-ink); font: 700 1rem/1 var(--font-slab);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .rs-step-t { font-size: 0.875rem; font-weight: 600; line-height: 1.2; }
  .rs-step-btn:hover .rs-step-t { text-decoration: underline; text-underline-offset: 0.2em; }
  .rs-step.is-done .rs-step-n { background: var(--sky-100); border-color: var(--slate); }
  .rs-step.is-on .rs-step-n { background: var(--navy); border-color: var(--navy); color: var(--white); box-shadow: 0 0 0 4px var(--sky-100); }
  .rs-step.is-on .rs-step-t { color: var(--navy-900); }

  /* The job ticket: a work-order slip with a tear-off price stub. */
  .rs-ticket { background: var(--paper); border-radius: var(--radius-lg); box-shadow: inset 0 0 0 1px var(--line), var(--shadow-1); }
  .rs-ticket-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.75rem; padding: 1.1rem 1.25rem 0.9rem; border-bottom: 2px solid var(--navy); }
  .rs-ticket-title { margin: 0; font-size: 1.25rem; }
  .rs-ticket-where { flex-basis: 100%; margin: 0; font-size: 0.9375rem; color: var(--ink-soft); }
  .rs-lines { list-style: none; margin: 0; padding: 0.4rem 0.5rem; }
  .rs-line { position: relative; padding: 0.7rem 0.75rem 0.7rem 3rem; border-radius: var(--radius); transition: background-color 0.2s; }
  .rs-line + .rs-line { margin-top: 2px; }
  .rs-line-n {
    position: absolute; left: 0.75rem; top: 0.75rem; display: grid; place-content: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    border: 2px solid #7a8ca3; color: var(--slate-ink); font: 700 0.8125rem/1 var(--font-slab); background: var(--white); transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .rs-line-t { margin: 0 0 0.15rem; font: 700 1rem/1.3 var(--font-body); color: var(--navy-900); }
  .rs-line p { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--ink-soft); }
  .rs-line.is-on { background: var(--white); box-shadow: inset 4px 0 0 var(--sky), 0 1px 3px rgb(6 14 26 / 0.08); }
  .rs-line.is-on .rs-line-n { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .rs-line.is-on p { color: var(--ink); }

  .rs-stub { position: relative; padding: 1rem 1.25rem 1.2rem; border-top: 2px dashed #b5c2d2; margin-top: 0.4rem; }
  .rs-stub::before, .rs-stub::after { content: ""; position: absolute; top: -0.8rem; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--surface-raised); box-shadow: inset 0 0 0 1px var(--line); }
  .rs-stub::before { left: -0.75rem; clip-path: inset(0 0 0 50%); }
  .rs-stub::after { right: -0.75rem; clip-path: inset(0 50% 0 0); }
  .rs-stub p { margin: 0; }
  .rs-stub-k { font: 700 0.8125rem/1.3 var(--font-body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--slate-ink); }
  .rs-stub-price { font: 700 var(--step-3)/1.1 var(--font-slab); color: var(--navy-900); margin: 0.2rem 0 0.35rem !important; }
  .rs-stub-note { font-size: 0.9375rem; line-height: 1.5; color: var(--ink-soft); }
</style>
