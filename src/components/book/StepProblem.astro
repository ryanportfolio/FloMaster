---
// Booking question 1 as stamped valve tags. Tapping a problem hangs a tag on it, wired to that
// button: what the job is, its typical price, the call-out fee and who to call, stamped the way
// a tag on a shut-off valve names the line and the plumber. The tag is this question's answer
// tag: the page shows no second one. The tag shows through CSS (:has(:checked)), so it works
// without JavaScript; the page script only announces it and keeps it in view.
import Fact from "../Fact.astro";
import StepMark from "./StepMark.astro";
import { problems, sayFor } from "./problems";
import { facts } from "../../data/facts";
---
<fieldset class="step vt" id="f-job" data-step="job" aria-describedby="err-job">
  <legend><StepMark n={1} /> <span class="lg-t">What needs doing?<span class="visually-hidden" data-state></span></span></legend>
  <p class="intro">Tap what you're seeing. A tag with the price hangs right under it.</p>

  <div class="list">
    {problems.map((p) => (
      <>
        <label class="opt">
          <input type="radio" name="job" value={p.slug} data-label={p.words} data-title={p.service.title} data-say={sayFor(p)} aria-controls={`vt-${p.slug}`} />
          <span class="face"><span class="eye" aria-hidden="true"></span><span class="w">{p.words}</span><span class="d">{p.detail}</span></span>
        </label>
        <div class="hang" id={`vt-${p.slug}`}>
          <div class="tag">
            <span class="hole" aria-hidden="true"></span>
            <div class="t-main">
              <p class="stamp line">{p.service.title}</p>
              <p class="price num"><Fact k="priceRanges">{p.prices[0].range}</Fact></p>
              <p class="for">{p.prices[0].job}</p>
              {p.prices.length > 1 && (
                <ul class="also">
                  {p.prices.slice(1).map((r) => <li><span>{r.job}</span> <strong class="num"><Fact k="priceRanges" plain>{r.range}</Fact></strong></li>)}
                </ul>
              )}
            </div>
            <div class="t-side">
              <div class="row callout">
                <p class="stamp">Call-out <span class="num"><Fact k="calloutFee" /></span></p>
                <p class="small"><Fact k="calloutCredited" /></p>
              </div>
              {p.urgent && <p class="urgent">{p.urgent}</p>}
              <div class="row who">
                <p class="stamp">Who to call</p>
                <p class="who-name">{facts.owner.value} <a class="tel num" href={`tel:${facts.phoneHref.value}`}>{facts.phone.value}</a></p>
                <p class="stamp lic">Va. master plumber <span class="num">{facts.license.value}</span></p>
              </div>
            </div>
          </div>
        </div>
      </>
    ))}
    <label class="opt">
      <input type="radio" name="job" value="other" data-label="Something else" data-title="" data-say={sayFor(null)} aria-controls="vt-other" />
      <span class="face"><span class="eye" aria-hidden="true"></span><span class="w">Something else</span><span class="d">Tell me in a few words</span></span>
    </label>
    <div class="hang" id="vt-other">
      <div class="tag">
        <span class="hole" aria-hidden="true"></span>
        <div class="t-main">
          <div class="field other" data-other>
            <label for="other-note">What are you seeing?</label>
            <input id="other-note" name="note" type="text" autocomplete="off" />
          </div>
          <p class="small">I'll write you a flat price after I look, before I start.</p>
        </div>
        <div class="t-side">
          <div class="row callout">
            <p class="stamp">Call-out <span class="num"><Fact k="calloutFee" /></span></p>
            <p class="small"><Fact k="calloutCredited" /></p>
          </div>
          <div class="row who">
            <p class="stamp">Who to call</p>
            <p class="who-name">{facts.owner.value} <a class="tel num" href={`tel:${facts.phoneHref.value}`}>{facts.phone.value}</a></p>
            <p class="stamp lic">Va. master plumber <span class="num">{facts.license.value}</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <span class="error" id="err-job"></span>
  <p class="visually-hidden" role="status" data-job-status></p>
</fieldset>

<style>
  .intro { color: var(--ink-soft); margin: 0 0 1rem; }

  .list { display: grid; gap: 0.6rem; }
  .list > * { min-width: 0; }
  .opt { position: relative; display: block; }
  .opt input { position: absolute; z-index: 1; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .face {
    position: relative; display: grid; grid-template-columns: 1.25rem 1fr; column-gap: 0.9rem; align-items: center;
    min-height: 3.5rem; padding: 0.7rem 1rem; border: 2px solid #74869e; border-radius: var(--radius); background: var(--white);
  }
  /* The eye on the button is the radio mark; the tag's wire hangs from it once picked. */
  .eye { grid-row: 1 / span 2; width: 1.25rem; height: 1.25rem; border-radius: 50%; border: 2px solid #74869e; background: var(--paper); }
  .w { font-weight: 700; font-size: var(--step-0); line-height: 1.25; color: var(--navy-900); }
  .d { grid-column: 2; font-size: var(--step--1); color: var(--ink-soft); line-height: 1.35; }
  .opt:hover .face { border-color: var(--navy); }
  .opt input:focus-visible + .face { outline: 3px solid var(--navy); outline-offset: 2px; }
  .opt input:checked + .face { border-color: var(--navy); background: var(--sky-100); }
  .opt input:checked + .face .eye { border-color: var(--navy); background: var(--navy); box-shadow: inset 0 0 0 3px var(--sky-100); }

  /* The wire drops from the eye (1rem padding + 2px border + half the eye) to the tag's slot. */
  .hang { display: none; position: relative; overflow-x: clip; padding: 2.1rem 0 0.6rem; margin-top: -0.6rem; }
  .hang::before { content: ""; position: absolute; left: calc(1rem + 2px + 0.625rem - 1px); top: -2px; height: calc(2.1rem + 2px + 1.2rem + 2px); width: 2px; background: var(--navy); }
  .opt input:checked + .face::after { content: ""; position: absolute; left: calc(1rem + 0.625rem - 1px); top: calc(50% + 0.625rem); bottom: -2px; width: 2px; background: var(--navy); }
  .opt:has(input:checked) + .hang { display: block; }
  .opt:has(input:checked) + .hang .tag { animation: swing 0.3s ease-out; transform-origin: 1.3rem 0; }
  @keyframes swing { from { opacity: 0; transform: rotate(-3deg) translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .opt:has(input:checked) + .hang .tag { animation: none; } }

  .tag {
    position: relative; margin-left: 0.35rem;
    background: var(--white); border: 2px solid var(--navy); border-radius: 1.25rem;
    padding: 1rem 1.15rem 1.1rem; box-shadow: var(--shadow-1);
  }
  .tag p { margin: 0; max-width: none; }
  /* The punched slot the wire runs through: a dark bar, so it can't be mistaken for a radio. */
  .hole { position: absolute; left: 0.525rem; top: 0.925rem; width: 1.5rem; height: 0.55rem; border-radius: 0.3rem; background: var(--navy); }
  .t-main > .line, .t-main > .other { margin-left: 1.9rem; }
  /* Stamped type: capitals, wide spacing, heavy, so a number reads at a glance. */
  .stamp { font: 700 0.9375rem/1.35 var(--font-slab); letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy-900); }
  .line { padding-top: 0.1rem; min-height: 1.4rem; }
  .price { font: 800 clamp(2.25rem, 1.6rem + 2.6vw, 3.25rem)/1.05 var(--font-slab); letter-spacing: 0.02em; color: var(--navy-900); margin-top: 0.6rem !important; }
  .for { color: var(--ink-soft); font-size: var(--step--1); }
  .also { list-style: none; padding: 0; margin: 0.75rem 0 0; }
  .also li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; border-top: 1px solid var(--line); font-size: var(--step--1); }
  .also strong { font-family: var(--font-slab); font-size: var(--step-0); color: var(--navy-900); white-space: nowrap; }
  .row { border-top: 2px solid var(--navy); margin-top: 0.85rem; padding-top: 0.7rem; }
  .callout .stamp { font-size: 1.0625rem; }
  .callout .stamp .num { font-size: 1.5rem; letter-spacing: 0.04em; margin-left: 0.35rem; }
  .small { font-size: var(--step--1); color: var(--ink-soft); }
  .urgent { margin-top: 0.85rem !important; padding: 0.55rem 0 0.55rem 0.85rem; border-left: 5px solid var(--signal); font-weight: 600; }
  .who-name { font-family: var(--font-slab); font-weight: 700; font-size: var(--step-0); color: var(--navy-900); display: flex; flex-wrap: wrap; gap: 0 0.75rem; align-items: baseline; margin-top: 0.2rem !important; }
  .tel { font-size: var(--step-1); letter-spacing: 0.04em; color: var(--navy); display: inline-block; min-height: 2.75rem; line-height: 2.75rem; }
  .lic { font-size: 0.875rem; color: var(--slate-ink); }
  .other { margin-bottom: 0.5rem; }
  .other label { display: block; font-weight: 700; margin-bottom: 0.35rem; }

  /* Wider screens: price on the left, call-out and who to call on the right, so the tag fills the
     question's width instead of leaving an empty band beside it. */
  @media (min-width: 640px) {
    .tag { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); column-gap: 1.5rem; }
    .t-side { border-left: 2px solid var(--navy); padding-left: 1.25rem; }
    .t-side > .row:first-child { border-top: 0; margin-top: 0; padding-top: 0.1rem; }
  }
</style>
