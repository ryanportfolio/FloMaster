---
import Logo from "./Logo.astro";
import Fact from "./Fact.astro";
import { facts } from "../data/facts";
import { cities } from "../data/area";
---
<footer class="site-footer navy on-navy">
  <div class="wrap grid-f">
    <div>
      <Logo class="f-logo" />
      <p class="f-sub">Plumbing and Drains · Est. {facts.established.value}</p>
      <p class="f-card">
        <strong>{facts.owner.value}</strong><br />
        Virginia Master Plumber<br />
        License <span class="num">#{facts.license.value}</span><br />
        <a class="num" href={`tel:${facts.phoneHref.value}`}>{facts.phone.value}</a>
      </p>
      <p class="small"><Fact k="contractorLicense" onlyWithTags /></p>
      <p class="small"><Fact k="insurance" /> · <Fact k="bonded" /></p>
    </div>
    <div>
      <h2 class="f-h">Hours</h2>
      <p class="small"><Fact k="hours" /></p>
      <p class="small"><Fact k="emergency247" /> for leaks, floods and no water.</p>
      <h2 class="f-h">Service area</h2>
      <p class="small">{cities.join(", ")}. <a href="/service-area">Check your ZIP</a>.</p>
    </div>
    <div>
      <h2 class="f-h">Get help</h2>
      <ul class="f-links">
        <li><a href="/emergency">Emergency help</a></li>
        <li><a href="/book">Book a time</a></li>
        <li><a href="/book#callback">Ask for a callback</a></li>
        <li><a href="/pricing">Prices, fees and guarantee</a></li>
        <li><a href="/faq">Questions</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap small f-base">© {new Date().getFullYear()} {facts.name.value}. Owned and run by {facts.owner.value}.</p>
</footer>

<style>
  .site-footer { padding: var(--space-5) 0 calc(var(--bar-h) + var(--space-3)); }
  @media (min-width: 900px) { .site-footer { padding-bottom: var(--space-3); } }
  .grid-f { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .grid-f { grid-template-columns: 1.3fr 1fr 1fr; } }
  .site-footer :global(.f-logo) { height: 1.93rem; }
  .f-sub { color: var(--sky-300); font-size: 0.9375rem; letter-spacing: 0.08em; margin: 0.5rem 0 1.5rem; }
  .f-card { font-family: var(--font-slab); font-size: 1.1875rem; line-height: 1.55; border-left: 3px solid var(--sky); padding-left: 1rem; }
  .f-h { font-size: 1.1875rem; margin: 0 0 0.4rem; color: var(--sky-300); }
  .f-h:not(:first-child) { margin-top: 1.5rem; }
  .f-links { list-style: none; padding: 0; margin: 0; }
  .f-links a { display: inline-block; padding: 0.35rem 0; }
  .f-base { margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid rgb(255 255 255 / 0.12); color: var(--sky-300); max-width: none; }
</style>
