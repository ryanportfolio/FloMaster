---
// The back of Antonio's business card, as a page element: name, trade,
// license and phone, on the card's navy wave pattern with its valve mark.
import { facts } from "../data/facts";
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={["bcard", cls]}>
  <svg class="bcard-valve" viewBox="0 0 64 64" aria-hidden="true">
    <g fill="currentColor">
      <rect x="2" y="30" width="10" height="22" rx="2" />
      <rect x="52" y="30" width="10" height="22" rx="2" />
      <path d="M12 35h8c1-6 6-10 12-10s11 4 12 10h8v12h-8c-1 6-6 10-12 10s-11-4-12-10h-8z" />
      <rect x="28" y="12" width="8" height="14" />
      <rect x="16" y="6" width="32" height="7" rx="3.5" />
    </g>
    <path d="M32 36c2 3 4 5.4 4 7.6a4 4 0 0 1-8 0c0-2.2 2-4.6 4-7.6z" fill="var(--navy)" />
  </svg>
  <p class="bcard-name">{facts.owner.value}</p>
  <p class="bcard-line">Master Plumber</p>
  <p class="bcard-line">License # <span class="num">{facts.license.value}</span></p>
  <a class="bcard-phone num" href={`tel:${facts.phoneHref.value}`}>{facts.phone.value.replace(/[()]/g, "").replace(" ", "-")}<span class="visually-hidden">, call Antonio</span></a>
</div>

<style>
  .bcard {
    position: relative; width: min(100%, 22rem); aspect-ratio: 1.75;
    padding: 1.4rem 1.5rem; border-radius: 16px; color: var(--white);
    background: var(--navy) var(--waves); background-size: 72px 36px;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08) inset, 0 24px 48px -12px rgb(6 14 26 / 0.55), 0 4px 10px rgb(6 14 26 / 0.3);
    display: flex; flex-direction: column; justify-content: center;
    font-family: var(--font-slab);
  }
  .bcard p { margin: 0; max-width: none; }
  .bcard-name { font-size: 1.45rem; font-weight: 700; line-height: 1.2; }
  .bcard-line { font-size: 1.05rem; line-height: 1.45; }
  .bcard-phone { display: inline-block; margin-top: 0.35rem; font-size: 1.3rem; font-weight: 700; color: var(--white); text-decoration: none; letter-spacing: 0.01em; align-self: flex-start; padding: 0.2rem 0; }
  .bcard-phone:hover { text-decoration: underline; text-decoration-color: var(--sky); }
  .bcard-valve { position: absolute; right: 1.1rem; bottom: 1.1rem; width: 3.4rem; height: 3.4rem; color: rgb(255 255 255 / 0.92); }
</style>
