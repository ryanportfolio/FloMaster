---
// About page body as a work order: who does the work, filled in the way a work order names the
// plumber on the job. Fields filled in (name, trade, license with the DPOR lookup, phone,
// insurance), the job site pre-printed with the seven cities, the promises as the lines on every
// job, and the two places a work order is signed: Antonio's, and the customer's yes.
import Photo from "./Photo.astro";
import Fact from "./Fact.astro";
import FactBlock from "./FactBlock.astro";
import hero from "../assets/photos/hero.jpg";
import { facts } from "../data/facts";
import { cities } from "../data/area";
import { dpor } from "../data/faq";
const lines = [
  { when: "Before the price", what: "I find the cause before I name a price." },
  { when: "Before I start", what: "You get repair and replacement prices side by side, and you choose." },
  { when: "After the repair", what: "I show you the old part and explain what failed." },
  { when: "Before I leave", what: "Drop cloths down, mess cleaned up, everything tested before I leave." },
];
---
<section class="section aa">
  <div class="wrap aa-story">
    <div>
      <p class="lead">I've been a plumber for <Fact k="yearsInTrade" />, and I started FloMasters in {facts.established.value} to give customers what I'd want in my own house</p>
      <p>That means a straight answer, a fair price written down before the work starts, and the same person from the phone call to the clean-up.</p>
      <FactBlock k="workPromises"><p>There's no call center and no sales team. When you call, I pick up, or I call you back as soon as I'm out from under the sink. When you book, I'm the one who turns up, and I'm the one who stands behind the work.</p></FactBlock>
    </div>
    <Photo src={hero} fact="hero" alt="Antonio beside his van, shelves of parts inside" widths={[480, 768, 1080]} sizes="(min-width: 1000px) 500px, 100vw" class="aa-van" shot="Antonio with the van" />
  </div>

  <div class="wrap">
    <article class="wo" aria-labelledby="wo-h">
      <header class="wo-top">
        <h2 id="wo-h">Who does the work</h2>
        <p class="wo-no">No. <span class="num">{facts.license.value}</span><span class="wo-no-k">Va. Master Plumber license</span></p>
      </header>
      <p class="wo-site"><span class="wo-k">Job site</span><span class="wo-cities">{cities.map((c) => <span>{c}</span>)}</span></p>

      <dl class="wo-fields">
        <div><dt>Plumber</dt><dd>{facts.owner.value}</dd></div>
        <div><dt>Trade</dt><dd>Virginia Master Plumber</dd></div>
        <div><dt>License no.</dt><dd><span class="num">{facts.license.value}</span> <a class="wo-check" href={dpor} rel="noopener">Check it on DPOR</a></dd></div>
        <div><dt>Phone</dt><dd><a class="num" href={`tel:${facts.phoneHref.value}`}>{facts.phone.value}</a></dd></div>
        <div><dt>Business</dt><dd>{facts.name.value}, est. {facts.established.value}</dd></div>
        <div><dt>In the trade</dt><dd><Fact k="yearsInTrade" /></dd></div>
        <div><dt>Insurance</dt><dd><Fact k="insurance" /></dd></div>
        <div><dt>Bonding</dt><dd><Fact k="bonded" /></dd></div>
        {facts.contractorLicense.status === "confirmed"
          ? <div><dt>Contractor license</dt><dd>{facts.contractorLicense.value}</dd></div>
          : <div class="tags-only"><dt>Contractor license</dt><dd><Fact k="contractorLicense" /></dd></div>}
      </dl>

      <FactBlock k="workPromises" class="wo-lines-wrap">
        <h3 class="wo-sub">On every job</h3>
        <ol class="wo-lines">
          {lines.map((l, i) => (
            <li><span class="fno" aria-hidden="true">{i + 1}</span><span class="wo-what">{l.what}</span><span class="wo-when">{l.when}</span></li>
          ))}
          <li><span class="fno" aria-hidden="true">{lines.length + 1}</span><span class="wo-what"><Fact k="laborWarranty" /> on every job.</span><span class="wo-when">For a year after</span></li>
        </ol>
      </FactBlock>

      <div class="wo-sign">
        <div class="sig">
          <p class="sig-v">{facts.owner.value}</p>
          <p class="sig-k">Plumber, signs for the work</p>
        </div>
        <FactBlock k="quoting" class="sig sig--you">
          <p class="sig-v sig-v--blank" aria-hidden="true"></p>
          <p class="sig-k">You, once you've seen the written price</p>
        </FactBlock>
      </div>
    </article>
    <p class="aa-dpor small">Check my license yourself on the <a href={dpor} rel="noopener">Virginia DPOR license lookup</a>: search for license <span class="num">{facts.license.value}</span>.</p>
  </div>
</section>

<style>
  .aa-story { display: grid; gap: var(--space-4); align-items: center; margin-bottom: var(--space-5); }
  @media (min-width: 1000px) { .aa-story { grid-template-columns: minmax(0, 1fr) 30rem; gap: var(--space-5); } }
  .aa-story :global(.aa-van) { border-radius: var(--radius-lg); aspect-ratio: 4 / 3; width: 100%; box-shadow: var(--shadow-1); }

  .wo { background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--ring), var(--shadow-2); padding: 1.25rem 1.1rem 1.5rem; }
  @media (min-width: 760px) { .wo { padding: 2rem 2.5rem 2.25rem; } }
  .wo p { max-width: none; }
  .wo-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 0.5rem 2rem; padding-bottom: 0.8rem; border-bottom: 3px solid var(--navy); }
  .wo-top h2 { margin: 0; font-size: var(--step-3); }
  .wo-no { margin: 0; font: 700 var(--step-1)/1.2 var(--font-slab); color: var(--navy-900); text-align: right; }
  .wo-no-k { display: block; font: 600 var(--step--1)/1.3 var(--font-body); color: var(--ink-soft); }
  @media (max-width: 559px) { .wo-no { text-align: left; } }
  .wo-site { display: grid; gap: 0.35rem; margin: 0; padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 760px) { .wo-site { grid-template-columns: 11rem 1fr; align-items: baseline; } }
  .wo-k, .wo-fields dt { font-weight: 700; font-size: var(--step--1); color: var(--ink-soft); }
  .wo-cities { display: flex; flex-wrap: wrap; gap: 0.35rem 0.5rem; }
  .wo-cities span { font: 600 var(--step--1)/1.3 var(--font-slab); color: var(--navy-900); padding: 0.2rem 0.6rem; border: 1.5px solid var(--slate); border-radius: 999px; }

  .wo-fields { margin: 0; display: grid; column-gap: 2.5rem; }
  @media (min-width: 760px) { .wo-fields { grid-template-columns: 1fr 1fr; } }
  .wo-fields > div { display: grid; gap: 0.1rem; padding: 0.7rem 0 0.55rem; border-bottom: 1px solid var(--line); min-width: 0; }
  @media (min-width: 560px) { .wo-fields > div { grid-template-columns: 9.5rem 1fr; gap: 1rem; align-items: baseline; } }
  :global(.tags-on) .wo-fields > .tags-only { display: grid !important; }
  .wo-fields dd { margin: 0; font: 700 var(--step-0)/1.4 var(--font-slab); color: var(--navy-900); overflow-wrap: anywhere; }
  /* At least 24 px tall on its own (it sits inline beside the number). */
  .wo-check { display: inline-flex; align-items: center; min-height: 1.75rem; margin-left: 0.4rem; font: 600 var(--step--1)/1.4 var(--font-body); white-space: nowrap; }

  .wo-sub { margin: 1.75rem 0 0; padding-bottom: 0.5rem; font-size: var(--step-2); border-bottom: 2px solid var(--navy); }
  .wo-lines { list-style: none; margin: 0; padding: 0; }
  .wo-lines li { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.85rem; align-items: baseline; padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 760px) { .wo-lines li { grid-template-columns: auto 1fr 12rem; } }
  .wo-what { font-weight: 600; }
  .wo-when { grid-column: 2; font: 600 var(--step--1)/1.3 var(--font-slab); color: var(--slate-ink); }
  @media (min-width: 760px) { .wo-when { grid-column: auto; text-align: right; } }
  .fno { display: inline-grid; place-content: center; width: 1.6rem; height: 1.6rem; border: 2px solid var(--navy); border-radius: 4px; font: 700 0.9375rem/1 var(--font-slab); color: var(--white); background: var(--navy); flex: none; align-self: center; }

  .wo-sign { display: grid; gap: 1.5rem 2.5rem; margin-top: 2rem; }
  @media (min-width: 760px) { .wo-sign { grid-template-columns: 1fr 1fr; } }
  .wo-sign :global(.sig) { min-width: 0; }
  .sig-v { margin: 0; min-height: 3rem; padding: 0 0 0.25rem; display: flex; align-items: flex-end; border-bottom: 2px solid var(--navy); font: 700 var(--step-2)/1.1 var(--font-slab); color: var(--navy-900); }
  .sig-k { margin: 0.4rem 0 0; font-size: var(--step--1); color: var(--ink-soft); }
  .aa-dpor { margin-top: 1rem; }
</style>
