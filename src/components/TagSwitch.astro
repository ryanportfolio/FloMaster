---
// Prototype only (Header.astro). The review bar that sat here (the "Items to confirm" switch and
// the link to the full list) is gone at the owner's request; tags still turn on with ?tags=on and
// off with ?tags=off (the head script in Base.astro). What stays: the sticky header's height for
// the page's offsets, and two accessibility fixes for the "confirm this" tags and the sticky area.
---
<script>
  const root = document.documentElement;

  // Sticky offsets (scroll padding, sticky side panels, the menu's height) follow the real height
  // of the sticky header, which wraps differently by width.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    const setSticky = () => root.style.setProperty("--sticky-h", `${header.offsetHeight}px`);
    setSticky();
    new ResizeObserver(setSticky).observe(header);
    // WCAG 2.4.11: the taller sticky area leaves less room, and Chrome does not scroll a focused
    // element that is already partly in view. If focus moved by keyboard lands on one under the
    // sticky area or the phone bottom bar, scroll it clear (scrollIntoView keeps the scroll padding);
    // one taller than the room between the paddings goes to the top of it. Focus after a click or
    // tap is left alone, so pressing in a field or panel never moves the page. (`:focus-visible`
    // cannot tell them apart: Chrome sets it for clicked text fields and script-moved focus.)
    let byKey = false;
    addEventListener("keydown", () => { byKey = true; }, true);
    addEventListener("pointerdown", () => { byKey = false; }, true);
    document.addEventListener("focusin", (e) => {
      const el = e.target as HTMLElement;
      if (!byKey || !(el instanceof HTMLElement) || header.contains(el) || el.closest("[data-sticky]")) return;
      const r = el.getBoundingClientRect(), top = header.getBoundingClientRect().bottom;
      const bar = document.querySelector<HTMLElement>("[data-sticky]");
      const bottom = bar && !bar.classList.contains("is-waiting") && getComputedStyle(bar).display !== "none" ? bar.getBoundingClientRect().top : innerHeight;
      const cs = getComputedStyle(document.documentElement), room = innerHeight - parseFloat(cs.scrollPaddingTop) - parseFloat(cs.scrollPaddingBottom);
      if (r.height && (r.top < top || r.bottom > bottom)) el.scrollIntoView({ block: r.height <= room ? "nearest" : "start" });
    });
  }

  // WCAG 1.4.13: Escape dismisses an open question; it returns on the next hover or focus.
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") root.classList.add("tips-hidden"); });
  const show = (e: Event) => { if ((e.target as Element).closest?.(".fact-tag")) root.classList.remove("tips-hidden"); };
  document.addEventListener("focusin", show);
  document.addEventListener("pointerover", show);
</script>
