---
// Callback request: one required field. Prototype only: nothing is sent.
// Working hours are judged in Virginia time, not the visitor's clock.
import Fact from "./Fact.astro";
import { workingHours } from "../data/facts";
interface Props { id: string; urgent?: boolean }
const { id, urgent = false } = Astro.props;
---
<form class="cbf panel" data-callback novalidate method="post" action="/book#callback" data-hours={JSON.stringify(workingHours)}>
  <h3 class="cbf-h">Ask for a callback</h3>
  <div class="field">
    <label for={`${id}-phone`}>Mobile number</label>
    <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby={`${id}-phone-hint ${id}-phone-err`} required data-carry-phone />
    <span class="hint" id={`${id}-phone-hint`}>I'll call this number. I may text first if I'm under a sink.</span>
    <span class="error" id={`${id}-phone-err`} aria-live="polite"></span>
  </div>
  <div class="field">
    <label for={`${id}-what`}>What's going on? <span class="muted">(optional)</span></label>
    <textarea id={`${id}-what`} name="what" rows="3"></textarea>
  </div>
  <button class="btn btn--navy btn--block" type="submit" data-label="Call me back" disabled data-needs-js>Call me back</button>
  <p class="cbf-when small" data-when></p>
  <p class="cbf-done" role="status" data-done></p>
  <template data-in>I'll call you back <Fact k="callback" />.</template>
  <template data-out>It's outside working hours right now. I'll call you back {"{next}"}, when I start. For a flood, call instead.</template>
</form>

<script>
  type Spec = { weekday: number[]; saturday: number[] | null; sunday: number[] | null };
  // Day and hour in Virginia, whatever the visitor's clock says.
  const nyParts = (d: Date) => {
    const p = new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", weekday: "short", hour: "numeric", hour12: false }).formatToParts(d);
    return { day: p.find((x) => x.type === "weekday")!.value, hour: Number(p.find((x) => x.type === "hour")!.value) % 24 };
  };
  const rangeFor = (spec: Spec, day: string) => (day === "Sun" ? spec.sunday : day === "Sat" ? spec.saturday : spec.weekday);
  const isOpen = (spec: Spec) => { const { day, hour } = nyParts(new Date()); const r = rangeFor(spec, day); return !!r && hour >= r[0] && hour < r[1]; };
  const hourLabel = (h: number) => (h === 12 ? "12 p.m." : h < 12 ? `${h} a.m.` : `${h - 12} p.m.`);
  const longDay: Record<string, string> = { Mon: "Monday", Tue: "Tuesday", Wed: "Wednesday", Thu: "Thursday", Fri: "Friday", Sat: "Saturday", Sun: "Sunday" };
  const nyDate = (ms: number) => new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York" }).format(new Date(ms));
  // The next time a working period starts, from the same hours data as the footer.
  const nextOpening = (spec: Spec) => {
    const today = nyDate(Date.now()), tomorrow = nyDate(Date.now() + 86400000);
    for (let h = 1; h <= 24 * 8; h++) {
      const ms = Date.now() + h * 3600000;
      const t = nyParts(new Date(ms));
      const r = rangeFor(spec, t.day);
      if (r && t.hour === r[0]) {
        const d = nyDate(ms);
        const when = d === today ? "today" : d === tomorrow ? "tomorrow" : longDay[t.day];
        return `${when} at ${hourLabel(r[0])}`;
      }
    }
    return "on the next working day";
  };
  // Keep every phone field on the page in step, live (WCAG 3.3.7: no re-entering).
  document.addEventListener("input", (e) => {
    const src = e.target as HTMLInputElement;
    if (!src.matches?.("[data-carry-phone]")) return;
    document.querySelectorAll<HTMLInputElement>("[data-carry-phone]").forEach((el) => { if (el !== src) el.value = src.value; });
    try { sessionStorage.setItem("fm-phone", src.value); } catch {}
  });
  const validPhone = (v: string) => v.replace(/\D/g, "").replace(/^1(?=\d{10}$)/, "").length === 10;

  document.querySelectorAll<HTMLFormElement>("[data-callback]").forEach((form) => {
    const when = form.querySelector<HTMLElement>("[data-when]")!;
    const spec: Spec = JSON.parse(form.dataset.hours!);
    when.innerHTML = isOpen(spec) ? form.querySelector<HTMLTemplateElement>("[data-in]")!.innerHTML : form.querySelector<HTMLTemplateElement>("[data-out]")!.innerHTML.replace("{next}", nextOpening(spec));
    const phone = form.querySelector<HTMLInputElement>("input[name=phone]")!;
    const err = form.querySelector<HTMLElement>(".error")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const done = form.querySelector<HTMLElement>("[data-done]")!;
    try { const saved = sessionStorage.getItem("fm-phone"); if (saved && !phone.value) phone.value = saved; } catch {}
    let tried = false;
    const check = () => {
      const ok = validPhone(phone.value);
      if (ok) phone.removeAttribute("aria-invalid"); else phone.setAttribute("aria-invalid", "true");
      err.textContent = ok ? "" : "Enter a 10-digit mobile number so I can call you back.";
      return ok;
    };
    phone.addEventListener("input", () => { if (tried) check(); try { sessionStorage.setItem("fm-phone", phone.value); } catch {} });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      tried = true;
      if (!check()) { phone.focus(); return; }
      btn.disabled = true;
      btn.textContent = "Sending...";
      setTimeout(() => {
        btn.textContent = "Sent";
        done.textContent = "Got it. I'll call you back soon. (Prototype: nothing was sent.)";
      }, 600);
    });
  });
</script>

<style>
  .cbf { border-top: 5px solid var(--sky); }
  .cbf-h { font-size: var(--step-1); }
  .cbf-when { margin: 0.75rem 0 0; color: var(--ink-soft); }
  .cbf-done { margin: 0.5rem 0 0; font-weight: 700; color: var(--ok); }
  .cbf-done:empty { display: none; }
</style>
