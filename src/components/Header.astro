---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import TagSwitch from "./TagSwitch.astro";
import { facts, isPublicBuild } from "../data/facts";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/residential", label: "Home services" },
  { href: "/commercial", label: "Commercial" },
  { href: "/pricing", label: "Prices" },
  { href: "/reviews", label: "Reviews" },
  { href: "/service-area", label: "Service area" },
  { href: "/about", label: "About" },
];
---
<header class="site-header on-navy">
  {/* Prototype only: the review bar rides in the sticky header, so the header sits at the same
      place on every page and scroll position. */}
  {!isPublicBuild && <TagSwitch />}
  <div class="bar wrap">
    <a class="brand" href="/" aria-label="FloMasters Plumbing and Drains, home">
      <Logo class="brand-logo" />
      <span class="brand-sub">Plumbing and Drains</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="phone" href={`tel:${facts.phoneHref.value}`}>
        <Icon name="phone" />
        <span class="phone-num num">{facts.phone.value}</span>
        <span class="visually-hidden">Call {facts.ownerFirst.value}</span>
      </a>
      <a class="btn btn--primary book" href="/book">Book a time</a>
      <details class="menu">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/emergency">Emergency</a></li>
          <li><a href="/faq">Questions</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>
<div class="license-band on-navy">
  <p class="license wrap">
    <span>Virginia Master Plumber</span>
    <span aria-hidden="true">·</span>
    <span>License <span class="num">#{facts.license.value}</span></span>
    <span class="est" aria-hidden="true">·</span>
    <span class="est">Est. {facts.established.value}</span>
  </p>
</div>

<style>
  /* The bar sticks to the top while scrolling; the license line under it scrolls away. */
  .site-header { position: sticky; top: 0; z-index: 40; background: var(--navy-950); color: var(--white); }
  /* A shadow fades in over the first 80px of scroll, so the bar stands off navy sections. */
  @supports (animation-timeline: scroll()) {
    .site-header { animation: header-lift linear both; animation-timeline: scroll(root); animation-range: 0 80px; }
    @keyframes header-lift { from { box-shadow: 0 0 0 rgb(0 0 0 / 0); } to { box-shadow: 0 1px 0 rgb(255 255 255 / 0.08), 0 8px 24px rgb(0 0 0 / 0.28); } }
  }
  /* What the bar shows depends on its own width in rem (container queries below), so a larger
     browser font size collapses the nav, hides the Book button and the number, and tightens the
     brand before anything collides; plain px breakpoints ignored the font size. The bar's height
     never changes with these steps. */
  .bar { display: flex; align-items: center; gap: 0.5rem; height: var(--header-h); container: hbar / inline-size; }
  .brand { display: flex; flex-direction: column; text-decoration: none; color: var(--white); }
  .brand :global(.brand-logo) { height: 1.15rem; }
  .brand-sub { font-size: 0.625rem; line-height: 1.2; letter-spacing: 0.04em; text-transform: uppercase; color: var(--sky-300); margin-top: 0.3rem; white-space: nowrap; }
  .nav { display: none; margin-left: auto; }
  .nav ul { display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .nav a { display: block; padding: 0.6rem 0.65rem; color: var(--white); text-decoration: none; font-weight: 600; font-size: 1.0625rem; border-radius: 6px; white-space: nowrap; }
  .nav a:hover, .nav a[aria-current="page"] { background: var(--navy); }
  .nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--sky); }
  .actions { display: flex; flex: none; align-items: center; gap: 0.25rem; margin-left: auto; }
  /* The Call button: an icon on narrow bars, the full number once it fits, set at the size of
     the Book label so it reads at a glance. 48px minimum on the narrowest bars, 3rem above. */
  .phone { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-width: 48px; min-height: 48px; padding: 0 0.6rem; color: var(--white); text-decoration: none; font-weight: 700; font-size: 1.1875rem; letter-spacing: 0.01em; border-radius: var(--radius); background: var(--navy); white-space: nowrap; }
  .phone:hover { background: var(--navy-900); }
  .phone :global(svg) { width: 1.3rem; height: 1.3rem; flex: none; color: var(--sky); }
  .phone-num { display: none; }
  .book { display: none; min-height: 3rem; white-space: nowrap; }
  .menu { position: relative; }
  .menu summary { list-style: none; width: 48px; height: 48px; display: grid; place-content: center; gap: 5px; cursor: pointer; border-radius: var(--radius); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 22px; height: 2px; background: var(--white); }
  /* The bar stays on screen, so the open menu scrolls inside itself on short screens. */
  .menu ul { position: absolute; right: 0; top: calc(100% + 0.5rem); background: var(--navy-950); list-style: none; margin: 0; padding: 0.5rem; border-radius: var(--radius); min-width: 15rem; max-height: calc(100dvh - var(--sticky-h) - 1rem); overflow-y: auto; box-shadow: 0 16px 40px rgb(0 0 0 / 0.35); }
  .menu a { display: block; padding: 0.75rem 0.9rem; color: var(--white); text-decoration: none; font-weight: 600; font-size: 1.125rem; border-radius: 6px; }
  .menu a:hover { background: var(--navy); }
  .license-band { background: var(--navy-950); color: var(--sky-300); }
  .license { display: flex; flex-wrap: wrap; gap: 0.15rem 0.5rem; margin: 0 auto; padding: 0.45rem 0 0.6rem; font-size: 0.9375rem; line-height: 1.4; border-top: 1px solid rgb(255 255 255 / 0.08); max-width: none; }
  .license .num { color: var(--white); font-weight: 700; }
  .est { display: none; }
  /* Steps by the bar's width in rem. Each threshold is the measured width of what that step
     shows (brand, buttons, gaps), plus a little room. */
  @container hbar (min-width: 17rem) {
    .brand :global(.brand-logo) { height: 1.5rem; }
    .brand-sub { font-size: 0.8125rem; letter-spacing: 0.06em; }
    .phone { min-width: 3rem; min-height: 3rem; }
    .menu summary { width: 3rem; height: 3rem; }
  }
  @container hbar (min-width: 19.5rem) {
    .brand :global(.brand-logo) { height: 1.75rem; }
    .brand-sub { letter-spacing: 0.17em; }
    .actions { gap: 0.5rem; }
  }
  @container hbar (min-width: 28.75rem) { .phone { padding: 0 0.85rem; } .phone-num { display: inline; } }
  @container hbar (min-width: 38.75rem) { .book { display: inline-flex; } }
  @container hbar (min-width: 73rem) {
    .nav { display: block; }
    .actions { margin-left: 0.5rem; }
    .menu { display: none; }
  }
  @media (min-width: 560px) { .est { display: inline; } }
</style>
