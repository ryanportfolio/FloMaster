---
import Icon from "./Icon.astro";
import Fact from "./Fact.astro";
import { facts } from "../data/facts";
interface Props { title?: string }
const { title = "Need a plumber?" } = Astro.props;
---
<section class="cta">
  <div class="wrap cta-grid">
    <div>
      <h2>{title}</h2>
      <p class="lead">Call, book online, or leave your number and I'll call you back <Fact k="callback" />.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn--signal" href={`tel:${facts.phoneHref.value}`}><Icon name="phone" /> Call {facts.phone.value}</a>
      <a class="btn btn--navy" href="/book"><Icon name="calendar" /> Book a time</a>
      <a class="btn btn--ghost" href="/book#callback"><Icon name="text" /> Ask for a callback</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-5); background: var(--sky-100); border-top: 1px solid #c9e0ef; }
  .cta-grid { display: grid; gap: var(--space-3); align-items: center; }
  @media (min-width: 900px) { .cta-grid { grid-template-columns: 1fr auto; } }
  .cta h2 { margin-bottom: 0.4rem; }
  .cta .lead { margin: 0; color: var(--ink-soft); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .cta .btn--ghost { color: var(--navy); }
</style>
