---
// Navy page header for inner pages. Pages that put Call and Book in their first
// screen pass `actions` so the mobile sticky bar waits until they scroll away.
import Icon from "./Icon.astro";
import { facts } from "../data/facts";
interface Props { title: string; lead?: string; crumb?: { href: string; label: string }; actions?: boolean; emergency?: boolean }
const { title, lead, crumb, actions = false, emergency = false } = Astro.props;
---
<section class="page-hero navy on-navy">
  <div class="wrap">
    {crumb && <p class="crumb"><a href={crumb.href}>{crumb.label}</a></p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
    {actions && (
      <div class="ph-actions" data-hero-actions>
        <a class={`btn ${emergency ? "btn--signal" : "btn--ghost"}`} href={`tel:${facts.phoneHref.value}`}><Icon name="phone" /> Call {facts.phone.value}</a>
        {!emergency && <a class="btn btn--primary" href="/book"><Icon name="calendar" /> Book a time</a>}
        {emergency && <a class="btn btn--ghost" href="/book#callback"><Icon name="text" /> Ask for a callback</a>}
      </div>
    )}
  </div>
</section>

<style>
  .page-hero { padding-block: 2.5rem 3rem; }
  @media (min-width: 900px) { .page-hero { padding-block: 3rem 3.25rem; } }
  .page-hero h1 { max-width: 22ch; font-size: var(--step-4); }
  .page-hero .lead { color: var(--sky-100); max-width: 58ch; }
  .crumb { margin: 0 0 0.75rem; font-size: 0.9375rem; }
  .crumb a { color: var(--sky-300); }
  .ph-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .ph-actions .btn--ghost { color: var(--white); }
</style>
