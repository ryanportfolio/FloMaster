  .xr-note-t { margin-top: 0.25rem !important; font-size: var(--step--1); line-height: 1.4; color: var(--sky-100); }
  .xr-note-price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 0.75rem; margin-top: 0.45rem !important; padding-top: 0.45rem; border-top: 1px dashed rgb(169 210 234 / 0.45); font-size: var(--step--1); }
  .xr-note-price strong { font: 700 1.375rem/1.2 var(--font-slab); color: var(--white); white-space: nowrap; }
  .xr-note-sub { margin-top: 0.15rem !important; font-size: 0.9375rem; line-height: 1.35; color: var(--sky-300); }
  .xr-show {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.5rem 1rem; border-radius: var(--radius);
    border: 2px solid var(--sky-300); background: transparent; color: var(--white); font: 700 1rem/1.2 var(--font-body); cursor: pointer;
