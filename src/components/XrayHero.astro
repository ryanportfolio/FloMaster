---
// The home page hero image: a plumbing problem in a home with an X-ray lens over it.
// Press or drag anywhere on the photo and the lens goes there; over the fault it
// reads "Found it" with the price for that job. On load the lens finds the fault on
// its own, then every few seconds moves off, the next scene fades in and the lens
// finds that one (five scenes, one per service, in a loop). The visitor moving the
// lens stops the loop on the scene shown.
// Reduced motion: the same, per the site's rule that its motion plays as designed.
// The X-ray layer loads after the photo; each next scene loads while the one before it is shown.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Fact from "./Fact.astro";
import sinkPhoto from "../assets/photos/story-1-problem.jpg";
import sinkRay from "../assets/photos/story-2-xray.jpg";
import heaterPhoto from "../assets/photos/xray-heater.jpg";
import heaterRay from "../assets/photos/xray-heater-ray.jpg";
import toiletPhoto from "../assets/photos/xray-toilet.jpg";
import toiletRay from "../assets/photos/xray-toilet-ray.jpg";
import tubPhoto from "../assets/photos/xray-tub.jpg";
import tubRay from "../assets/photos/xray-tub-ray.jpg";
import sewerPhoto from "../assets/photos/xray-sewer.jpg";
import sewerRay from "../assets/photos/xray-sewer-ray.jpg";
import { isPublicBuild, photoFacts } from "../data/facts";
import { services } from "../data/services";

interface Props { class?: string }
const { class: cls } = Astro.props;

const widths = [480, 760, 1080, 1440];
const sizes = "(min-width: 900px) 70vw, 100vw";

// One scene per service. `at`: where the fault is in the photo, as fractions of its width and
// height. The price shown is the posted range for that kind of job (P17), not a quote. `q`: WebP
// quality where the default 70 costs too many bytes (the lawn's fine detail). The first scene is
// the one on screen at load.
type SceneSrc = { photo: ImageMetadata; ray: ImageMetadata; at: [number, number]; svc: string; job: number; q?: number; found: string; label: string };
const list: SceneSrc[] = [
  { photo: sewerPhoto, ray: sewerRay, at: [0.52, 0.79], svc: "sewer-lines", job: 1, q: 50,
    found: "Tree roots grew into the sewer line through a joint, right under the soggy patch.",
    label: "A back yard with a soggy patch of lawn between a tree and the house. A round X-ray lens, drawn as an illustration, shows the sewer pipe under the grass, where roots growing into a joint glow orange." },
  { photo: sinkPhoto, ray: sinkRay, at: [0.395, 0.615], svc: "leaks-and-pipes", job: 0,
    found: "The steel trap rusted out at the bend. That's where the drip comes from.",
    label: "A leaking kitchen sink cabinet: a rusted steel drain trap drips onto a stained cabinet floor. A round X-ray lens, drawn as an illustration, shows the pipes inside, and the rusted bend at the bottom of the trap glows orange where the water gets out." },
  { photo: heaterPhoto, ray: heaterRay, at: [0.54, 0.58], svc: "water-heaters", job: 0,
    found: "The drain valve at the bottom of the tank is corroded and leaking. Sediment has built up behind it.",
    label: "A water heater in a garage with a puddle spreading from its corroded drain valve. A round X-ray lens, drawn as an illustration, shows inside the tank, where the worn valve glows orange." },
  { photo: toiletPhoto, ray: toiletRay, at: [0.34, 0.42], svc: "fixtures", job: 0,
    found: "The wax ring under the toilet has failed. Water seeps out at the base every flush.",
    label: "A toilet on a tile floor with a water stain around its base. A round X-ray lens, drawn as an illustration, shows under the floor, where the broken wax ring glows orange." },
  { photo: tubPhoto, ray: tubRay, at: [0.36, 0.79], svc: "drains", job: 0,
    found: "Hair and soap packed into the trap under the tub. That's why the water sits.",
    label: "A bathtub holding standing grey water that will not drain. A round X-ray lens, drawn as an illustration, shows the pipes under the tub, where a clog in the trap glows orange." },
];
const scenes = await Promise.all(list.map(async (s, i) => {
  const job = services.find((x) => x.slug === s.svc)!.prices[s.job];
  const ray = await getImage({ src: s.ray, widths, sizes, format: "webp", quality: s.q ?? 70 });
  const photo = i ? await getImage({ src: s.photo, widths, sizes, format: "webp", quality: s.q ?? 70 }) : null;
  return {
    ...s, job,
    say: `Found it: ${s.found} ${job.job}, ${job.range}, typical range.`,
    data: { photo: photo?.srcSet.attribute ?? "", ray: ray.srcSet.attribute, at: s.at, label: s.label, say: `Found it: ${s.found} ${job.job}, ${job.range}, typical range.` },
  };
}));
// Every scene's photo and X-ray share one size, so the lens maps the same way on each.
const first = list[0];
for (const s of scenes) if (s.photo.width !== first.ray.width || s.photo.height !== first.ray.height || s.ray.width !== first.ray.width || s.ray.height !== first.ray.height) throw new Error(`XrayHero: scene images must be ${first.ray.width}x${first.ray.height}`);
---
<div class:list={["xr", cls]} data-xray data-scenes={JSON.stringify(scenes.map((s) => s.data))} data-iw={first.ray.width} data-ih={first.ray.height} data-ray-sizes={sizes}>
  <div class="xr-stage" data-xray-stage role="img" aria-label={scenes[0].label}>
    <Image src={first.photo} alt="" class="xr-photo" widths={widths} sizes={sizes} format="webp" quality={first.q ?? 70} loading="eager" fetchpriority="high" decoding="sync" draggable="false" />
    <span class="xr-shade"></span>
    <span class="xr-lens" data-xray-lens></span>
    <span class="xr-mark" data-xray-mark></span>
    <span class="xr-ring" data-xray-ring><span class="xr-ring-on"></span></span>
    {!isPublicBuild && <span class="photo-tag">Replace with real photos · {photoFacts.beforeAfter.code}: AI stand-ins now</span>}
  </div>
  <!-- Keyboard: a button that shows only while it has keyboard focus, so the find can be reached
       without a pointer (the automatic find skips short or zoomed screens). -->
  <button class="xr-key" type="button" data-xray-key hidden>Show the problem</button>
  <!-- The reading card: one note per scene, the current one shown once the lens is on the fault.
       All share one grid cell and keep their space while hidden, so showing one moves nothing. -->
  <div class="xr-read" data-xray-card>
    {scenes.map((s, i) => (
      <div class:list={["xr-note", { "is-on": i === 0 }]} data-xray-note>
        <p class="xr-note-k">Found it</p>
        <p class="xr-note-t">{s.found}</p>
        <p class="xr-note-price"><span class="xr-note-job">{s.job.job}</span> <strong class="num"><Fact k="priceRanges" text={s.job.range} /></strong></p>
        <p class="xr-note-sub">Typical range. Your exact price is in writing before I start.</p>
      </div>
    ))}
  </div>
  <p class="visually-hidden" role="status" data-xray-live></p>
  <!-- Without JavaScript the lens cannot move: show the finding and its price.
       Ignored entirely when scripts run, so it changes nothing on the normal page. -->
  <noscript><style is:inline>.xr-note.is-on { visibility: visible; } .xr-stage { cursor: auto; }</style></noscript>
</div>

<script>
  type P = [number, number];
  type Box = { l: number; t: number; r: number; b: number };
  type Scene = { photo: string; ray: string; at: P; label: string; say: string };
  const KEY = "fm-xray-found"; // set when the find starts (or the visitor moves the lens); scripts/check-reveal.mjs reads it
  const SLOP = 6; // px of horizontal travel before a touch drag takes over
  const TAP = 10; // a touch that ends within this many px of where it started is a tap
  const GLIDE = 1800; // ms, a find
  const HOLD = 4500; // ms on each found fault before the next scene
  const AWAY = 900; // ms, the lens moving off the fault before the scene changes
  const FADE = 600; // ms, the cross-fade to the next scene (matches .xr-photo's transition)
  const deskQuery = matchMedia("(min-width: 900px)");
  let stored = false; // written once per page: a drag's first move does no storage work after that
  const remember = () => { if (stored) return; stored = true; try { sessionStorage.setItem(KEY, "1"); } catch {} };
  const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Catmull-Rom through the points at e (0..1 over the whole path): no corners at the turns.
  const curve = (path: P[], e: number): P => {
    const n = path.length - 1;
    const k = Math.min(n - 1e-9, e * n), i = Math.floor(k), f = k - i;
    // Past either end, mirror the neighbour, so the curve leaves the start and meets the end at full
    // tangent (repeating the end point would halve it and make the start drag on top of the easing).
    const at = (j: number): P => j < 0 ? [2 * path[0][0] - path[1][0], 2 * path[0][1] - path[1][1]]
      : j > n ? [2 * path[n][0] - path[n - 1][0], 2 * path[n][1] - path[n - 1][1]] : path[j];
    const [a, b, c, d] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
    const cr = (p0: number, p1: number, p2: number, p3: number) =>
      0.5 * (2 * p1 + (p2 - p0) * f + (2 * p0 - 5 * p1 + 4 * p2 - p3) * f * f + (3 * p1 - p0 - 3 * p2 + p3) * f * f * f);
    return [cr(a[0], b[0], c[0], d[0]), cr(a[1], b[1], c[1], d[1])];
  };

  document.querySelectorAll<HTMLElement>("[data-xray]").forEach((root) => {
    const stage = root.querySelector<HTMLElement>("[data-xray-stage]")!;
    const photo = stage.querySelector<HTMLImageElement>(".xr-photo")!;
    const lens = root.querySelector<HTMLElement>("[data-xray-lens]")!;
    const ring = root.querySelector<HTMLElement>("[data-xray-ring]")!;
    const mark = root.querySelector<HTMLElement>("[data-xray-mark]")!;
    const live = root.querySelector<HTMLElement>("[data-xray-live]")!;
    const notes = Array.from(root.querySelectorAll<HTMLElement>("[data-xray-note]"));
    const hero = root.closest<HTMLElement>(".hero");
    const copy = hero?.querySelector<HTMLElement>(".hero-copy") ?? null;
    const header = document.querySelector<HTMLElement>(".site-header");
    const bar = document.querySelector<HTMLElement>("[data-sticky]");
    const scenes: Scene[] = JSON.parse(root.dataset.scenes!);
    const IW = Number(root.dataset.iw), IH = Number(root.dataset.ih);
    let si = 0; // the scene shown
    let [LU, LV] = scenes[0].at;
    let note = notes[0];

    // The X-ray picture, inside the lens. Created here so it never competes with the photo.
    const makeRay = (srcset: string) => {
      const img = new Image();
      img.className = "xr-ray";
      img.alt = "";
      img.draggable = false;
      img.decoding = "async";
      img.sizes = root.dataset.raySizes!;
      img.srcset = srcset;
      return img;
    };
    let ray = makeRay(scenes[0].ray);
    // The photo is drawn twice, one copy over the other, so a scene change is a cross-fade.
    const firstSet = photo.srcset; // the first scene's photo, which has no srcset of its own in the data
    const shots = [photo, photo.cloneNode() as HTMLImageElement];
    shots[1].removeAttribute("fetchpriority");
    shots[1].decoding = "async";
    shots[1].classList.add("is-out");
    let shown = 0;

    // Layout, in stage pixels: the photo is drawn with object-fit: cover at the stage's
    // --xr-x / --xr-y object position, so (u, v) in the photo maps to (ox + u*dw, oy + v*dh).
    let W = 0, H = 0, R = 0, dw = 0, dh = 0, ox = 0, oy = 0;
    let u = LU, v = LV; // lens centre in photo fractions
    let ready = false;
    let found = false;
    let touched = false; // the visitor moved the lens; the scenes stop changing after that
    let anim = 0;
    let finding = false; // a find is gliding
    let timer = 0;

    const measure = () => {
      W = stage.clientWidth;
      H = stage.clientHeight;
      const cs = getComputedStyle(stage);
      const px = parseFloat(cs.getPropertyValue("--xr-x")) / 100;
      const py = parseFloat(cs.getPropertyValue("--xr-y")) / 100;
      const s = Math.max(W / IW, H / IH);
      dw = IW * s; dh = IH * s;
      ox = (W - dw) * px; oy = (H - dh) * py;
      // The size keys on the layout: wide screens put the photo beside the copy, phones under it.
      const desk = deskQuery.matches;
      // Phones held sideways leave a short band between the sticky header and the bottom Call/Book
      // bar (about 204 px at 844x390): the lens also stays under 0.36 of that band, so it fits on
      // screen and the find can play. Portrait phones are not affected (their band is far taller).
      let band = Infinity;
      if (!desk) {
        const barH = bar && getComputedStyle(bar).display !== "none" ? bar.offsetHeight : 0;
        band = innerHeight - (header ? header.offsetHeight : 0) - barH;
      }
      R = Math.round(clamp(Math.min(Math.min(W, H) * (desk ? 0.19 : 0.3), band * 0.36), desk ? 96 : 64, desk ? 160 : 110));
      root.style.setProperty("--r", `${R}px`);
      ray.style.width = `${dw}px`;
      ray.style.height = `${dh}px`;
      mark.style.transform = `translate3d(${ox + LU * dw}px, ${oy + LV * dh}px, 0)`;
    };
    const toPx = ([a, b]: P): P => [ox + a * dw, oy + b * dh];
    const toUV = ([x, y]: P): P => [(x - ox) / dw, (y - oy) / dh];

    // Tell screen readers what the lens found (cleared first, so a repeat is read again).
    const announce = () => { live.textContent = ""; requestAnimationFrame(() => { live.textContent = scenes[si].say; }); };
    // "visitor": found by the visitor's hand, so say it. "quiet": a find on its own, or a layout change.
    type How = "visitor" | "quiet";
    const setFound = (f: boolean, how: How) => {
      if (f === found) return;
      found = f;
      root.classList.toggle("is-found", f);
      if (f && how === "visitor") announce();
    };

    // Draw the lens at (u, v). Transforms only, each written once, so a move costs no layout.
    const place = (how: How) => {
      if (!ready) return;
      const x = ox + u * dw, y = oy + v * dh;
      const t = `translate3d(${x - R}px, ${y - R}px, 0)`;
      lens.style.transform = t;
      ring.style.transform = t;
      ray.style.transform = `translate3d(${ox + R - x}px, ${oy + R - y}px, 0)`;
      const d = Math.hypot(x - (ox + LU * dw), y - (oy + LV * dh));
      // Enter close in, leave further out, so the state never flickers at the edge.
      setFound(found ? d < R * 0.6 : d < R * 0.35, how);
    };

    // Keep the lens centre on the visible part of the photo.
    // A press before the X-ray is ready measures first, so the point maps onto the photo.
    const setXY = (x: number, y: number) => {
      if (!dw) measure();
      if (!dw) return;
      [u, v] = toUV([clamp(x, 0, W), clamp(y, 0, H)]);
    };

    let rest: P = [LU, LV];
    let restHow: How = "quiet";
    const stopAnim = () => { cancelAnimationFrame(anim); anim = 0; finding = false; };
    const settle = () => { if (anim) { stopAnim(); [u, v] = rest; place(restHow); } };

    // Move the lens along a smooth curve through the given points (photo fractions), eased in and out.
    // `keep` runs before each frame; `done` runs once the lens arrives (not when the glide is settled early).
    const glide = (pts: P[], ms: number, how: How, keep?: () => boolean, done?: () => void) => {
      stopAnim();
      const path: P[] = [[u, v], ...pts];
      rest = path[path.length - 1];
      restHow = how;
      let t0 = -1;
      const tick = (now: number) => {
        if (keep && !keep()) return;
        if (t0 < 0) t0 = now; // the curve starts on the first frame
        const t = Math.min(1, (now - t0) / ms);
        [u, v] = curve(path, 0.5 - Math.cos(Math.PI * t) / 2);
        if (t === 1) [u, v] = rest;
        place(how);
        if (t < 1) { anim = requestAnimationFrame(tick); return; }
        anim = 0;
        finding = false;
        done?.();
      };
      anim = requestAnimationFrame(tick);
    };

    // ---- Finding the fault on its own ------------------------------------------------------

    // The part of the screen not covered by the sticky header or the phone's bottom Call/Book bar.
    // Where the lens may go on its own (stage px): R + 8 inside the photo; on wide screens also
    // fully on screen and 16 px clear of the copy and the business card (ring plus
    // its 9 px ticks). The note shows only near the fault, so it counts only there.
    const room = () => {
      const s = stage.getBoundingClientRect();
      const desk = deskQuery.matches;
      const boxOf = (el: Element | null): Box | null => {
        if (!el) return null;
        const q = el.getBoundingClientRect();
        return q.width && q.height ? { l: q.left - s.left, t: q.top - s.top, r: q.right - s.left, b: q.bottom - s.top } : null;
      };
      const obs: Box[] = [];
      let noteBox: Box | null = null;
      if (desk) {
        for (const el of [...(copy ? Array.from(copy.children) : []), hero?.querySelector(".hero-card") ?? null]) { const b = boxOf(el); if (b) obs.push(b); }
        noteBox = boxOf(note);
      }
      const m = R + 8;
      const top = desk ? Math.max(0, (header ? header.getBoundingClientRect().bottom : 0) - s.top) : 0;
      const y0 = Math.max(m, top + m);
      const y1 = desk ? Math.min(H - m, innerHeight - s.top - 16 - R) : H - m;
      const clear = R + 9 + 16;
      const [lx, ly] = toPx([LU, LV]);
      const gap = (x: number, y: number, o: Box) => Math.hypot(x - clamp(x, o.l, o.r), y - clamp(y, o.t, o.b));
      return (x: number, y: number) => x >= m && x <= W - m && y >= y0 && y <= y1
        && obs.every((o) => gap(x, y, o) >= clear)
        && (!noteBox || Math.hypot(x - lx, y - ly) > R * 0.6 || gap(x, y, noteBox) >= clear);
    };
    // Where a find starts (stage px), away from the fault at `at`. Phone: top right, the top of the
    // ring in the peek at the fold. Wide screens: the top right of the free part of the photo, far
    // enough from the fault that it is outside the lens there (so the find reads as a search), or
    // failing that the farthest point.
    const startPose = (at: P = [LU, LV]): P => {
      if (!deskQuery.matches) return [W * 0.68, R + 6];
      const ok = room();
      const [lx, ly] = toPx(at);
      let best: P | null = null, score = -Infinity, far: P | null = null, farD = -1;
      for (let y = 0; y <= H; y += 6) for (let x = 0; x <= W; x += 6) {
        if (!ok(x, y)) continue;
        const d = Math.hypot(x - lx, y - ly);
        if (d > farD) { farD = d; far = [x, y]; }
        if (d >= R * 1.35 && x - 0.5 * y > score) { score = x - 0.5 * y; best = [x, y]; }
      }
      return best ?? far ?? [lx, ly];
    };
    // Between scenes: the point farthest from the next fault (at) that the lens may go to on its
    // own, so each scene's search starts from a different side.
    const awayPose = (at: P): P => {
      const m = R + 8;
      const ok = deskQuery.matches ? room() : (x: number, y: number) => x >= m && x <= W - m && y >= m && y <= H - m;
      const [lx, ly] = toPx(at);
      let far: P | null = null, farD = -1;
      for (let y = 0; y <= H; y += 6) for (let x = 0; x <= W; x += 6) {
        if (!ok(x, y)) continue;
        const d = Math.hypot(x - lx, y - ly);
        if (d > farD) { farD = d; far = [x, y]; }
      }
      return far ?? startPose(at);
    };
    // Two waypoints from the lens to the fault, a gentle S where there is room for one, so that every
    // point of the curve stays in the free part of the photo (the ends are allowed a little slack).
    const route = (): P[] => {
      const A = toPx([u, v]), L = toPx([LU, LV]);
      const dx = L[0] - A[0], dy = L[1] - A[1], len = Math.hypot(dx, dy);
      const line = (f: number, off: number): P => [A[0] + dx * f - (dy / (len || 1)) * off, A[1] + dy * f + (dx / (len || 1)) * off];
      const ok = room();
      for (const amp of [0.2, -0.2, 0.12, -0.12, 0.06, -0.06, 0]) {
        const pts: P[] = [A, line(1 / 3, amp * len), line(2 / 3, -amp * len), L];
        let fits = true;
        for (let i = 4; i <= 96 && fits; i++) { const [x, y] = curve(pts, i / 100); fits = ok(x, y); }
        if (fits) return pts.slice(1).map(toUV);
      }
      return [line(1 / 3, 0), line(2 / 3, 0), L].map(toUV);
    };

    // ---- The scenes ------------------------------------------------------------------------

    const cycling = () => scenes.length > 1 && !touched && !document.hidden;
    const stopCycle = () => { clearTimeout(timer); timer = 0; };
    // The next scene's photo and X-ray, decoded ahead so the change never waits on the network.
    const loaded = new Map<number, Promise<HTMLImageElement>>();
    const preload = (i: number) => {
      if (!loaded.has(i)) {
        const img = makeRay(scenes[i].ray);
        const pic = new Image();
        pic.sizes = photo.sizes;
        pic.srcset = scenes[i].photo || firstSet;
        loaded.set(i, Promise.all([img.decode(), pic.decode()]).then(() => img));
      }
      return loaded.get(i)!;
    };
    // Show scene i: cross-fade the photo, put its X-ray in the lens, its note in the card.
    const useScene = (i: number, nextRay: HTMLImageElement) => {
      si = i;
      [LU, LV] = scenes[i].at;
      const inc = shots[1 - shown], out = shots[shown];
      inc.srcset = scenes[i].photo || firstSet;
      // The copy later in the page draws on top: fade it in, or fade it out over the other.
      if (inc === shots[1]) inc.classList.remove("is-out");
      else { inc.classList.remove("is-out"); out.classList.add("is-out"); }
      shown = 1 - shown;
      lens.replaceChild(nextRay, ray);
      ray = nextRay;
      notes.forEach((n, k) => n.classList.toggle("is-on", k === i));
      note = notes[i];
      stage.setAttribute("aria-label", scenes[i].label);
      measure();
      place("quiet");
    };
    // A find from where the lens is to the fault of the scene shown.
    const find = () => {
      if (touched) return;
      let frames = 0;
      glide(route(), GLIDE, "quiet", () => {
        // Marked once the lens first moves (frame 2; frame 1 draws the start).
        if (++frames === 2) remember();
        return true;
      }, held);
      finding = true;
    };
    // On the fault: wait, then move off, change scene and find the next one.
    const held = () => {
      stopCycle();
      if (!cycling()) return;
      const next = (si + 1) % scenes.length;
      preload(next);
      timer = window.setTimeout(() => {
        timer = 0;
        if (!cycling()) return;
        glide([toUV(awayPose(scenes[next].at))], AWAY, "quiet", undefined, async () => {
          const img = await preload(next).catch(() => null);
          if (!img || !cycling()) return;
          useScene(next, img);
          await wait(FADE);
          if (cycling()) find();
        });
      }, HOLD);
    };
    // Carry on from wherever the loop stopped.
    const resume = () => { if (!cycling() || anim || timer) return; if (found) held(); else find(); };

    document.addEventListener("visibilitychange", () => { if (document.hidden) stopCycle(); else resume(); });

    // ---- Pointer and keyboard -------------------------------------------------------------

    // The stage's screen box, read at pointerdown (and on scroll during a press), never per move.
    let box: DOMRect | null = null;
    const xyOf = (e: PointerEvent): P => {
      const r = box ?? (box = stage.getBoundingClientRect());
      return [e.clientX - r.left, e.clientY - r.top];
    };
    const moveTo = (e: PointerEvent) => { const [x, y] = xyOf(e); setXY(x, y); place("visitor"); };
    // The visitor takes over: the scenes stop changing.
    const claim = () => { stopCycle(); if (touched && !anim) return; touched = true; stopAnim(); remember(); };
    // The keyboard button: the lens glides to the fault and the finding is read out.
    const key = root.querySelector<HTMLButtonElement>("[data-xray-key]")!;
    key.addEventListener("click", () => {
      claim();
      if (found) { announce(); return; }
      glide([[LU, LV]], 900, "visitor");
    });

    // Mouse and pen move the lens on press; a touch waits until it is a horizontal drag (so
    // vertical swipes scroll the page and leave the lens and the find alone) or a tap.
    let id: number | null = null;
    let dragging = false;
    let sx = 0, sy = 0;
    const press = (e: PointerEvent) => {
      box = stage.getBoundingClientRect();
      id = e.pointerId; sx = e.clientX; sy = e.clientY;
      dragging = true;
      e.preventDefault();
      moveTo(e);
      claim();
      try { stage.setPointerCapture(e.pointerId); } catch {}
      root.classList.add("is-dragging");
    };
    stage.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || id !== null) return;
      if (e.pointerType !== "touch") { press(e); return; }
      box = stage.getBoundingClientRect();
      id = e.pointerId; sx = e.clientX; sy = e.clientY;
      dragging = false;
    });
    stage.addEventListener("pointermove", (e) => {
      if (e.pointerId !== id) return;
      if (!dragging) {
        const dx = Math.abs(e.clientX - sx);
        if (dx < SLOP || dx < Math.abs(e.clientY - sy)) return;
        dragging = true;
        moveTo(e); // the lens first; the rest after, so the first move stays light
        claim();
        root.classList.add("is-dragging");
        return;
      }
      moveTo(e);
    });
    const reset = () => { id = null; dragging = false; root.classList.remove("is-dragging"); };
    // Leaving the page mid-press (back button, a link) ends the drag, so a page restored from the
    // back/forward cache does not come back still dragging.
    addEventListener("pagehide", () => {
      if (id !== null) { try { stage.releasePointerCapture(id); } catch {} }
      reset();
    });
    addEventListener("pageshow", (e) => { if (e.persisted) reset(); });
    const end = (e: PointerEvent) => {
      if (e.pointerId !== id) return;
      // A touch that never became a drag or a scroll is a tap: move the lens there.
      if (!dragging && e.type === "pointerup" && Math.hypot(e.clientX - sx, e.clientY - sy) < TAP) { moveTo(e); claim(); }
      reset();
    };
    stage.addEventListener("pointerup", end);
    stage.addEventListener("pointercancel", end);
    stage.addEventListener("lostpointercapture", end);
    stage.addEventListener("dragstart", (e) => e.preventDefault());
    // A scroll or a viewport change moves the stage: drop the cached box (read again now if a press is on).
    const rebox = () => { box = id !== null ? stage.getBoundingClientRect() : null; };
    addEventListener("scroll", rebox, { passive: true });
    addEventListener("resize", rebox);

    // Wide screens: a press in blank space of the copy column, where the photo shows through,
    // moves the lens too. Links, buttons, tags and text itself keep their own behaviour
    // (a press on a letter still starts a text selection).
    const onGlyph = (x: number, y: number) => {
      const d = document as Document & { caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null };
      let node: Node | null = null, off = 0;
      if (d.caretPositionFromPoint) { const cp = d.caretPositionFromPoint(x, y); if (cp) { node = cp.offsetNode; off = cp.offset; } }
      else if (document.caretRangeFromPoint) { const rg = document.caretRangeFromPoint(x, y); if (rg) { node = rg.startContainer; off = rg.startOffset; } }
      if (!node || node.nodeType !== Node.TEXT_NODE) return false;
      const len = (node as Text).length;
      const rg = document.createRange();
      for (const o of [off - 1, off]) {
        if (o < 0 || o >= len) continue;
        rg.setStart(node, o); rg.setEnd(node, o + 1);
        for (const r of Array.from(rg.getClientRects())) if (x >= r.left - 2 && x <= r.right + 2 && y >= r.top - 2 && y <= r.bottom + 2) return true;
      }
      return false;
    };
    if (hero && copy) hero.addEventListener("pointerdown", (e) => {
      if (!deskQuery.matches || e.button !== 0 || e.pointerType === "touch" || id !== null) return;
      const t = e.target as Element;
      if (!copy.contains(t) || t.closest("a, button, input, select, textarea, label, img, [tabindex], [data-open]")) return;
      const s = stage.getBoundingClientRect();
      if (e.clientX < s.left || e.clientX > s.right || e.clientY < s.top || e.clientY > s.bottom) return;
      if (onGlyph(e.clientX, e.clientY)) return;
      press(e);
    });

    // A layout change mid-glide ends it where it was going; otherwise the lens keeps its place on
    // the photo. Before the X-ray is ready the lens has no size (begin() measures), so it never sits
    // at the stage's corner, even unseen.
    new ResizeObserver(() => {
      box = null;
      if (!ready) return;
      const pw = W, ph = H;
      measure();
      if (anim && (pw !== W || ph !== H)) { settle(); stopCycle(); if (found) held(); }
      place("quiet");
    }).observe(stage);

    const begin = () => {
      ready = true;
      lens.append(ray);
      photo.after(shots[1]);
      measure();
      if (!touched) [u, v] = toUV(startPose());
      place(touched ? "visitor" : "quiet");
      // The lens appears in one frame; state changes animate only from the next frames on.
      root.classList.add("is-ready");
      key.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add("is-anim")));
      if (touched) return;
      // Start the find only once the page load reveal has brought the photo fully in (2.5 s at most).
      const settled = (window as unknown as { fmReveal?: { settled: Promise<void> } }).fmReveal?.settled;
      Promise.race([settled, new Promise((r) => setTimeout(r, 2500))]).then(find);
    };

    // Load the X-ray only after the photo, so it never slows the first screen.
    const loadRay = () => {
      // If the X-ray never arrives, show the finding as text, as with no script.
      ray.decode().then(begin, () => { root.classList.add("is-noray"); });
    };
    if (photo.complete) loadRay();
    else { photo.addEventListener("load", loadRay, { once: true }); photo.addEventListener("error", loadRay, { once: true }); }
  });
</script>

<style is:global>
  /* --r (lens radius, px) is set by the script. --xr-x / --xr-y place the photo in its frame;
     the script reads them, so change them only here, as plain percentages. */
  .xr { position: relative; }
  .xr-key { position: absolute; top: 1rem; left: 1rem; z-index: 6; padding: 0.6rem 1rem; border: 2px solid var(--white); border-radius: var(--radius); background: var(--navy-900); color: var(--white); font: 700 1rem/1.2 var(--font-slab); cursor: pointer; }
  .xr-key:not(:focus-visible) { clip-path: inset(50%); width: 1px; height: 1px; padding: 0; border: 0; overflow: hidden; white-space: nowrap; }
  .xr-stage {
    --xr-x: 50%; --xr-y: 50%;
    position: relative; overflow: hidden; aspect-ratio: 4 / 3; background: var(--navy-900);
    cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
  }
  .xr.is-dragging .xr-stage { cursor: grabbing; }
  .xr-stage .xr-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--xr-x) var(--xr-y); pointer-events: none; -webkit-user-drag: none; transition: opacity 0.6s ease; }
  .xr-stage .xr-photo.is-out { opacity: 0; }
  .xr-shade { display: none; }

  /* The lens: a round window onto the X-ray, moved with transforms only. It appears in one
     frame once the X-ray is ready (nothing fades in on the first screen). */
  .xr-lens, .xr-ring { position: absolute; left: 0; top: 0; width: calc(var(--r, 0px) * 2); height: calc(var(--r, 0px) * 2); border-radius: 50%; pointer-events: none; opacity: 0; will-change: transform; }
  .xr.is-ready .xr-lens, .xr.is-ready .xr-ring { opacity: 1; }
  .xr-lens { overflow: hidden; background: var(--navy-900); }
  .xr-ray { position: absolute; left: 0; top: 0; max-width: none; will-change: transform; pointer-events: none; -webkit-user-drag: none; }
  .xr-ring { box-shadow: 0 0 0 2px rgb(228 241 249 / 0.95), 0 0 0 6px rgb(12 27 48 / 0.35), 0 14px 34px rgb(6 14 26 / 0.5), inset 0 0 26px rgb(106 174 214 / 0.4); }
  /* Four short ticks at the edge of the lens, like a sight. */
  .xr-ring::before, .xr-ring::after { content: ""; position: absolute; background-repeat: no-repeat; }
  .xr-ring::before { left: calc(50% - 1px); top: -9px; bottom: -9px; width: 2px; background-image: linear-gradient(rgb(228 241 249 / 0.95) 0 15px, transparent 15px calc(100% - 15px), rgb(228 241 249 / 0.95) calc(100% - 15px)); }
  .xr-ring::after { top: calc(50% - 1px); left: -9px; right: -9px; height: 2px; background-image: linear-gradient(90deg, rgb(228 241 249 / 0.95) 0 15px, transparent 15px calc(100% - 15px), rgb(228 241 249 / 0.95) calc(100% - 15px)); }
  /* Found: a brighter rim and glow on a layer of its own that fades in, so the change never
     repaints the ring while it moves (a box-shadow transition would, every frame). */
  .xr-ring-on {
    position: absolute; inset: 0; border-radius: 50%; opacity: 0; will-change: opacity;
    box-shadow: 0 0 0 3px var(--white), 0 0 0 7px rgb(12 27 48 / 0.4), 0 0 30px 4px rgb(106 174 214 / 0.55), inset 0 0 26px rgb(106 174 214 / 0.45);
  }
  .xr.is-found .xr-ring-on { opacity: 1; }

  /* A dashed ring on the leak itself, shown once the lens is over it. It fades in place. */
  .xr-mark {
    position: absolute; left: 0; top: 0; width: calc(var(--r, 0px) * 0.62); height: calc(var(--r, 0px) * 0.62);
    margin: calc(var(--r, 0px) * -0.31) 0 0 calc(var(--r, 0px) * -0.31);
    border: 2px dashed rgb(255 255 255 / 0.95); border-radius: 50%; pointer-events: none; opacity: 0; will-change: opacity;
  }
  .xr.is-found .xr-mark { opacity: 1; }
  /* State changes after the first frames: the ring brightens, the mark fades. */
  .xr.is-anim .xr-ring-on { transition: opacity 0.2s ease; }
  .xr.is-anim .xr-mark { transition: opacity 0.18s ease; }

  /* The reading card: the note. Phones: under the photo. Wide screens: in the photo's top right
     corner. Hidden, it takes no presses, so they reach the photo under it. */
  .xr-read { display: grid; padding: 0.5rem 1.25rem 0; color: var(--white); pointer-events: none; }
  .xr-read > * { grid-area: 1 / 1; min-width: 0; pointer-events: auto; }
  .xr-note { visibility: hidden; }
  .xr.is-found .xr-note.is-on { visibility: visible; }
  .xr.is-noray .xr-note.is-on { visibility: visible; }
  .xr.is-noray .xr-stage { cursor: auto; }
  .xr-note p { margin: 0; max-width: none; text-wrap: pretty; }
  /* Two short lines, never a word or two alone on the last one. */
  .xr-note .xr-note-sub { text-wrap: balance; }
  .xr-note-k { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.6rem; font: 700 1.25rem/1.2 var(--font-slab); color: var(--white); }
  .xr-note-t { margin-top: 0.25rem !important; font-size: var(--step--1); line-height: 1.4; color: var(--sky-100); }
  .xr-note-price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 0.75rem; margin-top: 0.45rem !important; padding-top: 0.45rem; border-top: 1px dashed rgb(169 210 234 / 0.45); font-size: var(--step--1); }
  .xr-note-price strong { font: 700 1.375rem/1.2 var(--font-slab); color: var(--white); white-space: nowrap; }
  .xr-note-sub { margin-top: 0.15rem !important; font-size: 0.9375rem; line-height: 1.35; color: var(--sky-300); }
  /* Phones: a compact note, price on one line. */
  @media (max-width: 899px) {
    /* Phones: the X-ray paints above the business card below it (z-index 3 in index.astro), though
       they never overlap on screen. Painted after the lens instead, the card had to move to a
       compositor layer of its own whenever the lens's layer box reached it and back when the lens
       left; the first time it moved back, drawing the tilted card cost a 55 to 65 ms GPU stall
       on the next frame. */
    .xr { z-index: 4; }
    .xr-note-price { flex-wrap: nowrap; gap: 0.5rem; }
    .xr-note-job { font-size: 0.9375rem; }
    .xr-note-price strong { font-size: 1.25rem; }
  }

  @media (min-width: 900px) {
    .xr { position: absolute; inset: 0; }
    .xr-stage { --xr-x: 0%; --xr-y: 50%; position: absolute; inset: 0; aspect-ratio: auto; }
    /* Darkens the photo behind the copy; the lens sits above it. */
    .xr-shade { display: block; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--navy) 0%, rgb(27 53 86 / 0.92) 22%, rgb(27 53 86 / 0.55) 38%, rgb(27 53 86 / 0) 58%); }
    .xr-read { position: absolute; top: 1.75rem; right: 1.75rem; width: min(21rem, 46%); padding: 0; align-items: start; }
    .xr-note {
      padding: 0.9rem 1.1rem 1rem; border-radius: var(--radius-lg); background: rgb(12 27 48 / 0.92);
      box-shadow: inset 0 0 0 1px rgb(169 210 234 / 0.4), var(--shadow-3);
    }
  }
  /* 900 to 1199 px: the copy column is narrower, so the photo shifts left to keep the leak
     between the copy and the photo's right edge. */
  @media (min-width: 900px) and (max-width: 1099px) { .xr-stage { --xr-x: 13%; } }
  @media (min-width: 1100px) and (max-width: 1199px) { .xr-stage { --xr-x: 10%; } }
</style>
