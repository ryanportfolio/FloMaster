---
// A photo slot. In the prototype every photo is an AI-generated stand-in and
// carries a "replace with a real photo" tag (brief section 12, decision 2).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { photoFacts, isPublicBuild } from "../data/facts";
interface Props {
  src: ImageMetadata;
  alt: string;
  fact: keyof typeof photoFacts;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  shot?: string;
}
const { src, alt, fact, widths = [480, 768, 1080, 1536], sizes = "(min-width: 1180px) 560px, 100vw", priority = false, class: cls = "", shot } = Astro.props;
const pf = photoFacts[fact];
---
<figure class:list={["photo", cls]}>
  <Image
    src={src}
    alt={alt}
    widths={widths.filter((w) => w <= src.width)}
    sizes={sizes}
    format="webp"
    quality={72}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding={priority ? "sync" : "async"}
  />
  {!isPublicBuild && <span class="photo-tag">Replace with a real photo · {pf.code}{shot ? `: ${shot}` : ""}</span>}
</figure>
<style>
  .photo { position: relative; margin: 0; overflow: hidden; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
