---
// A home-page review card led by one line pulled from the review, large, with the whole review
// under it, then the stars and who, where and when. The pulled line is an exact excerpt (the
// review's `pull`), so it is hidden from screen readers, which read the whole review once.
import Icon from "./Icon.astro";
import { type Review, shortDate, longDate } from "../data/reviews";
import { facts } from "../data/facts";
interface Props { review: Review }
const { review } = Astro.props;
---
<article class="rp">
  <header class="rp-head">
    <span class="rp-co">{facts.name.value.replace(/ Plumbing and Drains$/, "")}</span>
    <span class="sample-label">Sample review</span>
  </header>
  {review.pull && <p class="rp-pull" aria-hidden="true">{review.pull}</p>}
  <blockquote class="rp-text"><p>{review.text}</p></blockquote>
  <span class="rp-stars" role="img" aria-label="5 out of 5 stars">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span>
  <dl class="rp-meta">
    <div><dt>Customer</dt><dd class="rp-name">{review.name}</dd></div>
    <div><dt>City</dt><dd>{review.city}</dd></div>
    <div><dt>Date</dt><dd><time datetime={review.date} title={longDate(review.date)}>{shortDate(review.date)}</time></dd></div>
    <div class="rp-svc"><dt>Service</dt><dd><span class="rp-chip">{review.service}</span></dd></div>
  </dl>
</article>

<style>
  .rp { position: relative; display: flex; flex-direction: column; padding: 1.25rem 1.4rem 1.4rem; border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--ring), var(--shadow-2); }
  .rp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--line); }
  .rp-co { font: 700 0.75rem/1.3 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate-ink); }
  .rp-head .sample-label { flex: none; }
  .rp-pull { margin: 1.1rem 0 0.9rem; padding-left: 0.45em; text-indent: -0.45em; font: 800 clamp(1.5rem, 1.2rem + 1vw, 1.875rem)/1.15 var(--font-slab); color: var(--navy-900); text-wrap: balance; }
  .rp-pull::before { content: "\201C"; }
  .rp-pull::after { content: "\201D"; }
  .rp-text { margin: 0 0 1rem; color: var(--ink-soft); }
  .rp-text p { margin: 0; }
  .rp-stars { display: inline-flex; gap: 2px; margin-top: auto; padding-top: 0.9rem; border-top: 1px solid var(--line); color: #e3a008; }
  .rp-stars :global(svg) { width: 1.3rem; height: 1.3rem; }
  .rp-meta { display: flex; flex-wrap: wrap; gap: 0.7rem 1.4rem; margin: 0.8rem 0 0; }
  .rp-svc { flex-basis: 100%; }
  .rp-meta dt { font: 700 0.75rem/1.3 var(--font-body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate-ink); }
  .rp-meta dd { margin: 0.15rem 0 0; font-size: var(--step--1); color: var(--ink); white-space: nowrap; }
  .rp-meta .rp-name { font-family: var(--font-slab); font-weight: 700; color: var(--navy-900); }
  .rp-chip { display: inline-block; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--sky-100); color: var(--navy-900); font-weight: 600; }
</style>
