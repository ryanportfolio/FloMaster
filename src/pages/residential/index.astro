---
import Base from "../../layouts/Base.astro";
import WorkOrderHero from "../../components/WorkOrderHero.astro";
import WorkOrderSlip from "../../components/WorkOrderSlip.astro";
import Photo from "../../components/Photo.astro";
import CallToAction from "../../components/CallToAction.astro";
import Icon from "../../components/Icon.astro";
import Fact from "../../components/Fact.astro";
import { services } from "../../data/services";
import { facts } from "../../data/facts";
---
<Base title="Home plumbing services and prices" description="Drain clearing, water heaters, leak and pipe repair, fixtures and sewer lines for homes across Hampton Roads, with typical prices for every job.">
  <WorkOrderHero title="Home plumbing, with the prices up front" lead="Typical price ranges for the jobs I do most, and a written, flat price for your job before I start" actions>
    <WorkOrderSlip title="On every home job" id="wo-home" form="title">
      <ol class="steps" role="list">
        <li><span class="st-n" aria-hidden="true">1</span><p>I come out <span class="visually-hidden">for</span><b class="st-big num"><Fact k="calloutFee" /></b></p></li>
        <li><span class="st-n" aria-hidden="true">2</span><p>You get a <mark><Fact k="pricingModel" text="flat price" /></mark> in writing, before I start</p></li>
        <li><span class="st-n" aria-hidden="true">3</span><p>Go ahead and the <mark><Fact k="calloutCredited"><span class="num">{facts.calloutFee.value}</span> comes off</Fact></mark></p></li>
      </ol>
      <p class="warranty"><Fact k="laborWarranty"><b>1-year</b> labor warranty on the work</Fact></p>
    </WorkOrderSlip>
  </WorkOrderHero>
  <section class="section">
    <div class="wrap list">
      {services.map((s, i) => (
        <article class:list={["row", { flip: i % 2 }]}>
          <Photo src={s.photo} alt={s.photoAlt} fact="jobs" widths={[480, 768, 1080]} sizes="(min-width: 900px) 520px, 100vw" class="row-photo" shot={s.shot} />
          <div>
            <h2><a href={`/residential/${s.slug}`}>{s.title}</a></h2>
            <p>{s.intro}</p>
            <table class="mini">
              <caption class="visually-hidden">Typical prices for {s.title.toLowerCase()}</caption>
              <tbody>{s.prices.map((p) => <tr><th scope="row">{p.job}</th><td class="num"><Fact k="priceRanges" text={p.range} /></td></tr>)}</tbody>
            </table>
            <a class="more" href={`/residential/${s.slug}`}>{s.title}: what's covered and what changes the price <Icon name="arrow" class="i-arrow" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CallToAction />
</Base>

<style>
  /* The home work order: the three steps of a job on a pipe down the left, then the guarantee. */
  .steps { position: relative; list-style: none; margin: 0.35rem 0 0.75rem; padding: 0; }
  .steps::before { content: ""; position: absolute; left: calc(1.2rem - 3px); top: 1.2rem; bottom: 1.2rem; width: 6px; border-radius: 3px; background: var(--slate); }
  .steps li { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: 0.85rem; align-items: center; }
  .steps li > p { padding: 0.7rem 0; }
  .steps li + li > p { border-top: 1px solid var(--line); }
  .st-n { position: relative; z-index: 1; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--sky-100); border: 3px solid var(--slate); box-shadow: 0 0 0 3px var(--white); font: 800 1.125rem/1 var(--font-slab); color: var(--navy-900); }
  .steps p { margin: 0; font: 600 var(--step-0)/1.35 var(--font-slab); color: var(--navy-900); }
  .st-big { display: inline-block; margin-left: 0.4rem; font: 800 var(--step-3)/1 var(--font-slab); letter-spacing: -0.02em; vertical-align: -0.12em; }
  .steps mark { white-space: nowrap; padding: 0.05em 0.3em; border-radius: 6px; background: var(--sky-100); color: var(--navy-900); font-weight: 800; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .warranty { margin: 0 -0.35rem 0.4rem; padding: 0.7rem 1rem; border-radius: var(--radius); background: var(--navy-900); color: var(--white); font: 600 var(--step-0)/1.3 var(--font-body); text-align: center; }
  .warranty b { font: 800 var(--step-1)/1 var(--font-slab); margin-right: 0.3rem; }
  .list { display: grid; gap: var(--space-5); }
  .row { display: grid; gap: var(--space-3); align-items: center; }
  @media (min-width: 900px) {
    .row { grid-template-columns: 520px 1fr; gap: var(--space-4); }
    .row.flip > :first-child { order: 2; }
  }
  .row :global(.row-photo) { border-radius: var(--radius-lg); aspect-ratio: 3 / 2; }
  h2 a { text-decoration: none; color: inherit; }
  h2 a:hover { text-decoration: underline; }
  .mini { border-collapse: collapse; width: 100%; max-width: 34rem; margin: 0.5rem 0 1rem; }
  .mini th, .mini td { padding: 0.55rem 0; border-bottom: 1px solid var(--line); text-align: left; font-size: 1.0625rem; }
  .mini th { font-weight: 500; }
  .mini td { text-align: right; font-family: var(--font-slab); font-weight: 700; color: var(--navy); white-space: nowrap; padding-left: 1rem; }
  .more { font-weight: 600; }

</style>
