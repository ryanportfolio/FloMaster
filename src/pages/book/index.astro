---
// Booking page. Four questions, each marked with the logo ring and answered on its own tag:
// question 1's price tag, question 2's arrival board, stamped tags for the address and the
// phone. The header's work order fills in as the questions are answered. The cost summary
// hangs each charge on the point in the visit where it applies, and comes before the
// "Book this time" button on a phone. Booking details reach /book/confirmed through session
// storage only.
import Base from "../../layouts/Base.astro";
import Fact from "../../components/Fact.astro";
import Icon from "../../components/Icon.astro";
import WorkOrderCard from "../../components/book/WorkOrderCard.astro";
import StepMark from "../../components/book/StepMark.astro";
import StepProblem from "../../components/book/StepProblem.astro";
import StepWhen from "../../components/book/StepWhen.astro";
import VTag from "../../components/book/VTag.astro";
import CostTags from "../../components/book/CostTags.astro";
import CallbackHull from "../../components/book/CallbackHull.astro";
import { problems } from "../../components/book/problems";
import { facts, isPublicBuild } from "../../data/facts";
import { zips, sometimes } from "../../data/area";

const priceMap = Object.fromEntries(problems.map((p) => [p.slug, p.prices]));
---
<Base title="Book a time" description="Book a FloMasters plumbing visit online in four quick steps. Antonio confirms by text.">
  <div class="bp" data-bp data-count="0">
    <section class="book-head navy on-navy">
      <div class="wrap bh">
        <div class="bh-intro">
          <h1>Book a time</h1>
          <p class="lead"><span class="lead-wo">Each answer goes straight onto your work order. </span>Once you book, <Fact k="bookingConfirm" text={facts.bookingConfirm.value.replace(/\.$/, "")} /></p>
        </div>
        <WorkOrderCard />
      </div>
    </section>

    <section class="section form-sec">
      <div class="wrap">
        <form class="bookform" data-book novalidate method="post" action="/book" data-zips={JSON.stringify(zips)} data-sometimes={JSON.stringify(sometimes)} data-prices={JSON.stringify(priceMap)} data-price-open={String(!isPublicBuild && facts.priceRanges.status === "open")}>
          <p class="error-summary" role="alert" data-summary></p>

          <div class="qs">
            <StepProblem />
            <StepWhen />

            <fieldset class="step" id="f-where" data-step="where">
              <legend><StepMark n={3} /> <span class="lg-t">Where is the job?<span class="visually-hidden" data-state></span></span></legend>
              <div class="addr">
                <div class="field">
                  <label for="street">Street address</label>
                  <input id="street" name="street" type="text" autocomplete="address-line1" aria-describedby="err-street" />
                  <span class="error" id="err-street"></span>
                </div>
                <div class="field zip">
                  <label for="zip">ZIP code</label>
                  <input id="zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="5" aria-describedby="zip-status err-zip" />
                  <span class="error" id="err-zip"></span>
                </div>
              </div>
              <p class="zip-status small" id="zip-status" role="status" data-zip-status></p>
              <p class="ans-slot"><VTag ans="where-short" /></p>
            </fieldset>

            <fieldset class="step" id="f-phone" data-step="phone">
              <legend><StepMark n={4} /> <span class="lg-t">Your mobile number<span class="visually-hidden" data-state></span></span></legend>
              <div class="field">
                <label for="phone" class="visually-hidden">Mobile number</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="phone-hint err-phone" data-carry-phone />
                <span class="hint" id="phone-hint">For the confirmation and "on my way" texts about this visit only. <Fact k="textConsent" /></span>
                <span class="error" id="err-phone"></span>
              </div>
              <p class="ans-slot"><VTag ans="phone" caps /></p>
            </fieldset>
          </div>

          <aside class="side" aria-label="Costs, and what to do in an emergency">
            <CostTags />
            <div class="panel urgent">
              <p><strong>Water leaking now?</strong> Don't book: call.</p>
              <a class="btn btn--signal btn--block" href={`tel:${facts.phoneHref.value}`}><Icon name="phone" /> {facts.phone.value}</a>
            </div>
          </aside>

          <div class="go">
            <button class="btn btn--navy submit" type="submit" data-submit disabled data-needs-js>Book this time</button>
            <p class="small muted after">Prototype: nothing is sent. You'll see the confirmation screen.</p>
          </div>
        </form>
      </div>
    </section>

    <CallbackHull />
  </div>
</Base>

<script>
  import { answerTexts, fillAnswers, type Booking } from "../../components/book/fmt";
  type Row = { job: string; range: string };
  const bp = document.querySelector<HTMLElement>("[data-bp]")!;
  const form = document.querySelector<HTMLFormElement>("[data-book]")!;
  const zips: Record<string, string> = JSON.parse(form.dataset.zips!);
  const sometimes: string[] = JSON.parse(form.dataset.sometimes!);
  const prices: Record<string, Row[]> = JSON.parse(form.dataset.prices!);
  const $ = <T extends Element = HTMLElement>(s: string) => form.querySelector<T>(s)!;
  const zipStatus = $("[data-zip-status]");
  const summary = $("[data-summary]");
  const jobStatus = $("[data-job-status]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name=${name}]:checked`);
  let tried = false;

  // Pre-select a job from ?job=<service slug> (service page "Book" buttons).
  const pre = new URLSearchParams(location.search).get("job");
  if (pre) { const r = form.querySelector<HTMLInputElement>(`input[name=job][value="${CSS.escape(pre)}"]`); if (r) r.checked = true; }
  // Carry the phone number between the booking and callback forms (WCAG 3.3.7).
  try { const saved = sessionStorage.getItem("fm-phone"); if (saved) $<HTMLInputElement>("#phone").value = saved; } catch {}
  $<HTMLInputElement>("#phone").addEventListener("input", (e) => { try { sessionStorage.setItem("fm-phone", (e.target as HTMLInputElement).value); } catch {} });

  // Question 1's price tag shows through CSS; this announces it and scrolls as much of it into view
  // as fits without moving the chosen problem (and its focus) under the sticky header.
  const onJob = (scroll: boolean) => {
    const job = checked("job");
    jobStatus.textContent = job?.dataset.say ?? "";
    const tag = job && document.getElementById(job.getAttribute("aria-controls") ?? "");
    if (scroll && tag) requestAnimationFrame(() => {
      const head = document.querySelector(".site-header")?.getBoundingClientRect().bottom ?? 0;
      const bar = document.querySelector<HTMLElement>("[data-sticky]");
      const bottom = bar && !bar.classList.contains("is-waiting") && getComputedStyle(bar).display !== "none" ? bar.getBoundingClientRect().top : innerHeight;
      const over = tag.getBoundingClientRect().bottom - bottom + 8;
      const room = (job.closest("label") ?? job).getBoundingClientRect().top - head - 8;
      if (over > 0 && room > 0) scrollBy({ top: Math.min(over, room), behavior: reduce.matches ? "auto" : "smooth" });
    });
  };

  const zipCheck = () => {
    const z = $<HTMLInputElement>("#zip").value.trim();
    if (!/^\d{5}$/.test(z)) { zipStatus.textContent = ""; return null; }
    const city = zips[z];
    zipStatus.className = `zip-status small ${city ? "ok" : "no"}`;
    zipStatus.textContent = !city ? "That ZIP is outside my area. Call me and I'll tell you if I can help." : sometimes.includes(z) ? `${city}: I'll confirm I can reach you when I text.` : `${city}: yes, I cover that.`;
    return city ?? null;
  };

  // The booking as answered so far. A question counts as answered once its answer would pass
  // validation (an address needs a covered ZIP; a phone needs 10 digits).
  const current = () => {
    const job = checked("job"), win = checked("window");
    const street = $<HTMLInputElement>("#street").value.trim();
    const zip = $<HTMLInputElement>("#zip").value.trim();
    const phone = $<HTMLInputElement>("#phone").value.trim();
    const note = $<HTMLInputElement>("#other-note").value.trim();
    const city = /^\d{5}$/.test(zip) ? zips[zip] ?? null : null;
    const digits = phone.replace(/\D/g, "").replace(/^1(?=\d{10}$)/, "");
    const done = { job: !!job, when: !!win, where: street.length > 3 && !!city, phone: digits.length === 10 };
    const b: Booking = {
      job: job ? (job.value === "other" && note ? note : job.dataset.label) : undefined,
      jobId: job?.value,
      window: win?.value, windowDay: win?.dataset.dayLabel, windowLabel: win?.dataset.winLabel, windowDate: win?.dataset.date,
      windowStart: win ? Number(win.dataset.start) : undefined, windowEnd: win ? Number(win.dataset.end) : undefined,
      afterHours: win ? win.dataset.weekend === "true" : undefined,
      street: done.where ? street : undefined, zip: done.where ? zip : undefined, city,
      phone: done.phone ? phone : undefined,
    };
    return { b, done, city, job, win };
  };

  // Writes the progress onto the page: data-<question> and data-count on the wrapper, data-done
  // on each answered question, the answer texts, and the state the cost summary reads.
  const progress = () => {
    const { b, done, city, job, win } = current();
    let n = 0;
    for (const [k, ok] of Object.entries(done)) {
      bp.toggleAttribute(`data-${k}`, ok);
      const step = form.querySelector<HTMLElement>(`[data-step="${k}"]`)!;
      step.toggleAttribute("data-done", ok);
      step.querySelector("[data-state]")!.textContent = ok ? " (answered)" : "";
      if (ok) n++;
    }
    bp.dataset.count = String(n);
    document.querySelectorAll("[data-count-text]").forEach((el) => { el.textContent = `${n} of 4 filled in`; });
    fillAnswers(document, answerTexts(b));
    const detail = {
      job: job ? { title: job.dataset.title ?? "", rows: prices[job.value] ?? null } : null,
      priceOpen: form.dataset.priceOpen === "true",
      win: win ? { label: `${win.dataset.dayLabel}, ${win.dataset.winLabel}`, weekend: win.dataset.weekend === "true" } : null,
      city,
    };
    (window as unknown as { __fmBook: typeof detail }).__fmBook = detail;
    document.dispatchEvent(new CustomEvent("fm:book", { detail }));
  };

  const setErr = (id: string, msg: string, field?: Element | null) => {
    document.getElementById(id)!.textContent = msg;
    if (field) msg ? field.setAttribute("aria-invalid", "true") : field.removeAttribute("aria-invalid");
    return !msg;
  };
  // The windows of the days not chosen are hidden, so an error sends focus to the first one shown.
  const firstWindow = () => [...form.querySelectorAll<HTMLInputElement>("input[name=window]")].find((i) => i.offsetParent !== null) ?? form.querySelector<HTMLElement>("input[name=window]")!;
  const validate = (focus: boolean) => {
    const job = checked("job"), win = checked("window");
    const street = $<HTMLInputElement>("#street"), zip = $<HTMLInputElement>("#zip"), phone = $<HTMLInputElement>("#phone");
    const digits = phone.value.replace(/\D/g, "").replace(/^1(?=\d{10}$)/, "");
    const checks: [boolean, HTMLElement][] = [
      [setErr("err-job", job ? "" : "Pick the problem closest to yours, or Something else."), form.querySelector<HTMLElement>("input[name=job]")!],
      [setErr("err-when", win ? "" : "Pick an arrival window, or ask for a callback below."), firstWindow()],
      [setErr("err-street", street.value.trim().length > 3 ? "" : "Enter the street address where the job is.", street), street],
      [setErr("err-zip", /^\d{5}$/.test(zip.value.trim()) ? (zipCheck() ? "" : "I don't cover that ZIP online. Please call so we can talk about it.") : "Enter a 5-digit ZIP code.", zip), zip],
      [setErr("err-phone", digits.length === 10 ? "" : "Enter a 10-digit mobile number so I can text you the confirmation.", phone), phone],
    ];
    const bad = checks.filter(([ok]) => !ok);
    summary.textContent = bad.length && focus ? `${bad.length === 1 ? "One thing needs" : `${bad.length} things need`} fixing before I can book this.` : "";
    if (bad.length && focus) bad[0][1].focus();
    return bad.length === 0;
  };

  form.addEventListener("change", (e) => { if ((e.target as HTMLInputElement).name === "job") onJob(true); progress(); if (tried) validate(false); });
  form.addEventListener("input", () => { progress(); if (tried) validate(false); });
  // The callback form below copies its phone number into this form without an input event here.
  document.addEventListener("input", (e) => {
    const t = e.target as Element;
    if (t.matches?.("[data-carry-phone]") && !form.contains(t)) queueMicrotask(() => { progress(); if (tried) validate(false); });
  });
  $("#zip").addEventListener("input", zipCheck);
  onJob(false);
  progress();

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    tried = true;
    if (!validate(true)) return;
    const btn = $<HTMLButtonElement>("[data-submit]");
    const { b } = current();
    // Session storage only: no personal details in the URL. If the browser refuses it, the
    // confirmation would show an older booking or the sample, so stay here and say so.
    try { sessionStorage.setItem("fm-booking", JSON.stringify({ ...b, city: zipCheck() })); }
    catch {
      summary.textContent = "This browser wouldn't let the page keep your booking, so the confirmation can't show it. Please call to book.";
      return;
    }
    btn.disabled = true;
    btn.textContent = "Booking...";
    setTimeout(() => { location.href = "/book/confirmed"; }, 500);
  });
</script>

<style>
  /* Header: the intro beside the work order; on a phone the order follows the intro, kept short
     so question 1 starts on the first screen. */
  .book-head { padding-block: 1rem 1.25rem; }
  .bh { display: grid; gap: 0.85rem; align-items: center; }
  .bh h1 { margin: 0 0 0.25rem; font-size: var(--step-3); }
  .bh .lead { margin: 0; color: var(--sky-100); font-size: var(--step-0); line-height: 1.45; }
  /* On a phone the order itself shows what it is for; the first line goes so question 1 starts sooner. */
  @media (max-width: 699px) { .lead-wo { display: none; } }
  @media (min-width: 900px) {
    .book-head { padding-block: 2rem 2.25rem; }
    .bh { grid-template-columns: minmax(0, 1fr) minmax(0, 34rem); gap: 3rem; }
  }

  .form-sec { padding-block: 1.25rem var(--space-5); }
  @media (min-width: 700px) { .form-sec { padding-top: var(--space-4); } }

  /* Questions, then costs, then the button. On wide screens the costs sit beside the questions. */
  .bookform { display: grid; gap: 0 var(--space-4); }
  .bookform > * { min-width: 0; }
  @media (min-width: 1000px) {
    .bookform { grid-template-columns: minmax(0, 1fr) 24rem; align-items: start; }
    .error-summary, .qs, .go { grid-column: 1; }
    .error-summary { grid-row: 1; }
    .qs { grid-row: 2; }
    .go { grid-row: 3; }
    .side { grid-column: 2; grid-row: 1 / 4; }
  }
  .side { display: grid; gap: 1rem; margin-bottom: 1.5rem; }
  .urgent { border-top: 5px solid var(--signal); }
  .urgent p { margin-bottom: 0.75rem; }

  /* The questions. Each is a white card; the marker is the logo ring with the question number. */
  .bookform :global(.step) { position: relative; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.25rem 1.25rem 0.75rem; margin-bottom: 1rem; }
  @media (min-width: 700px) { .bookform :global(.step) { padding: 1.5rem 1.75rem 1rem; } }
  .bookform :global(legend) { float: left; width: 100%; font-family: var(--font-slab); font-size: var(--step-1); font-weight: 700; color: var(--navy-900); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem; }
  .bookform :global(legend + *) { clear: both; }
  .bookform :global(.step .error) { margin: 0.5rem 0; }
  .bookform :global(.step .hint) { margin-bottom: 0.75rem; }
  .bookform :global(.tagwrap) { font-family: var(--font-body); font-size: 0.875rem; font-weight: 400; }
  .addr { display: grid; gap: 0 1rem; }
  @media (min-width: 640px) { .addr { grid-template-columns: 1fr 9rem; } }
  .addr .field { margin-bottom: 0.75rem; }
  .zip-status { min-height: 1.6em; margin: 0 0 0.75rem; font-weight: 600; }
  .zip-status.ok { color: var(--ok); }
  .zip-status.no { color: #b42318; }
  /* Stamped answer tags for questions 3 and 4 sit under the answer, so nothing moves above the
     finger and a long address never runs into the question's heading. */
  .ans-slot { margin: 0.25rem 0 0.75rem; max-width: none; }
  .ans-slot:has(:global(.vtag:empty)) { display: none; }

  .submit { width: 100%; min-height: 3.75rem; font-size: 1.25rem; margin-top: 0.5rem; }
  @media (min-width: 700px) { .submit { width: auto; padding-inline: 2.5rem; } }
  .after { margin-top: 0.75rem; }
  .error-summary { margin: 0 0 1rem; font-weight: 700; color: #b42318; }
  .error-summary:empty { display: none; }
</style>
