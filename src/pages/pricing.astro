---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import FeeTable from "../components/FeeTable.astro";
import Fact from "../components/Fact.astro";
import FactBlock from "../components/FactBlock.astro";
import CallToAction from "../components/CallToAction.astro";
import { services } from "../data/services";
import { facts } from "../data/facts";
---
<Base title="Prices, fees and guarantee" description="Every fee FloMasters charges, typical prices for common plumbing jobs, how quotes work, and the written guarantee.">
  <PageHero title="Prices, fees and guarantee" lead="Everything I charge is on this page. If it isn't listed, I don't charge it." />

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>Fees</h2>
        <FeeTable />
      </div>
      <div class="how panel">
        <h2>How I charge</h2>
        <p><Fact k="pricingModel" /></p>
        <h3>How I quote</h3>
        <FactBlock k="quoting"><ol class="quote-steps">
          <li><strong>I look first.</strong> I find the cause before I name a price.</li>
          <li><strong>You get the price in writing</strong> before any work starts, with repair and replacement options side by side when there's a choice.</li>
          <li><strong>Repair first.</strong> I only recommend replacing something when a repair won't last.</li>
          <li><strong>No surprises mid-job.</strong> If I find something new, I stop and show you before the price changes.</li>
          <li><strong>Pay when it's done.</strong> <Fact k="payment" />. No cash-only jobs, no full payment up front.</li>
        </ol></FactBlock>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2>Typical prices</h2>
      <p class="lead">Ranges for the jobs I do most. Your written price depends on what I find; the notes say what moves a job up the range.</p>
      <div class="price-grid">
        {services.map((s) => (
          <section class="pg">
            <h3><a href={`/residential/${s.slug}`}>{s.title}</a></h3>
            <table>
              <caption class="visually-hidden">{s.title}</caption>
              <tbody>{s.prices.map((p) => <tr><th scope="row">{p.job}</th><td class="num"><Fact k="priceRanges" text={p.range} /></td></tr>)}</tbody>
            </table>
            <p class="small muted">Top of the range: {s.topOfRange}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="guarantee">
    <div class="wrap guarantee">
      <div class="g-seal" aria-hidden="true">
        <span>Written</span><strong>Guarantee</strong><span>FloMasters</span>
      </div>
      <div>
        <h2>My guarantee</h2>
        <ul class="ticks">
          <li><strong><Fact k="laborWarranty" />.</strong> If my work fails, I come back and fix it at no charge.</li>
          <li><strong>Parts:</strong> <Fact k="partsWarranty" />.</li>
          <li><strong>Not covered:</strong> <Fact k="warrantyExclusions" />.</li>
          <li><strong>To claim it:</strong> call or text {facts.phone.value}. The date and job are on your invoice; you don't need to keep anything else.</li>
        </ul>
        <p class="small muted">The full terms are printed on every invoice.</p>
      </div>
    </div>
  </section>
  <CallToAction />
</Base>

<style>
  .two { display: grid; gap: var(--space-4); }
  @media (min-width: 1000px) { .two { grid-template-columns: 1.3fr 1fr; align-items: start; } }
  .how { border-top: 5px solid var(--sky); }
  .how h3 { margin-top: 1.5rem; }
  .quote-steps { padding-left: 1.3rem; margin: 0 0 1rem; }
  .quote-steps li { margin-bottom: 0.7rem; padding-left: 0.3rem; }
  .quote-steps li::marker { font-family: var(--font-slab); font-weight: 700; color: var(--slate); }
  .price-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); margin-top: var(--space-3); }
  .pg { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.25rem 1.4rem; }
  .pg h3 a { color: inherit; text-decoration: none; }
  .pg h3 a:hover { text-decoration: underline; }
  .pg table { width: 100%; border-collapse: collapse; margin-bottom: 0.75rem; }
  .pg th, .pg td { text-align: left; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: 0.975rem; vertical-align: top; }
  .pg th { font-weight: 500; padding-right: 0.75rem; }
  .pg td { text-align: right; font-family: var(--font-slab); font-weight: 700; color: var(--navy); white-space: nowrap; }
  .guarantee { display: grid; gap: var(--space-4); align-items: center; }
  @media (min-width: 800px) { .guarantee { grid-template-columns: 14rem 1fr; } }
  .g-seal { width: 13rem; aspect-ratio: 1; border-radius: 50%; display: grid; place-content: center; text-align: center; gap: 0.2rem; color: var(--white); background: var(--navy) var(--waves); background-size: 60px 30px; box-shadow: 0 0 0 6px var(--paper), 0 0 0 9px var(--sky); font-family: var(--font-slab); }
  .g-seal span { font-size: 0.8125rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--sky-300); }
  .g-seal strong { font-size: 1.5rem; }
</style>
