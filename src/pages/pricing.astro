---
import Base from "../layouts/Base.astro";
import ValveTagHero from "../components/ValveTagHero.astro";
import ValveStamp from "../components/ValveStamp.astro";
import ValveTagQuote from "../components/ValveTagQuote.astro";
import Fact from "../components/Fact.astro";
import CallToAction from "../components/CallToAction.astro";
import { services } from "../data/services";
import { facts } from "../data/facts";
import { pricingTags, markOf, lowestPrice } from "../components/valve-tags";
// The row the "Typical prices from" header tag lands on: the lowest price in services.ts.
const isLowest = (slug: string, i: number) => slug === lowestPrice.slug && i === lowestPrice.i;
// "$1,650 to $2,400" -> [1650, 2400]. Each bar runs from $0 to the job's top price, so the filled
// part shows how far the price can move from the low end.
const ends = (range: string) => (range.match(/[\d,]+/g) ?? []).map((n) => Number(n.replace(/,/g, "")));
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(1)}%`;
// One line icon per service, in the card's navy.
const icons: Record<string, string> = {
  drains: "M7 3v8a5 5 0 0 0 10 0V8h4",
  "water-heaters": "M8 3h8a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm1 18v1m6-1v1M12 9.5c-1.2 1.4-1.8 2.4-1.8 3.2a1.8 1.8 0 0 0 3.6 0c0-.8-.6-1.8-1.8-3.2Z",
  "leaks-and-pipes": "M2 8h8M14 8h8M10 6h4v4h-4zM12 13c-1 1.3-1.5 2.2-1.5 2.9a1.5 1.5 0 0 0 3 0c0-.7-.5-1.6-1.5-2.9Z",
  fixtures: "M3 9h8a4 4 0 0 1 4 4v2M7 5v4M5 5h4M15 18c-.8 1-1.2 1.7-1.2 2.2a1.2 1.2 0 0 0 2.4 0c0-.5-.4-1.2-1.2-2.2Z",
  "sewer-lines": "M3 7h12v10H3zM15 10l6-3v10l-6-3",
};
---
<Base title="Prices, fees and guarantee" description="Every fee FloMasters charges, typical prices for common plumbing jobs, how quotes work, and the written guarantee.">
  <ValveTagHero title="Prices, fees and guarantee" lead="Every fee I charge, listed" tags={pricingTags} call cols={3} />

  <ValveTagQuote />

  <section class="section section--alt" id="typical-prices">
    <div class="wrap">
      <h2>Typical prices</h2>
      <p class="lead">Your written price depends on what I find</p>
      <div class="price-grid">
        {services.map((s) => (
          <section class="pg">
            <div class="pg-h">
              <svg class="pg-i" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[s.slug]} /></svg>
              <h3><a href={`/residential/${s.slug}`}>{s.title}</a></h3>
            </div>
            <ul class="pg-rows" role="list">{s.prices.map((p, i) => {
              const low = isLowest(s.slug, i);
              const [a, b] = ends(p.range);
              return (
                <li class:list={["pg-row", { "vt-target": low }]} id={low ? "tag-typical" : undefined} tabindex={low ? "-1" : undefined}>
                  <span class="pg-job">{low && <ValveStamp mark={markOf(pricingTags, "tag-typical")} />}{p.job}</span>
                  <span class="pg-price num"><Fact k="priceRanges" text={p.range} /></span>
                  <span class="pg-bar" aria-hidden="true" style={`--a: ${pct(a, b)}; --b: 100%`}></span>
                </li>
              );
            })}</ul>
            <p class="pg-more">Costs more if</p>
            <ul class="pg-tags" role="list">{s.topTags.map((t) => <li>{t}</li>)}</ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="guarantee">
    <div class="wrap guarantee">
      <div class="g-seal" aria-hidden="true">
        <span>Written</span><strong>Guarantee</strong><span>FloMasters</span>
      </div>
      <div>
        <h2>My guarantee</h2>
        <ul class="ticks">
          <li class="vt-target" id="tag-guarantee" tabindex="-1"><ValveStamp mark={markOf(pricingTags, "tag-guarantee")} /><strong><Fact k="laborWarranty" />.</strong> If my work fails, I fix it free.</li>
          <li><strong>Parts:</strong> <Fact k="partsWarranty" />.</li>
          <li><strong>Not covered:</strong> <Fact k="warrantyExclusions" />.</li>
          <li><strong>To claim:</strong> call or text <span class="nowrap">{facts.phone.value}</span>. Your invoice is all you need.</li>
        </ul>
        <p class="small muted">Full terms on every invoice</p>
      </div>
    </div>
  </section>
  <CallToAction />
</Base>

<style>
  .price-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); margin-top: var(--space-3); }
  /* Each card: an icon and the service, then each job with its range as a bar from $0 to its top
     price, then what pushes a job to the top of its range, as tags. */
  .pg { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-1); padding: 1.25rem 1.4rem 1.4rem; }
  .pg-h { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.4rem; }
  .pg-i { width: 2.25rem; height: 2.25rem; flex: none; fill: none; stroke: var(--navy); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .pg h3 { margin: 0; }
  .pg h3 a { color: inherit; text-decoration: none; }
  .pg h3 a:hover { text-decoration: underline; }
  .pg-rows { list-style: none; margin: 0 0 1rem; padding: 0; }
  /* A little room at the row ends, so a header tag's outline (drawn inside the row) clears the text. */
  .pg-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.15rem 0.75rem; align-items: baseline; padding: 0.6rem 0.4rem 0.7rem; border-bottom: 1px solid var(--line); }
  .pg-job { font-size: 1.0625rem; line-height: 1.35; }
  .pg-price { font: 700 1.0625rem/1.35 var(--font-slab); color: var(--navy-900); white-space: nowrap; text-align: right; }
  .pg-bar { grid-column: 1 / -1; position: relative; height: 6px; margin-top: 0.45rem; border-radius: 3px; background: var(--sky-100); }
  .pg-bar::before { content: ""; position: absolute; left: var(--a); right: calc(100% - var(--b)); top: 0; bottom: 0; border-radius: 3px; background: var(--sky); }
  .pg-bar::after { content: ""; position: absolute; top: 50%; left: var(--a); width: calc(var(--b) - var(--a)); height: 12px; translate: 0 -50%; border-inline: 3px solid var(--navy); box-sizing: border-box; border-radius: 2px; }
  :global(.vt-target:target) .pg-bar { background: var(--white); }
  .pg-more { margin: 0 0 0.4rem; font: 700 var(--step--2)/1.3 var(--font-body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .pg-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .pg-tags li { padding: 0.25rem 0.65rem; border-radius: 999px; background: var(--sky-100); color: var(--navy-900); font-size: var(--step--1); line-height: 1.3; }
  /* The guarantee line a header tag names wears that tag's letter in place of its tick. */
  .guarantee .ticks li.vt-target::before { display: none; }
  .guarantee .ticks li.vt-target > :global(.vt-stamp) { position: absolute; left: -0.3rem; top: 0.15em; margin: 0; }
  .guarantee { display: grid; gap: var(--space-4); align-items: center; }
  @media (min-width: 800px) { .guarantee { grid-template-columns: 14rem 1fr; } }
  .g-seal { width: 13rem; aspect-ratio: 1; border-radius: 50%; display: grid; place-content: center; text-align: center; gap: 0.2rem; color: var(--white); background: var(--navy) var(--waves); background-size: 60px 30px; box-shadow: 0 0 0 6px var(--paper), 0 0 0 9px var(--sky); font-family: var(--font-slab); }
  .g-seal span { font-size: 0.875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--sky-300); }
  .g-seal strong { font-size: 1.625rem; }
  /* Phone and tablet: the seal stands alone above the terms, so it fills the column and centers. */
  @media (max-width: 799px) {
    .g-seal { width: min(19rem, 100% - 2rem); justify-self: center; gap: 0.4rem; background-size: 84px 42px; box-shadow: 0 0 0 8px var(--paper), 0 0 0 12px var(--sky); }
    .g-seal span { font-size: 1.0625rem; }
    .g-seal strong { font-size: 2.375rem; }
  }
</style>
