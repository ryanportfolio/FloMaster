---
// Prices. Wide screens: "How I charge" in a navy panel beside the prices (sticky while they scroll),
// the other fee terms under it, then a card of typical prices per service and the guarantee.
// Phones: the call-out large in a navy card with the other fees beside it, then the services as
// rows that start open (a tap closes one), each showing its lowest price. Every figure is read from
// facts.ts and services.ts; open facts carry their "confirm" tags.
import Base from "../layouts/Base.astro";
import Fact from "../components/Fact.astro";
import Icon from "../components/Icon.astro";
import CallToAction from "../components/CallToAction.astro";
import { services } from "../data/services";
import { facts } from "../data/facts";
// "1-year labor warranty" -> "1"; the seal shows the years.
const years = facts.laborWarranty.value.match(/^(\d+)-year\b/)?.[1];
// "$150 extra" -> "+$150"
const extra = facts.afterHoursFee.value.match(/\$[\d,]+/)?.[0];
// A service's lowest price: "$150 to $275" rows -> "$150"
const low = (r: string) => Number(r.replace(/^\$/, "").split(" ")[0].replace(/,/g, ""));
const from = (s: (typeof services)[number]) => `$${Math.min(...s.prices.map((p) => low(p.range))).toLocaleString("en-US")}`;
---
<Base title="Prices, fees and guarantee" description="Every fee FloMasters charges, typical prices for common plumbing jobs, and the written guarantee.">
  <section class="section pr">
    <div class="wrap">
      <h1 class="pr-title">Prices</h1>
      <div class="pr-grid">
        <aside class="pr-side" aria-labelledby="pr-how">
          <div class="pr-how on-navy">
            <h2 id="pr-how">How I charge</h2>
            <ul class="pr-rules" role="list">
              <li><Icon name="receipt" /><span><Fact k="pricingModel" text="You get the price in writing first" /></span></li>
              <li><Icon name="text" /><span><Fact k="startsOnYes" text="You decide before I start" /></span></li>
              <li><Icon name="valve" /><span><Fact k="calloutFee" /> call-out, <Fact k="calloutCredited" /></span></li>
              <li><Icon name="shield" /><span>No <Fact k="cardFee" text="card" /> or <Fact k="diagnosticFee" text="diagnostic" /> fee</span></li>
              <li><Icon name="warranty" /><span><Fact k="payment" text="Pay when it's done" /></span></li>
            </ul>
            <a class="pr-phone num" href={`tel:${facts.phoneHref.value}`}><Icon name="phone" />{facts.phone.value}</a>
          </div>
          <dl class="pr-terms">
            <div><dt>After hours: <Fact k="afterHoursFee" /></dt><dd><Fact k="afterHoursWhen" /></dd></div>
            <div><dt>Payment</dt><dd><Fact k="payment" /></dd></div>
            <div><dt>Canceling</dt><dd><Fact k="cancellation" /></dd></div>
            <div><dt>Permits</dt><dd><Fact k="permits" /></dd></div>
          </dl>
        </aside>

        <!-- Phones: the same fees, the call-out first and large -->
        <div class="pr-m">
          <div class="pm-card on-navy">
            <p class="pm-big"><span class="pm-n num"><Fact k="calloutFee" plain /></span><span class="pm-k">Call-out</span><span class="pm-sub"><Fact k="calloutCredited" /></span></p>
            <ul class="pm-list" role="list">
              <li><Icon name="shield" /><span><Fact k="diagnosticFee" text="No diagnostic fee" /></span></li>
              <li><Icon name="clock" /><span><strong>After hours {extra ? `+${extra}` : <Fact k="afterHoursFee" />}:</strong> <Fact k="afterHoursWhen" /></span></li>
              <li><Icon name="receipt" /><span><strong><Fact k="cardFee" text="No card fee" />:</strong> <Fact k="payment" text="card, check or cash" /></span></li>
              <li><Icon name="calendar" /><span><Fact k="cancellation" /></span></li>
            </ul>
          </div>
          <p class="pm-note"><Fact k="pricingModel" text="You get the price in writing first" />. <Fact k="startsOnYes" text="You decide before I start" />. <Fact k="payment" text="Pay when it's done" />. <Fact k="permits" text="Permits at cost, only when the city requires one, and I tell you first" />.</p>
        </div>

        <div class="pr-main">
          <h2 id="typical-prices">Typical prices</h2>
          {services.map((s) => (
            <details class="pc" open data-pc>
              <summary><h3>{s.title}</h3><span class="pc-from">from <b class="num">{from(s)}</b></span><svg class="pc-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
              <ul class="pc-rows" role="list">{s.prices.map((p) => (
                <li><span>{p.job}</span><span class="pc-price num"><Fact k="priceRanges" text={p.range} /></span></li>
              ))}</ul>
              <a class="pc-more" href={`/residential/${s.slug}`}>More on {s.title.toLowerCase()}<Icon name="arrow" /></a>
            </details>
          ))}
          <section class="pc pc--g" id="guarantee" aria-labelledby="pr-g">
            <div class="pr-seal" aria-hidden="true">{years ? <><strong>{years}</strong><span>Year</span></> : <span>Written</span>}</div>
            <div>
              <h2 id="pr-g">My guarantee</h2>
              <p><Fact k="laborWarranty" />. If my work fails, I fix it free. <Fact k="partsWarranty" />.</p>
              <p class="small muted">Not covered: <Fact k="warrantyExclusions" />. To claim, call or text <span class="nowrap">{facts.phone.value}</span>.</p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
  <CallToAction />
</Base>

<script>
  // Wide screens show every service card open; only phones fold them (they start open there too).
  const wide = matchMedia("(min-width: 900px)");
  document.querySelectorAll<HTMLDetailsElement>("[data-pc]").forEach((d) => {
    d.querySelector("summary")!.addEventListener("click", (e) => { if (wide.matches) e.preventDefault(); });
  });
  wide.addEventListener("change", () => { if (wide.matches) document.querySelectorAll<HTMLDetailsElement>("[data-pc]").forEach((d) => (d.open = true)); });
</script>

<style>
  .pr-title { margin-bottom: var(--space-3); }
  .pr-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); align-items: start; }
  .pr-side { display: none; }
  @media (min-width: 900px) {
    .pr-grid { grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.25fr); gap: var(--space-5); }
    /* The rules stay in view beside the prices while the prices scroll. */
    .pr-side { display: block; position: sticky; top: calc(var(--sticky-h, 0px) + 1.25rem); }
    .pr-m { display: none; }
  }

  /* How I charge (wide screens): the card's navy with its waves */
  .pr-how { padding: 1.75rem 1.6rem 1.6rem; border-radius: var(--radius-lg); color: var(--white); background: var(--navy-900) var(--waves); background-size: 72px 36px; box-shadow: var(--shadow-3); }
  .pr-how h2 { color: var(--white); font-size: var(--step-3); margin-bottom: 0.75rem; }
  .pr-rules { list-style: none; margin: 0; padding: 0; }
  .pr-rules li { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: 1rem; align-items: center; padding: 1rem 0; border-bottom: 1px solid rgb(169 210 234 / 0.25); font: 700 var(--step-1)/1.3 var(--font-slab); }
  .pr-rules :global(svg) { width: 2.4rem; height: 2.4rem; color: var(--sky); }
  .pr-phone { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3rem; margin-top: 1.1rem; color: var(--white); font: 800 var(--step-2)/1 var(--font-slab); text-decoration: none; }
  .pr-phone :global(svg) { width: 1.6rem; height: 1.6rem; color: var(--sky); }
  .pr-phone:hover { text-decoration: underline; }
  .pr-terms { margin: 1.25rem 0 0; padding: 0 0.25rem; }
  .pr-terms > div { padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
  .pr-terms > div:last-child { border-bottom: 0; }
  .pr-terms dt { font-weight: 700; color: var(--navy-900); }
  .pr-terms dd { margin: 0.1rem 0 0; color: var(--ink-soft); }

  /* Phones: the call-out card */
  .pm-card { padding: 1.4rem 1.25rem 1.1rem; border-radius: var(--radius-lg); color: var(--white); background: var(--navy-900) var(--waves); background-size: 72px 36px; box-shadow: var(--shadow-3); }
  .pm-big { display: grid; justify-items: center; text-align: center; margin: 0 0 0.75rem; padding-bottom: 0.9rem; border-bottom: 1px solid rgb(169 210 234 / 0.3); }
  .pm-n { font: 800 clamp(3.5rem, 2rem + 8vw, 4.5rem)/1 var(--font-slab); letter-spacing: -0.02em; }
  .pm-k { font: 700 var(--step-2)/1.2 var(--font-slab); }
  .pm-sub { margin-top: 0.2rem; color: var(--sky-300); }
  .pm-list { list-style: none; margin: 0; padding: 0; }
  .pm-list li { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); gap: 0.75rem; align-items: start; padding: 0.45rem 0; }
  .pm-list :global(svg) { width: 1.6rem; height: 1.6rem; color: var(--sky); margin-top: 0.1rem; }
  .pm-note { margin: 0.9rem 0.15rem 0; color: var(--ink-soft); }

  /* Typical prices: one white card per service; on phones a row that folds */
  .pr-main h2 { font-size: var(--step-3); }
  .pc { margin-top: 1rem; border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--ring), var(--shadow-1); }
  .pc summary { display: flex; align-items: baseline; gap: 0.75rem; padding: 1.1rem 1.4rem 0.4rem; list-style: none; cursor: pointer; }
  .pc summary::-webkit-details-marker { display: none; }
  .pc h3 { margin: 0; font-size: var(--step-2); flex: 1; }
  .pc-from { color: var(--ink-soft); white-space: nowrap; }
  .pc-from b { font: 800 var(--step-1)/1 var(--font-slab); color: var(--navy-900); }
  .pc-chev { width: 1.4rem; height: 1.4rem; align-self: center; fill: none; stroke: var(--navy); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; transition: rotate 0.2s; }
  .pc[open] .pc-chev { rotate: 180deg; }
  .pc:not([open]) summary { padding-bottom: 1.1rem; }
  .pc-rows { list-style: none; margin: 0; padding: 0 1.4rem; }
  .pc-rows li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.6rem 0; border-top: 1px solid var(--line); }
  .pc-price { font: 700 1.125rem/1.35 var(--font-slab); color: var(--navy-900); white-space: nowrap; text-align: right; }
  .pc-more { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.75rem; margin: 0 1.4rem 0.3rem; font-weight: 600; }
  .pc-more :global(svg) { width: 1rem; height: 1rem; }
  /* Wide screens: plain cards, every row in view; no fold, no "from" */
  @media (min-width: 900px) {
    .pc summary { cursor: default; }
    .pc-from, .pc-chev { display: none; }
  }

  /* The guarantee, with a navy seal */
  .pc--g { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; align-items: center; padding: 1.2rem 1.4rem; margin-top: 1.5rem; }
  .pc--g h2 { font-size: var(--step-2); margin-bottom: 0.3rem; }
  .pc--g p { margin: 0 0 0.4rem; }
  .pr-seal { display: grid; place-content: center; text-align: center; width: 6rem; aspect-ratio: 1; border-radius: 50%; color: var(--white); background: var(--navy-900) var(--waves); background-size: 48px 24px; box-shadow: 0 0 0 4px var(--white), 0 0 0 6px var(--sky); font-family: var(--font-slab); line-height: 1; }
  .pr-seal strong { font-size: 2.4rem; }
  .pr-seal span { font-size: 0.875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sky-300); }
  @media (max-width: 479px) { .pr-seal { width: 4.75rem; } .pr-seal strong { font-size: 1.9rem; } .pr-seal span { font-size: 0.75rem; } }
</style>
