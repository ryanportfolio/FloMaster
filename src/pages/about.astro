---
import Base from "../layouts/Base.astro";
import AboutHero from "../components/AboutHero.astro";
import AboutRows from "../components/AboutRows.astro";
import CallToAction from "../components/CallToAction.astro";
import { facts } from "../data/facts";
---
<Base title="About Antonio Spence" description="Antonio Spence is a Virginia master plumber and the owner of FloMasters Plumbing and Drains, established 2024 in Hampton Roads.">
  <AboutHero title="I'm Antonio Spence, and FloMasters is me" lead={`Owner of FloMasters Plumbing and Drains since ${facts.established.value}, and the plumber who turns up`} />
  <AboutRows />
  <CallToAction />
</Base>
