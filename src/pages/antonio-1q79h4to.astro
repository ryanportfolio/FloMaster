---
// Antonio's checklist: docs/owner-questions.md as a form that saves itself.
// Hidden page: no link to it anywhere on the site, noindex in every build, not in any
// sitemap. Answers go to /api/answers (api/answers.js); a copy stays in this browser's
// localStorage until the server has it. Own minimal layout: no site header, sticky bar or
// page transition, so arriving here or leaving runs no view transition.
import "@fontsource-variable/roboto-slab/wght.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { parts, allItems, confirmedLine, type Item } from "../data/owner-questions";
import { ITEMS } from "../../api/_items.js";

// The API accepts only ids it knows; fail the build if the two lists drift apart.
const mine: Record<string, string> = Object.fromEntries(allItems.map((i) => [i.id, i.kind]));
const theirs: Record<string, string> = ITEMS;
const drift = [...new Set([...Object.keys(mine), ...Object.keys(theirs)])].filter((id) => mine[id] !== theirs[id]);
if (drift.length) throw new Error(`Checklist items and api/_items.js differ: ${drift.join(", ")}`);

const total = allItems.length;
const dom = (id: string) => "i-" + id.replace(/\./g, "-");
const choicesFor = (it: Item) =>
  it.kind === "fact" ? [["yes", "Yes, right"], ["no", "Change it"]] : it.kind === "shot" ? [["can", "Can do"], ["cant", "Can't"]] : it.options.map((o) => [o, o]);
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Antonio's checklist | FloMasters</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#0c1b30" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="adm">
    <a class="skip" href="#main">Skip to list</a>
    <header class="adm-top navy">
      <div class="wrap">
        <Logo class="adm-logo" />
        <h1>Antonio's checklist</h1>
        <p class="lead">Check each item. Answers save themselves, every change</p>
        <p class="adm-known small"><span class="adm-known-k">Already set, from your card:</span> {confirmedLine.join(" · ")}</p>
      </div>
    </header>

    <div class="adm-bar" data-bar>
      <div class="wrap adm-bar-in">
        <p class="adm-count"><span class="num" data-count>0</span> of <span class="num">{total}</span> done</p>
        <div class="adm-meter" aria-hidden="true"><span data-meter></span></div>
        <p class="adm-status" data-status>Loading</p>
        <button type="button" class="btn btn--navy adm-next" data-next>Next not done</button>
      </div>
      <p class="visually-hidden" role="status" data-live></p>
    </div>

    <main id="main" class="wrap adm-main">
      <noscript><p class="adm-noscript">Needs JavaScript to save. Turn it on, then reload</p></noscript>
      <nav class="adm-parts" aria-label="Parts">
        <ul>
          {parts.map((p) => <li><a href={`#${p.id}`}>{p.title}</a></li>)}
        </ul>
      </nav>

      {parts.map((p) => (
        <section class="adm-part" id={p.id} aria-labelledby={`${p.id}-h`}>
          <h2 id={`${p.id}-h`}>{p.title}</h2>
          {p.intro.map((t) => <p class="adm-intro">{t}</p>)}
          {p.groups.map((g) => (
            <section class="adm-group" aria-labelledby={`g-${g.id}`}>
              <h3 id={`g-${g.id}`}>{g.title}</h3>
              {g.intro?.map((t) => <p class="adm-intro muted">{t}</p>)}
              <ol class="adm-list" role="list">
                {g.items.map((it) => {
                  const d = dom(it.id);
                  return (
                    <li class="q" id={d} data-id={it.id} data-kind={it.kind}>
                      <fieldset aria-describedby={`${d}-ask`}>
                        <legend class="q-head">
                          {it.kind === "fact" && <span class="q-code">{it.code}</span>}
                          {it.kind === "question" && <span class="q-code">Question {it.n}</span>}
                          {it.kind === "shot" && <span class="q-code">Shot {it.n}{it.codes && ` · ${it.codes}`}</span>}
                          <span class="q-label">{it.kind === "fact" ? it.label : it.title}</span>
                          <span class="q-done" data-done hidden>Done</span>
                        </legend>
                        {it.kind === "fact" && (
                          <>
                            <div class="q-now">
                              <span class="q-k">Now</span>
                              {it.now !== null ? <p class="q-v">{it.now || "(blank)"}</p> : <ul class="q-lines">{it.lines.map((l) => <li>{l}</li>)}</ul>}
                              {it.sub && <p class="q-sub">{it.sub}</p>}
                            </div>
                            <p class="q-ask" id={`${d}-ask`}>{it.ask}</p>
                            <p class="q-pages small">On: {it.pages.join(", ")}</p>
                          </>
                        )}
                        {it.kind === "question" && (
                          <div class="q-body" id={`${d}-ask`}>{it.body.map((t) => <p>{t}</p>)}</div>
                        )}
                        {it.kind === "shot" && (
                          <>
                            <p class="q-ask" id={`${d}-ask`}>{it.body}</p>
                            {it.where && <p class="q-pages small">Where: {it.where}</p>}
                          </>
                        )}
                        <div class:list={["choices", "q-pick", { "q-pick--two": it.kind !== "question" }]}>
                          {choicesFor(it).map(([v, label]) => (
                            <label class="choice"><input type="radio" name={it.id} value={v} /><span>{label}</span></label>
                          ))}
                        </div>
                        {it.kind === "fact" && (
                          <div class="field q-fix" data-fix hidden>
                            <label for={`${d}-fix`}>Right answer</label>
                            <textarea id={`${d}-fix`} rows="2" maxlength="1997" data-fix-input autocomplete="off"></textarea>
                          </div>
                        )}
                        <div class="field q-note">
                          <label for={`${d}-note`}>{it.kind === "question" ? "Notes" : "Note"} <span class="q-opt">(optional)</span></label>
                          <textarea id={`${d}-note`} rows="1" maxlength="2000" data-note autocomplete="off"></textarea>
                        </div>
                      </fieldset>
                    </li>
                  );
                })}
              </ol>
              {g.outro?.map((t) => <p class="adm-intro muted">{t}</p>)}
            </section>
          ))}
        </section>
      ))}
      <p class="adm-end">End of list. Thanks, Antonio</p>
    </main>

    <script>
      type Rec = { value: string; note: string; updatedAt: number };
      const API = "/api/answers";
      const LS_ANS = "fm-admin-answers";
      const LS_PEND = "fm-admin-pending";
      const DEBOUNCE = 600;

      const cards = [...document.querySelectorAll<HTMLElement>(".q[data-id]")];
      const byId = new Map(cards.map((el) => [el.dataset.id!, el]));
      const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
      const countEl = $<HTMLElement>("[data-count]");
      const meterEl = $<HTMLElement>("[data-meter]");
      const statusEl = $<HTMLElement>("[data-status]");
      const liveEl = $<HTMLElement>("[data-live]");
      const bar = $<HTMLElement>("[data-bar]");

      const state: Record<string, Rec> = {};
      const pending = new Set<string>();
      const rejected = new Map<string, string>();
      const inflight = new Set<string>();
      const again = new Set<string>();
      const timers: Record<string, number> = {};
      let failures = 0;
      let retryTimer = 0;
      let loaded = false;
      let savedAt: Date | null = null;

      const isRec = (r: unknown): r is Rec =>
        !!r && typeof r === "object" && typeof (r as Rec).value === "string" && typeof (r as Rec).note === "string" && Number.isSafeInteger((r as Rec).updatedAt);

      // ---- this browser's copy: written on every keystroke, so nothing typed is lost ----
      const readLocal = <T,>(k: string, fb: T): T => {
        try {
          const s = localStorage.getItem(k);
          return s ? (JSON.parse(s) as T) : fb;
        } catch {
          return fb;
        }
      };
      // Another tab of this page writes the same keys, so merge: per item the newer record wins,
      // with its own unsaved mark. Equal times: unsaved only while neither tab has saved it.
      let localOk = true;
      const writeLocal = () => {
        try {
          const kept = readLocal<Record<string, unknown>>(LS_ANS, {});
          const keptPend = new Set(readLocal<string[]>(LS_PEND, []));
          const ans: Record<string, Rec> = {};
          const pend = new Set<string>();
          for (const [id, r] of Object.entries(kept)) if (isRec(r)) { ans[id] = r; if (keptPend.has(id)) pend.add(id); }
          for (const [id, r] of Object.entries(state)) {
            const k = ans[id];
            if (!k || r.updatedAt > k.updatedAt) { ans[id] = r; if (pending.has(id)) pend.add(id); else pend.delete(id); }
            else if (r.updatedAt === k.updatedAt && !pending.has(id)) pend.delete(id);
          }
          localStorage.setItem(LS_ANS, JSON.stringify(ans));
          localStorage.setItem(LS_PEND, JSON.stringify([...pend]));
          localOk = true;
        } catch {
          // Storage full or blocked: answers live only in this page until the server takes them.
          localOk = false;
        }
      };
      // Answers typed in another tab show here too, and are kept if that tab closes unsaved.
      // The two keys can arrive as separate events, so an unsaved mark for a record this tab
      // already holds is picked up on its own.
      addEventListener("storage", (e) => {
        if (e.key !== LS_ANS && e.key !== LS_PEND) return;
        const keptPend = new Set(readLocal<string[]>(LS_PEND, []));
        let changed = false;
        for (const [id, r] of Object.entries(readLocal<Record<string, unknown>>(LS_ANS, {}))) {
          const el = byId.get(id);
          const mine = state[id];
          if (!el || !isRec(r)) continue;
          if (mine && r.updatedAt === mine.updatedAt && keptPend.has(id) && !pending.has(id)) { pending.add(id); changed = true; }
          if (mine && r.updatedAt <= mine.updatedAt) continue;
          state[id] = r;
          if (keptPend.has(id)) pending.add(id);
          else pending.delete(id);
          toForm(el, r);
          changed = true;
        }
        if (changed) { count(); status(); }
      });

      // ---- form <-> record ----
      const radios = (el: HTMLElement) => [...el.querySelectorAll<HTMLInputElement>("input[type=radio]")];
      const fixInput = (el: HTMLElement) => el.querySelector<HTMLTextAreaElement>("[data-fix-input]");
      const noteInput = (el: HTMLElement) => el.querySelector<HTMLTextAreaElement>("[data-note]")!;

      function fromForm(el: HTMLElement): { value: string; note: string } {
        const picked = radios(el).find((r) => r.checked)?.value ?? "";
        const note = noteInput(el).value;
        if (el.dataset.kind === "fact") {
          const fix = fixInput(el)!.value;
          return { value: picked === "yes" ? "yes" : picked === "no" ? "no:" + fix : "", note };
        }
        return { value: picked, note };
      }

      // Also used on the card being edited, when a newer answer arrives for it before anything is
      // typed: every control must show what is stored, or the next keystroke would send the old
      // values back with a fresh time. A focused text box keeps its caret.
      function toForm(el: HTMLElement, rec: Rec) {
        const a = document.activeElement;
        const caret = a instanceof HTMLTextAreaElement && el.contains(a) ? [a.selectionStart, a.selectionEnd] : null;
        let pick = rec.value;
        const fix = fixInput(el);
        if (el.dataset.kind === "fact" && rec.value.startsWith("no:")) pick = "no";
        for (const r of radios(el)) r.checked = r.value === pick;
        if (fix) fix.value = pick === "no" ? rec.value.slice(3) : fix.value;
        noteInput(el).value = rec.note;
        if (caret) (a as HTMLTextAreaElement).setSelectionRange(caret[0], caret[1]);
        paint(el);
      }

      const isDone = (kind: string, r: Rec | undefined) => {
        if (!r) return false;
        if (kind === "fact") return r.value === "yes" || (r.value.startsWith("no:") && r.value.slice(3).trim() !== "");
        if (kind === "shot") return r.value === "can" || r.value === "cant";
        return r.value !== "" || r.note.trim() !== "";
      };

      function paint(el: HTMLElement) {
        const fixBox = el.querySelector<HTMLElement>("[data-fix]");
        if (fixBox) fixBox.hidden = radios(el).find((r) => r.checked)?.value !== "no";
        const done = isDone(el.dataset.kind!, state[el.dataset.id!]);
        el.classList.toggle("is-done", done);
        el.querySelector<HTMLElement>("[data-done]")!.hidden = !done;
      }

      function count() {
        const n = cards.filter((el) => isDone(el.dataset.kind!, state[el.dataset.id!])).length;
        countEl.textContent = String(n);
        meterEl.style.width = `${(n / cards.length) * 100}%`;
      }

      // ---- status line ----
      const clock = (d: Date) => d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }).replace(/\s/g, " ").replace(/AM|PM/, (m) => m.toLowerCase());
      let lastLive = "";
      function status() {
        const waiting = [...pending].filter((id) => !rejected.has(id));
        let text: string;
        let tone = "ok";
        let say = "";
        if (failures > 0 && waiting.length) {
          text = localOk ? "Not saved, retrying" : "Not saved, keep this page open";
          tone = "bad";
          say = localOk ? "Not saved, retrying. Answers kept on this device" : "Not saved, retrying. This browser won't keep them, so keep this page open";
        } else if (inflight.size || waiting.length) {
          text = "Saving";
          tone = "busy";
        } else if (rejected.size) {
          text = `Not saved: ${[...rejected.values()][0]}`;
          tone = "bad";
          say = text;
        } else if (savedAt) {
          text = `Saved ${clock(savedAt)}`;
          say = text;
        } else if (loaded) {
          text = "All saved";
        } else if (failures > 0) {
          text = "Offline, retrying";
          tone = "bad";
          say = text;
        } else {
          text = "Loading";
          tone = "busy";
        }
        statusEl.textContent = text;
        statusEl.dataset.tone = tone;
        if (say && say !== lastLive) liveEl.textContent = lastLive = say;
      }

      // ---- saving ----
      function retrySoon() {
        if (retryTimer) return;
        const wait = Math.min(30000, 2000 * 2 ** Math.max(0, failures - 1));
        retryTimer = window.setTimeout(() => {
          retryTimer = 0;
          if (!loaded) load();
          else flushAll();
        }, wait);
      }

      async function send(id: string, keepalive = false) {
        clearTimeout(timers[id]);
        if (!pending.has(id) || rejected.has(id)) return;
        if (inflight.has(id)) {
          again.add(id);
          return;
        }
        const rec = state[id];
        inflight.add(id);
        status();
        try {
          const res = await fetch(API, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, value: rec.value, note: rec.note, updatedAt: rec.updatedAt }),
            keepalive,
          });
          if (res.status === 400 || res.status === 413) {
            const j = await res.json().catch(() => ({}));
            rejected.set(id, (j && j.error) || "server said no");
          } else if (!res.ok) {
            throw new Error(String(res.status));
          } else {
            const j = await res.json();
            failures = 0;
            savedAt = new Date();
            // Only clear it if nothing newer was typed while the request was out.
            if (state[id] === rec) {
              pending.delete(id);
              if (j.stale && isRec(j.saved)) {
                state[id] = j.saved;
                toForm(byId.get(id)!, j.saved);
                count();
              }
              writeLocal();
            }
          }
        } catch {
          failures++;
          retrySoon();
        } finally {
          inflight.delete(id);
          if (again.delete(id)) send(id);
          status();
        }
      }

      function flushAll(keepalive = false) {
        for (const id of pending) send(id, keepalive);
      }

      function edited(el: HTMLElement, now = false) {
        const id = el.dataset.id!;
        const prev = state[id];
        state[id] = { ...fromForm(el), updatedAt: Math.max(Date.now(), (prev?.updatedAt ?? 0) + 1) };
        pending.add(id);
        rejected.delete(id);
        writeLocal();
        paint(el);
        count();
        clearTimeout(timers[id]);
        if (now) send(id);
        else timers[id] = window.setTimeout(() => send(id), DEBOUNCE);
        status();
      }

      document.addEventListener("input", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>(".q[data-id]");
        if (el) edited(el);
      });
      // Leaving a field saves at once instead of waiting out the pause.
      document.addEventListener("focusout", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>(".q[data-id]");
        if (el && pending.has(el.dataset.id!) && timers[el.dataset.id!]) send(el.dataset.id!);
      });
      addEventListener("online", () => {
        if (!loaded) load();
        else flushAll();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") flushAll(true);
      });

      // ---- loading: this browser's copy first, then the server; newer updatedAt wins ----
      async function load() {
        try {
          const res = await fetch(API, { cache: "no-store" });
          if (!res.ok) throw new Error(String(res.status));
          const j = await res.json();
          const server: Record<string, unknown> = (j && j.answers) || {};
          for (const [id, rec] of Object.entries(server)) {
            const el = byId.get(id);
            if (!el || !isRec(rec)) continue;
            const mine = state[id];
            if (!mine || rec.updatedAt > mine.updatedAt) {
              state[id] = rec;
              pending.delete(id);
              toForm(el, rec);
            } else if (rec.updatedAt === mine.updatedAt) {
              pending.delete(id);
            }
          }
          for (const id of Object.keys(state)) {
            const s = server[id];
            if (!isRec(s) || s.updatedAt < state[id].updatedAt) pending.add(id);
          }
          loaded = true;
          failures = 0;
          writeLocal();
          count();
          flushAll();
        } catch {
          failures++;
          retrySoon();
        }
        status();
      }

      const saved = readLocal<Record<string, unknown>>(LS_ANS, {});
      for (const [id, rec] of Object.entries(saved)) {
        const el = byId.get(id);
        if (el && isRec(rec)) {
          state[id] = rec;
          toForm(el, rec);
        }
      }
      for (const id of readLocal<string[]>(LS_PEND, [])) if (state[id]) pending.add(id);
      count();
      status();
      load();

      // ---- getting around ----
      // Keep focused fields clear of the sticky bar (Chrome leaves a partly visible field where it is).
      let keyNav = false;
      addEventListener("keydown", () => (keyNav = true), true);
      addEventListener("pointerdown", () => (keyNav = false), true);
      const fitBar = () => document.documentElement.style.setProperty("--adm-bar-h", `${bar.offsetHeight}px`);
      new ResizeObserver(fitBar).observe(bar);
      document.addEventListener("focusin", (e) => {
        if (!keyNav) return;
        const t = e.target as HTMLElement;
        if (bar.contains(t)) return;
        const r = t.getBoundingClientRect();
        const top = bar.getBoundingClientRect().bottom + 12;
        if (r.top < top) scrollBy(0, r.top - top);
      });
      $<HTMLButtonElement>("[data-next]").addEventListener("click", () => {
        const from = cards.findIndex((el) => el.contains(document.activeElement));
        const order = [...cards.slice(from + 1), ...cards.slice(0, from + 1)];
        const next = order.find((el) => !isDone(el.dataset.kind!, state[el.dataset.id!]));
        if (!next) {
          liveEl.textContent = lastLive = "All done";
          return;
        }
        const first = radios(next).find((r) => r.checked) ?? radios(next)[0];
        first.focus({ preventScroll: true });
        next.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      });
    </script>
  </body>
</html>

<style is:global>
  /* This page opts out of the site's page transition (global.css opts every page in). */
  @view-transition { navigation: none; }
  html { scroll-padding-top: calc(var(--adm-bar-h, 5rem) + 1rem); scroll-padding-bottom: 1rem; }
</style>

<style>
  .adm-top { padding-block: var(--space-4) var(--space-3); }
  .adm-top :global(.adm-logo) { height: 1.9rem; margin-bottom: var(--space-3); }
  .adm-top h1 { font-size: var(--step-3); margin-bottom: 0.3em; }
  .adm-top .lead { margin-bottom: 0.75rem; }
  .adm-known { color: var(--sky-100); margin: 0; }
  .adm-known-k { font-weight: 700; }

  .adm-bar {
    position: sticky; top: 0; z-index: 20;
    background: var(--white); box-shadow: 0 1px 0 var(--line), 0 8px 18px -12px rgb(6 14 26 / 0.35);
  }
  .adm-bar-in {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.4rem 1rem;
    padding-block: 0.6rem;
  }
  .adm-count { margin: 0; font: 700 var(--step--1)/1.2 var(--font-body); white-space: nowrap; }
  .adm-count [data-count] { font-family: var(--font-slab); font-size: var(--step-1); color: var(--navy-900); }
  .adm-meter { height: 0.5rem; border-radius: 999px; background: var(--sky-100); overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
  .adm-meter span { display: block; height: 100%; width: 0; background: var(--ok); border-radius: inherit; transition: width 0.25s; }
  .adm-status { margin: 0; font-size: var(--step--2); font-weight: 600; color: var(--ink-soft); white-space: nowrap; }
  .adm-status[data-tone="ok"] { color: var(--ok); }
  .adm-status[data-tone="bad"] { color: #b42318; }
  .adm-next { min-height: 2.75rem; padding: 0.5rem 1rem; font-size: 1rem; grid-column: 3; grid-row: 1 / span 2; }
  .adm-status { grid-column: 1 / span 2; grid-row: 2; }
  @media (max-width: 559px) {
    .adm-bar-in { grid-template-columns: auto 1fr; }
    .adm-next { grid-column: 1 / -1; grid-row: 3; width: 100%; }
  }

  .adm-main { padding-block: var(--space-3) var(--space-5); max-width: 52rem; }
  .adm-noscript { padding: 1rem; background: #fff4cc; border-radius: var(--radius); font-weight: 700; }
  .adm-parts ul { list-style: none; padding: 0; margin: 0 0 var(--space-3); display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .adm-parts a {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.4rem 0.9rem;
    border: 2px solid var(--line); border-radius: 999px; background: var(--white);
    font-weight: 600; font-size: var(--step--1); text-decoration: none;
  }
  .adm-parts a:hover { border-color: var(--navy); }

  .adm-part { padding-top: var(--space-3); }
  .adm-part h2 { font-size: var(--step-2); }
  .adm-group { margin-top: var(--space-4); }
  .adm-group h3 { font-size: var(--step-1); }
  .adm-intro { font-size: var(--step--1); }
  .adm-list { list-style: none; padding: 0; margin: 0 0 var(--space-3); display: grid; gap: var(--space-2); }
  .adm-end { margin-top: var(--space-4); font-weight: 700; color: var(--ink-soft); }

