---
import Base from "../layouts/Base.astro";
import WorkOrderHero from "../components/WorkOrderHero.astro";
import WorkOrderSlip from "../components/WorkOrderSlip.astro";
import HullCheck from "../components/HullCheck.astro";
import Fact from "../components/Fact.astro";
import CallToAction from "../components/CallToAction.astro";
---
<Base title="Service area" description="FloMasters works across all 7 cities of Hampton Roads: Chesapeake, Hampton, Newport News, Norfolk, Portsmouth, Suffolk and Virginia Beach. Check your ZIP.">
  <WorkOrderHero title="All 7 cities of Hampton Roads" lead="Chesapeake, Hampton, Newport News, Norfolk, Portsmouth, Suffolk and Virginia Beach">
    <WorkOrderSlip title="When I come out" id="wo-area">
      <dl class="wo-f">
        <div><dt>Working hours</dt><dd><Fact k="hours" /></dd></div>
        <div><dt>Emergencies</dt><dd><Fact k="emergency247" /> for leaks, floods, no water and sewage backups: I answer the phone and come out any hour, every day of the year</dd></div>
        <div><dt>After-hours visits</dt><dd><Fact k="afterHoursFee" /></dd></div>
      </dl>
    </WorkOrderSlip>
  </WorkOrderHero>
  <HullCheck />
  <CallToAction />
</Base>
